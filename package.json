{
  "name": "afterhoursoutreach.ca",
  "type": "module",
  "version": "0.0.1",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "wrangler types --strict-vars false && astro dev --host --background",
    "docs:dev": "pnpm --dir docs dev",
    "docs:stop": "pnpm --dir docs stop",
    "docs:status": "pnpm --dir docs status",
    "docs:logs": "pnpm --dir docs logs",
    "docs:check": "pnpm --dir docs check",
    "build": "wrangler types --strict-vars false && astro build",
    "build:preview": "wrangler types --strict-vars false && astro build --mode preview --outDir ./dist-preview",
    "deploy:preview": "pnpm db:migrate:preview && wrangler preview --config dist-preview/server/wrangler.json",
    "check": "wrangler types --strict-vars false && astro check",
    "icons:generate": "node scripts/generate-app-icons.mjs",
    "test": "vitest run --project unit --project runtime",
    "test:watch": "vitest --project unit --project runtime",
    "test:ui": "node scripts/test-ui.mjs",
    "test:accounts": "pnpm build && vitest run --project worker",
    "test:preview": "pnpm build:preview && vitest run --project preview",
    "test:benchmark": "node scripts/benchmark-tests.mjs",
    "db:generate": "tsx scripts/generate-db.ts",
    "db:check": "tsx scripts/generate-db.ts --check",
    "organizer:bootstrap": "node scripts/bootstrap-organizer.mjs",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:seed:local": "tsx scripts/seed-local-events.ts",
    "db:repair:local-names": "tsx scripts/repair-local-sample-names.ts",
    "db:migrate:preview": "node scripts/check-preview-migrations.mjs && wrangler d1 migrations apply PREVIEW_DB --config wrangler.preview-migrations.jsonc --remote",
    "db:migrate:production": "pnpm db:check && node scripts/migrate-production.mjs",
    "db:seed:preview": "tsx scripts/seed-preview-events.ts",
    "preview": "astro preview",
    "astro": "astro",
    "deploy": "pnpm db:migrate:production && wrangler deploy --config dist/server/wrangler.json",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@astrojs/cloudflare": "14.4.4",
    "@better-auth/drizzle-adapter": "1.7.15",
    "@tailwindcss/vite": "^4.3.4",
    "astro": "7.4.5",
    "better-auth": "1.7.15",
    "drizzle-orm": "0.45.4",
    "qrcode": "^1.5.4",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@cloudflare/vitest-plugin": "1.5.1",
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.20.4",
    "@types/qrcode": "^1.5.6",
    "drizzle-kit": "0.31.11",
    "jsqr": "^1.4.0",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.2",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.1.0",
    "wrangler": "4.157.0"
  }
}
