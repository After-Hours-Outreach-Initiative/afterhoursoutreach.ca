---
import type { ComponentProps } from "astro/types";
import ArrowRightIcon from "../../../src/components/icons/ArrowRightIcon.astro";
import VolunteerAccessButton from "../../../src/components/volunteer/VolunteerAccessButton.astro";
import RoleAppearance from "./RoleAppearance.astro";

type State = ComponentProps<typeof RoleAppearance> & { label: string };

interface Props {
  from: State;
  to: State;
  approval?: "application" | "patrol";
  action?: string;
  reverseAction?: string;
  reversible?: boolean;
  note?: string;
}

const {
  from,
  to,
  approval,
  action,
  reverseAction,
  reversible = false,
  note,
} = Astro.props;
const { label: fromLabel, ...fromAppearance } = from;
const { label: toLabel, ...toAppearance } = to;
---

<div class="role-transition not-content">
  <div
    class="transition-flow"
    role="group"
    aria-label={`${fromLabel} to ${toLabel}`}
  >
    <div class="transition-state">
      <RoleAppearance {...fromAppearance} />
      <span>{fromLabel}</span>
    </div>
    <div class="transition-actions">
      <div class="transition-action">
        <ArrowRightIcon class="transition-arrow" />
        <div>
          {approval ? (
            <VolunteerAccessButton kind={approval} type="button" disabled />
          ) : (
            action
          )}
        </div>
      </div>
      {reversible && (
        <div class="transition-action">
          <ArrowRightIcon class="transition-arrow transition-arrow-reverse" />
          <div>
            {approval ? (
              <VolunteerAccessButton
                kind={approval}
                approved
                type="button"
                disabled
              />
            ) : (
              reverseAction
            )}
          </div>
        </div>
      )}
    </div>
    <div class="transition-state">
      <RoleAppearance {...toAppearance} />
      <span>{toLabel}</span>
    </div>
  </div>
  {note && <p>{note}</p>}
</div>

<style>
  .role-transition {
    container-type: inline-size;
    margin-block: 1.25rem;
    padding-block: 1rem;
    border-bottom: 1px solid var(--sl-color-hairline);
  }

  .transition-flow {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
    align-items: center;
    gap: 1rem;
  }

  .transition-state {
    display: grid;
    justify-items: center;
    gap: 0.5rem;
    text-align: center;
  }

  .transition-actions {
    display: grid;
    gap: 0.5rem;
  }

  .transition-action {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .transition-action :global(.transition-arrow) {
    flex: 0 0 1.25rem;
    width: 1.25rem;
    height: 1.25rem;
    color: var(--sl-color-gray-2);
  }

  .transition-action :global(.transition-arrow-reverse) {
    transform: rotate(180deg);
  }

  .role-transition p {
    margin: 0.75rem 0 0;
    color: var(--sl-color-gray-2);
    font-size: 0.875rem;
  }

  @container (width < 36rem) {
    .transition-flow {
      grid-template-columns: minmax(0, 1fr);
      justify-items: center;
    }

    .transition-action :global(.transition-arrow) {
      transform: rotate(90deg);
    }

    .transition-action :global(.transition-arrow-reverse) {
      transform: rotate(-90deg);
    }
  }
</style>
