# Optional, dashboard-only Resend key. Copy this file to docs/.env.local.
# Leave blank until you create a full-access key dedicated to reading /usage.
# Never use PUBLIC_ here. This dashboard does not send emails.
DOCS_DASHBOARD_RESEND_API_KEY=

# Optional: discover D1 databases in a different account accessible to your
# existing Wrangler login. Defaults to account_id in the root wrangler.jsonc.
# Unknown databases are ALWAYS protected, regardless of their names.
DOCS_DASHBOARD_ACCOUNT_ID=
