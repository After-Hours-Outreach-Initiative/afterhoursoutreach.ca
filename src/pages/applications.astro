---
import AccountLayout from "@/components/volunteer/AccountLayout.astro";
import VolunteerDirectory from "@/components/volunteer/VolunteerDirectory.astro";
import { env } from "cloudflare:workers";
import { accountContext, requireOrganizer } from "@/server/db/access";
import { listApplications } from "@/server/db/volunteers";
import { forwardCookies } from "@/server/auth";
import { RequestError } from "@/server/http";
import {
  applicationListUrl,
  applicationListState,
} from "@/data/volunteer-list";
import "@/styles/volunteer.css";
export const prerender = false;
let applications: Awaited<ReturnType<typeof listApplications>> = {
  rows: [],
  hasMore: false,
  allApplicantsCount: 0,
  awaitingApprovalCount: 0,
};
let lock = "";
let accountName = "";
let accountGreeting = "";
let accountEmail = "";
const state = applicationListState(Astro.url.searchParams);
const { search, offset, approval, sort, direction } = state;
const listUrl = applicationListUrl(state);
try {
  const { actor, headers, email, greetingName } = await accountContext(
    env,
    Astro.request,
  );
  forwardCookies(headers, Astro.response.headers);
  if (!actor)
    return Astro.redirect(
      `/volunteer/sign-in?returnTo=${encodeURIComponent(listUrl)}`,
    );
  if (actor.role !== "organizer")
    return new Response("Organizer access is required.", { status: 403 });
  accountName = actor.name;
  accountGreeting = greetingName;
  accountEmail = email;
  try {
    requireOrganizer(actor);
  } catch (error) {
    if (error instanceof RequestError) lock = error.message;
    else throw error;
  }
  if (!lock)
    applications = await listApplications(
      env.DB,
      actor,
      search,
      offset,
      approval,
      sort,
      direction,
    );
} catch {
  return new Response("Application management is temporarily unavailable.", {
    status: 503,
  });
}
---

<AccountLayout
  title="Applications"
  description="Organizer application review."
  signedIn
  organizer
  name={accountName}
  greetingName={accountGreeting}
  email={accountEmail}
>
  {
    lock ? (
      <p class="volunteer-notice">
        {lock} <a href="/volunteer/account">Your account</a>
      </p>
    ) : (
      <VolunteerDirectory
        kind="applications"
        people={applications}
        state={state}
      />
    )
  }
</AccountLayout>
<script>
  import { initVolunteerBrowser } from "@/scripts/volunteer-browser";
  initVolunteerBrowser();
</script>
