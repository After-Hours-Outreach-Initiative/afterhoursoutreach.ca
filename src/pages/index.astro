---
import "@/styles/tailwind.css";

const equipmentNeeds = [
  {
    name: "Full aluminum D oxygen cylinder",
    description: "A portable 425 L oxygen supply for emergency response.",
    price: "$190.00",
    unit: "each",
    url: "https://pacificfirstaid.ca/products/oxygen-tank-aluminum-d-cylinder-15-0-cu-ft-425l-with-toggle-valve",
    image:
      "https://cdn.shopify.com/s/files/1/0757/3654/7609/files/Screenshot2025-09-16162413.png?v=1758065075",
  },
  {
    name: "Adult bag-valve mask",
    description: "Manual ventilation equipment for respiratory emergencies.",
    price: "$29.95",
    unit: "each",
    url: "https://pacificfirstaid.ca/products/bag-valve-mask-adult",
    image:
      "https://cdn.shopify.com/s/files/1/0757/3654/7609/files/Med-Rescuer.png?v=1730765369",
  },
  {
    name: "Assorted sterile gauze pads",
    description: "A 100-pack for cleaning, covering, and dressing wounds.",
    price: "$12.95",
    unit: "per pack",
    url: "https://pacificfirstaid.ca/products/sterile-gauze-pad-100-assorted",
    image:
      "https://cdn.shopify.com/s/files/1/0757/3654/7609/files/100ASTPads1.png?v=1734032678",
  },
  {
    name: "Oropharyngeal airway set",
    description:
      "Eight colour-coded Guedel airways in neonatal to adult sizes.",
    price: "$11.95",
    unit: "per set",
    url: "https://pacificfirstaid.ca/products/oral-airway-set",
    image:
      "https://cdn.shopify.com/s/files/1/0757/3654/7609/files/PFA-OAK.png?v=1752601748",
  },
  {
    name: "Adhesive bandages",
    description: "A 30-count assorted pack for minor cuts and scrapes.",
    price: "$7.99",
    unit: "per box",
    url: "https://pacificfirstaid.ca/products/band-aid%C2%AE-brand-flexible-fabric-adhesive-bandages",
    image:
      "https://cdn.shopify.com/s/files/1/0757/3654/7609/files/81tsrk9kp7L._AC_SX425.jpg?v=1717801370",
  },
  {
    name: "Adult oxygen mask with tubing",
    description:
      "A disposable partial non-rebreathing mask for oxygen delivery.",
    price: "$4.35",
    unit: "each",
    url: "https://pacificfirstaid.ca/products/partial-non-rebreathing-oxygen-mask-with-tubing-adult",
    image:
      "https://cdn.shopify.com/s/files/1/0757/3654/7609/products/partial_non_-_rebreathing_oxygen_mask_with_tubing_-_adult.jpg?v=1683401429",
  },
];
---

<!doctype html>
<html lang="en" class="scroll-smooth bg-ink">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta
      name="description"
      content="Volunteer-based evening street outreach providing practical care and overdose response in Vancouver's Downtown Eastside."
    />
    <meta name="theme-color" content="#050608" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="preconnect" href="https://cdn.shopify.com" />
    <link
      href="https://fonts.googleapis.com/css2?family=Public+Sans:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <title>After Hours Outreach Initiative</title>
  </head>
  <body
    class="m-0 overflow-x-hidden bg-ink font-body text-base leading-relaxed text-zinc-100 antialiased"
  >
    <a
      class="fixed top-4 left-4 z-[100] -translate-y-40 rounded-lg bg-blue px-5 py-3 text-base font-bold text-white transition-transform focus:translate-y-0"
      href="#main-content">Skip to main content</a
    >

    <header class="sticky top-0 z-50 bg-black text-white">
      <div
        class="relative mx-auto flex min-h-22 w-full max-w-[1248px] items-center gap-10 px-6 max-sm:min-h-19 max-sm:px-4"
      >
        <a
          class="flex shrink-0 items-center gap-3.5"
          href="#top"
          aria-label="After Hours Outreach Initiative, home"
        >
          <img
            class="h-16 w-[105px] shrink-0 object-contain max-sm:h-13 max-sm:w-[86px]"
            src="/logo-header.png"
            alt=""
            width="420"
            height="280"
            decoding="async"
          />
          <span class="flex flex-col leading-tight">
            <strong
              class="font-heading text-[19px] font-bold max-sm:text-[17px]"
              >After Hours</strong
            >
            <span class="text-sm text-zinc-400">Outreach Initiative</span>
          </span>
        </a>

        <nav
          class="ml-auto hidden items-center gap-8 lg:flex"
          aria-label="Primary navigation"
        >
          <a
            class="py-2.5 text-[15px] font-medium text-zinc-300 transition-colors hover:text-white"
            href="#about">About</a
          >
          <a
            class="py-2.5 text-[15px] font-medium text-zinc-300 transition-colors hover:text-white"
            href="#services">What we do</a
          >
          <a
            class="py-2.5 text-[15px] font-medium text-zinc-300 transition-colors hover:text-white"
            href="#get-involved">Get involved</a
          >
        </nav>

        <a
          class="hidden min-h-12 items-center justify-center rounded-lg border-2 border-blue px-5 py-3 text-[15px] font-bold transition-colors hover:bg-blue lg:inline-flex"
          href="#support">Donate</a
        >

        <details class="mobile-nav group ml-auto lg:hidden">
          <summary
            class="flex size-12 cursor-pointer list-none flex-col items-center justify-center gap-1.5 rounded-lg"
            aria-label="Open navigation"
          >
            <span
              class="h-0.5 w-5 bg-white transition-transform group-open:translate-y-2 group-open:rotate-45"
            ></span>
            <span
              class="h-0.5 w-5 bg-white transition-opacity group-open:opacity-0"
            ></span>
            <span
              class="h-0.5 w-5 bg-white transition-transform group-open:-translate-y-2 group-open:-rotate-45"
            ></span>
          </summary>
          <nav
            class="absolute inset-x-0 top-full flex w-full flex-col border-y border-zinc-600 bg-ink"
            aria-label="Mobile navigation"
          >
            <a
              class="border-b border-zinc-800 px-5 py-4 text-base"
              href="#about">About</a
            >
            <a
              class="border-b border-zinc-800 px-5 py-4 text-base"
              href="#services">What we do</a
            >
            <a
              class="border-b border-zinc-800 px-5 py-4 text-base"
              href="#get-involved">Get involved</a
            >
            <a class="bg-blue px-5 py-4 text-base font-bold" href="#support"
              >Donate</a
            >
          </nav>
        </details>
      </div>
    </header>

    <main id="main-content">
      <section class="bg-black text-white" id="top">
        <div
          class="mx-auto grid min-h-[720px] w-full max-w-[1248px] items-center gap-12 px-6 max-sm:px-4 lg:grid-cols-[minmax(0,1fr)_420px]"
        >
          <div class="flex w-full max-w-[760px] flex-col justify-center py-20">
            <h1
              class="font-heading text-[clamp(2.5rem,5vw,4.5rem)] leading-[1.06] font-bold tracking-[-0.04em]"
            >
              <span class="block text-blue">After Hours</span>
              <span class="block">Outreach Initiative</span>
            </h1>
            <p
              class="mt-8 max-w-2xl text-[clamp(1.1rem,1.5vw,1.3rem)] leading-[1.65]"
            >
              Volunteer teams provide food, water, clothing, harm reduction
              supplies, naloxone, first aid, and immediate overdose response in
              Vancouver's Downtown Eastside.
            </p>
            <div class="mt-9 flex flex-wrap gap-3.5 max-sm:flex-col">
              <a
                class="inline-flex min-h-13 items-center justify-center rounded-lg border-2 border-blue bg-blue px-6 py-3 text-[15px] font-bold text-white transition-colors hover:bg-blue-dark"
                href="#volunteer">Volunteer with us</a
              >
              <a
                class="inline-flex min-h-13 items-center justify-center rounded-lg border-2 border-white/60 px-6 py-3 text-[15px] font-bold text-white transition-colors hover:border-white hover:bg-white/10"
                href="#services">See what we do</a
              >
            </div>
          </div>

          <div class="relative hidden items-center justify-center lg:flex">
            <img
              class="w-full max-w-[420px] object-contain"
              src="/logo-blue.jpg"
              alt="After Hours Outreach Initiative logo"
              width="1280"
              height="1280"
              decoding="async"
            />
          </div>
        </div>
      </section>

      <section
        class="scroll-mt-19 border-y border-zinc-800 bg-panel text-white lg:scroll-mt-22"
        id="support"
        aria-labelledby="support-heading"
      >
        <div
          class="mx-auto grid w-full max-w-[1248px] gap-14 px-6 py-24 max-sm:px-4 max-sm:py-18 lg:grid-cols-[minmax(280px,0.72fr)_minmax(0,1.28fr)] lg:gap-20"
        >
          <div>
            <h2
              class="font-heading text-[clamp(2.25rem,4vw,3.75rem)] leading-[1.08] font-bold tracking-[-0.035em]"
              id="support-heading"
            >
              What your donation can put in the field.
            </h2>
            <p class="mt-6 max-w-xl text-lg leading-8 text-zinc-300">
              We want supporters to see the practical needs behind each outreach
              shift. These are examples of the equipment and supplies we are
              working toward, from everyday wound care to emergency-response
              gear.
            </p>

            <div class="mt-10 border-l-4 border-blue bg-blue-deep p-6 sm:p-7">
              <p
                class="text-sm font-bold tracking-[0.12em] text-blue uppercase"
              >
                Biggest long-term need
              </p>
              <h3 class="mt-3 font-heading text-2xl leading-tight font-bold">
                DTES operations and storage space
              </h3>
              <p class="mt-3 leading-7 text-zinc-300">
                A reliable location would give us a base for general operations,
                volunteer coordination, and secure supply storage close to the
                community we serve.
              </p>
            </div>
          </div>

          <div>
            <a
              class="group block border border-blue bg-blue/10 p-6 transition-colors hover:bg-blue/15 sm:p-8"
              href="https://coastalreign.com/products/safety-vests/big-k-first-aid-safety-vest?selectedColour=Royal%20Blue"
              target="_blank"
              rel="noreferrer"
            >
              <div
                class="grid grid-cols-[6.5rem_minmax(0,1fr)] items-center gap-5 sm:grid-cols-[9rem_minmax(0,1fr)] sm:gap-8"
              >
                <div class="aspect-square overflow-hidden bg-white p-2 sm:p-3">
                  <img
                    class="size-full object-contain"
                    src="https://cdn.shopify.com/s/files/1/1016/5405/files/1013591.jpg?v=1758155758"
                    alt=""
                    width="240"
                    height="240"
                    loading="lazy"
                    decoding="async"
                  />
                </div>
                <div
                  class="flex items-end justify-between gap-8 max-sm:flex-col max-sm:items-start max-sm:gap-4"
                >
                  <div>
                    <h3
                      class="font-heading text-[clamp(1.6rem,3vw,2.25rem)] leading-tight font-bold"
                    >
                      High-visibility first aid vest
                    </h3>
                    <p class="mt-3 max-w-lg leading-7 text-zinc-300">
                      Durable, reflective vests help identify outreach
                      responders and keep essential supplies within reach on
                      evening shifts.
                    </p>
                    <span
                      class="mt-5 inline-block border-b border-zinc-500 pb-0.5 text-sm font-bold group-hover:border-white"
                      >View reference item</span
                    >
                  </div>
                  <strong
                    class="shrink-0 font-heading text-[clamp(2rem,4vw,3.25rem)] leading-none font-bold text-blue"
                    >$129.99</strong
                  >
                </div>
              </div>
            </a>

            <div class="mt-5 border border-zinc-700 bg-ink">
              {
                equipmentNeeds.map((item) => (
                  <a
                    class="group grid grid-cols-[5.5rem_minmax(0,1fr)] items-center gap-x-5 gap-y-2 border-b border-zinc-800 p-5 last:border-b-0 hover:bg-panel-soft sm:grid-cols-[6.5rem_minmax(0,1fr)_auto] sm:gap-x-6 sm:p-6"
                    href={item.url}
                    target="_blank"
                    rel="noreferrer"
                  >
                    <span class="aspect-square overflow-hidden bg-white p-2">
                      <img
                        class="size-full object-contain"
                        src={item.image}
                        alt=""
                        width="180"
                        height="180"
                        loading="lazy"
                        decoding="async"
                      />
                    </span>
                    <span>
                      <strong class="block text-[17px] leading-snug">
                        {item.name}
                      </strong>
                      <span class="mt-1 block text-sm leading-6 text-zinc-400">
                        {item.description}
                      </span>
                    </span>
                    <span class="col-start-2 flex items-baseline gap-2 sm:col-start-auto sm:flex-col sm:items-end sm:gap-0">
                      <strong class="text-xl text-white">{item.price}</strong>
                      <span class="text-xs text-zinc-500">{item.unit}</span>
                    </span>
                  </a>
                ))
              }
            </div>

            <p class="mt-5 text-sm leading-6 text-zinc-400">
              Reference prices are in CAD and were checked in August 2026. Tax,
              shipping, oxygen handling, customization, and future price changes
              are not included. Medical-response equipment is for use by team
              members with appropriate training.
            </p>
          </div>
        </div>
      </section>
    </main>

    <footer class="bg-black text-white" id="contact">
      <div
        class="mx-auto grid w-full max-w-[1248px] items-center gap-x-16 gap-y-10 px-6 py-20 max-sm:grid-cols-1 max-sm:px-4 md:grid-cols-[minmax(0,1fr)_auto] lg:grid-cols-[minmax(0,1fr)_auto_auto]"
      >
        <div>
          <a
            class="flex shrink-0 items-center gap-8 max-sm:flex-col max-sm:items-start max-sm:gap-5"
            href="#top"
            aria-label="After Hours Outreach Initiative, home"
          >
            <img
              class="size-40 shrink-0 object-contain"
              src="/logo-blue.jpg"
              alt=""
              width="1280"
              height="1280"
              loading="lazy"
              decoding="async"
            />
            <span class="flex flex-col leading-tight">
              <strong class="font-heading text-[30px] leading-none font-bold"
                >After Hours</strong
              >
              <span class="mt-1.5 text-xl leading-tight text-zinc-400"
                >Outreach Initiative</span
              >
            </span>
          </a>
        </div>

        <nav
          class="flex flex-col items-start gap-3 text-[15px] text-zinc-300 md:justify-self-end"
          aria-label="Footer navigation"
        >
          <a class="hover:text-white" href="#about">About</a>
          <a class="hover:text-white" href="#services">What we do</a>
          <a class="hover:text-white" href="#get-involved">Get involved</a>
          <a class="hover:text-white" href="#support">Donate</a>
        </nav>

        <nav
          class="flex flex-col items-start gap-3 text-[15px] text-zinc-300 max-lg:col-span-full max-lg:flex-row lg:justify-self-end"
          aria-label="Social media"
        >
          <a
            class="inline-flex items-center gap-2.5 border-b border-zinc-600 pb-0.5 hover:border-white hover:text-white"
            href="https://www.instagram.com/afterhoursoutreach"
            target="_blank"
            rel="noreferrer"
          >
            <svg
              class="size-5 shrink-0 text-blue"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              aria-hidden="true"
            >
              <rect x="3" y="3" width="18" height="18" rx="5"></rect>
              <circle cx="12" cy="12" r="4"></circle>
              <circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none"
              ></circle>
            </svg>
            Instagram</a
          >
          <a
            class="inline-flex items-center gap-2.5 border-b border-zinc-600 pb-0.5 hover:border-white hover:text-white"
            href="https://discord.com/"
            target="_blank"
            rel="noreferrer"
          >
            <svg
              class="size-5 shrink-0 fill-current text-blue"
              viewBox="0 0 24 24"
              aria-hidden="true"
            >
              <path
                d="M19.5 5.3A16.4 16.4 0 0 0 15.4 4l-.5 1a15.2 15.2 0 0 0-5.8 0l-.5-1a16.4 16.4 0 0 0-4.1 1.3C1.9 9.2 1.2 12.9 1.5 16.6a16.7 16.7 0 0 0 5 2.5l1.2-1.6a11 11 0 0 1-1.9-.9l.5-.4a13.3 13.3 0 0 0 11.4 0l.5.4c-.6.4-1.3.7-1.9.9l1.2 1.6a16.7 16.7 0 0 0 5-2.5c.4-4.3-.7-8-3-11.3ZM8.7 14.4c-1.1 0-2-1-2-2.3s.9-2.3 2-2.3 2 1 2 2.3-.9 2.3-2 2.3Zm6.6 0c-1.1 0-2-1-2-2.3s.9-2.3 2-2.3 2 1 2 2.3-.9 2.3-2 2.3Z"
              ></path>
            </svg>
            Discord</a
          >
        </nav>
      </div>

      <div
        class="mx-auto flex min-h-20 w-full max-w-[1248px] items-center border-t border-zinc-800 px-6 text-sm text-zinc-400 max-sm:px-4 max-sm:py-5"
      >
        <p class="m-0">
          &copy; {new Date().getFullYear()} After Hours Outreach Initiative
        </p>
      </div>
    </footer>

    <script>
      const mobileNav =
        document.querySelector<HTMLDetailsElement>(".mobile-nav");
      const mobileNavToggle = mobileNav?.querySelector("summary");

      mobileNav?.addEventListener("toggle", () => {
        mobileNavToggle?.setAttribute(
          "aria-label",
          mobileNav.open ? "Close navigation" : "Open navigation",
        );
      });

      document.querySelectorAll(".mobile-nav a").forEach((link) => {
        link.addEventListener("click", () =>
          link.closest("details")?.removeAttribute("open"),
        );
      });
    </script>
  </body>
</html>
