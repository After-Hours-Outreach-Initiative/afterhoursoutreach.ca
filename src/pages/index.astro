---
import { Image } from "astro:assets";
import PatrolList from "@/components/PatrolList.astro";
import Layout from "@/layouts/Layout.astro";
import outreachTeam from "@/assets/outreach-team.jpg";
import { seedPatrols, upcoming } from "@/data/patrols";

const patrols = upcoming(seedPatrols);
---

<Layout
  title="After Hours Outreach Initiative"
  description="Volunteer-based evening street outreach providing practical care and overdose response in Vancouver's Downtown Eastside."
>
  <section class="bg-black text-white" id="top">
    <div
      class="mx-auto grid min-h-[720px] w-full max-w-[1248px] items-center gap-12 px-6 max-sm:px-4 lg:grid-cols-[minmax(0,1fr)_420px]"
    >
      <div
        class="flex w-full max-w-[760px] flex-col justify-center py-20 max-lg:pt-0"
      >
        <h1>
          <span class="block text-blue">After Hours</span>
          <span class="block">Outreach Initiative</span>
        </h1>
        <p class="mt-8 max-w-2xl text-xl">
          Volunteer teams provide food, water, clothing, harm reduction
          supplies, naloxone, first aid, and immediate overdose response in
          Vancouver's Downtown Eastside.
        </p>
        <div class="mt-9 flex flex-wrap gap-3.5 max-sm:flex-col">
          <a class="btn btn-primary" href="/volunteer">Volunteer with us</a>
          <a class="btn btn-subtle" href="#events">See upcoming events</a>
        </div>
      </div>

      <div
        class="relative flex items-center justify-center max-lg:order-first max-lg:pt-14"
      >
        <Image
          class="w-full max-w-[420px] rounded-2xl object-cover"
          src={outreachTeam}
          alt="Volunteers from After Hours Outreach Initiative standing together in front of a mural in the Downtown Eastside."
          widths={[420, 840]}
          sizes="(max-width: 480px) 100vw, 420px"
          loading="eager"
        />
      </div>
    </div>
  </section>

  <section
    class="scroll-mt-19 bg-black text-white lg:scroll-mt-22"
    id="events"
    aria-labelledby="events-heading"
  >
    <div
      class="mx-auto w-full max-w-[1248px] px-6 py-24 max-sm:px-4 max-sm:py-18"
    >
      <h2 class="max-w-3xl" id="events-heading">Upcoming events</h2>

      <p class="mt-6 max-w-3xl text-xl">
        Starting in mid October, we plan to run one patrol every two weeks.
      </p>

      <div class="mt-10">
        <PatrolList patrols={patrols} />
      </div>

      <p class="mt-8">
        <a class="text-lg text-blue underline" href="/patrols">
          See every upcoming patrol
        </a>
      </p>
    </div>
  </section>
</Layout>
