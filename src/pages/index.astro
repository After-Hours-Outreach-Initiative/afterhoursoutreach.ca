---
import { Image } from "astro:assets";
import Layout from "@/layouts/Layout.astro";
import outreachTeam from "@/assets/outreach-team.jpg";
import upcomingEventsPhoto from "@/assets/upcoming-events.png";
import { env } from "cloudflare:workers";
import { loadAccountNavigation } from "@/server/account-navigation";
import { listUpcomingPublicEvents } from "@/server/db/events";
import { formatEventDate } from "@/data/event-time";
export const prerender = false;
const [account, upcomingEvents] = await Promise.all([
  loadAccountNavigation(env, Astro.request, Astro.response.headers),
  listUpcomingPublicEvents(env.DB).catch(() => {
    console.error(JSON.stringify({ event: "homepage_events_unavailable" }));
    return null;
  }),
]);
---

<Layout
  title="After Hours Outreach Initiative"
  description="Volunteer-based evening street outreach providing practical care and overdose response in Vancouver's Downtown Eastside."
  account={account}
>
  <section class="bg-black text-white" id="top">
    <div
      class="mx-auto grid min-h-[45rem] w-full max-w-site items-center gap-12 px-6 max-sm:px-4 lg:grid-cols-[minmax(0,1fr)_26.25rem]"
    >
      <div
        class="flex w-full max-w-[47.5rem] flex-col justify-center py-20 max-lg:pt-0"
      >
        <h1>
          <span class="block text-blue">After Hours</span>
          <span class="block">Outreach Initiative</span>
        </h1>
        <p class="mt-8 max-w-2xl text-xl">
          Volunteer teams provide food, water, clothing, harm reduction
          supplies, naloxone, first aid, and immediate overdose response in
          Vancouver's Downtown Eastside.
        </p>
        <div class="mt-9 flex flex-wrap gap-3.5 max-sm:flex-col">
          <a
            class="btn btn-primary"
            href={account.signedIn ? "/events" : "/volunteer"}
          >
            {account.signedIn ? "View events" : "Volunteer with us"}
          </a>
        </div>
      </div>

      <div
        class="relative flex items-center justify-center max-lg:order-first max-lg:pt-14"
      >
        <Image
          class="w-full max-w-[26.25rem] rounded-2xl object-cover"
          src={outreachTeam}
          alt="Volunteers from After Hours Outreach Initiative standing together in front of a mural in the Downtown Eastside."
          widths={[420, 840]}
          sizes="(max-width: 480px) 100vw, 420px"
          loading="eager"
        />
      </div>
    </div>
  </section>

  <section
    class="border-t border-zinc-800 bg-ink text-white"
    id="upcoming-events"
    aria-labelledby="upcoming-events-heading"
  >
    <div
      class="mx-auto grid w-full max-w-site items-center gap-10 px-6 py-24 max-sm:px-4 max-sm:py-18 lg:grid-cols-2 lg:gap-16"
    >
      <Image
        class="aspect-4/3 w-full rounded-2xl border border-zinc-800 object-cover object-bottom"
        src={upcomingEventsPhoto}
        alt="Outreach volunteers carrying backpacks as they walk through the Downtown Eastside at night."
        width={960}
        height={720}
        fit="cover"
        position="bottom"
        widths={[480, 960, 1440]}
        sizes="(min-width: 1024px) 50vw, 100vw"
        loading="lazy"
      />

      <div class="min-w-0">
        <h2 id="upcoming-events-heading">Upcoming events</h2>
        {
          upcomingEvents?.length ? (
            <ul class="mt-8 divide-y divide-zinc-700 border-y border-zinc-700">
              {upcomingEvents.map((event) => (
                <li class="flex flex-col gap-2 py-6">
                  <time
                    class="text-xl font-medium"
                    datetime={new Date(event.startsAt).toISOString()}
                  >
                    {formatEventDate(event.startsAt)}
                  </time>
                  <span class="text-base text-zinc-400">
                    {event.confirmed} of {event.spots} spots taken
                  </span>
                </li>
              ))}
            </ul>
          ) : (
            <p class="mt-8 text-zinc-300">
              {upcomingEvents
                ? "No upcoming events are scheduled. Check back soon."
                : "Upcoming events are temporarily unavailable."}
            </p>
          )
        }
      </div>
    </div>
  </section>
</Layout>
