---
import { env } from "cloudflare:workers";
import AccountLayout from "@/components/volunteer/AccountLayout.astro";
import AccountProfileForm from "@/components/volunteer/AccountProfileForm.astro";
import ArrowRightIcon from "@/components/icons/ArrowRightIcon.astro";
import {
  authBindingsForRequest,
  createAuth,
  forwardCookies,
  readAccountSession,
} from "@/server/auth";
import { loadProfile } from "@/server/db/profiles";
import { loadApplicationDraftState } from "@/server/db/application-drafts";
import type { ApplicationDraft } from "@/data/application-draft";
export const prerender = false;
let email = "";
let userId = "";
let draft: ApplicationDraft | null = null;
let generation: string | null = null;
if (!env.BETTER_AUTH_SECRET)
  return Astro.redirect("/volunteer/sign-in?returnTo=/apply");
try {
  const { response: current, headers } = await readAccountSession(
    createAuth(authBindingsForRequest(env, Astro.request)),
    Astro.request,
  );
  forwardCookies(headers, Astro.response.headers);
  if (
    !current?.user.emailVerified ||
    (current.user.twoFactorEnabled && !current.session.twoFactorVerified)
  )
    return Astro.redirect("/volunteer/sign-in?returnTo=/apply");
  if (await loadProfile(env.DB, current.user.id))
    return Astro.redirect("/volunteer/account");
  email = current.user.email;
  userId = current.user.id;
  ({ draft, generation } = await loadApplicationDraftState(env.DB, userId));
} catch {
  return new Response("Your account is temporarily unavailable.", {
    status: 503,
  });
}
---

<AccountLayout
  title="Volunteer application"
  description="Complete your volunteer profile."
  signedIn
  email={email}
>
  <section data-application-flow>
    <div class="volunteer-application-intro">
      <a class="volunteer-back-link" href="/volunteer">
        <ArrowRightIcon class="size-[1.25em] shrink-0 rotate-180" />
        <span>Back to application progress</span>
      </a>
      <h2 id="application-overview" data-application-section>
        Volunteer Application
      </h2>
      <p class="mt-6 text-base text-zinc-400">
        Your answers are saved to your account and this browser as you fill them
        in. See our <a href="/privacy" class="underline underline-offset-4"
          >privacy policy</a
        >.
      </p>
    </div>
    <AccountProfileForm
      userId={userId}
      draft={draft}
      draftGeneration={generation}
      application
    />
  </section>
</AccountLayout>
