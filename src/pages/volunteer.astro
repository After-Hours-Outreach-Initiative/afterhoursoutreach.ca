---
export const prerender = false;
const signInUrl = new URL(Astro.url);
signInUrl.pathname = "/volunteer/sign-in";
// Keep legacy event deep links while sharing the complete sign-in experience.
if (!signInUrl.searchParams.has("returnTo"))
  signInUrl.searchParams.set("returnTo", `/events${Astro.url.search}`);
return Astro.rewrite(signInUrl);
---
