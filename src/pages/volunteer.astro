---
import DiscordIcon from "@/components/icons/DiscordIcon.astro";
import Layout from "@/layouts/Layout.astro";
import { buttonOutline, buttonPrimary } from "@/styles/buttons";
import { social, volunteerFormUrl } from "@/data/site";
---

<Layout
  title="Volunteer | After Hours Outreach Initiative"
  description="Sign up to volunteer with After Hours Outreach Initiative, doing evening street outreach in Vancouver's Downtown Eastside."
>
  <section class="bg-black text-white" id="volunteer">
    <div
      class="mx-auto w-full max-w-[1248px] px-6 py-24 max-sm:px-4 max-sm:py-18"
    >
      <h1 class="max-w-4xl">
        <span class="text-blue">Volunteer</span>
      </h1>
      <p class="mt-8 max-w-3xl text-zinc-300">
        Our volunteers are community advocates, people with lived experience of
        recovery, first responders, healthcare workers, students heading into
        healthcare, and people who simply wanted to help out at night.
      </p>
      <p class="mt-6 max-w-3xl text-zinc-300">
        Patrols typically run Tuesdays and Thursdays, 8:30 PM to midnight. How
        often we go out depends on how many volunteers are available and what
        supplies we have on hand.
      </p>
      <p class="mt-6 max-w-3xl text-zinc-300">
        Fill out the form and we will be in touch about the next orientation.
      </p>

      <div class="mt-10 flex flex-wrap gap-3.5 max-sm:flex-col">
        {
          volunteerFormUrl ? (
            <a
              class={buttonPrimary}
              href={volunteerFormUrl}
              target="_blank"
              rel="noreferrer"
            >
              {/* lucide: external-link */}
              <svg
                class="lucide size-[18px] shrink-0"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                aria-hidden="true"
              >
                <path d="M15 3h6v6" />
                <path d="M10 14 21 3" />
                <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6" />
              </svg>
              Volunteer sign-up form
            </a>
          ) : (
            <p class="m-0 text-sm text-zinc-400">
              TODO: add the Google Form sign-up link.
            </p>
          )
        }
      </div>

      <p class="mt-12 max-w-3xl text-zinc-300">
        Join our Discord for more information and to become more involved.
      </p>

      <div class="mt-6 flex flex-wrap gap-3.5 max-sm:flex-col">
        <a
          class={buttonOutline}
          href={social.discord}
          target="_blank"
          rel="noreferrer"
        >
          <DiscordIcon class="size-5 shrink-0 fill-current" />
          Join our Discord
        </a>
      </div>
    </div>
  </section>
</Layout>
