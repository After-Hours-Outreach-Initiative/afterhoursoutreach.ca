---
import { env } from "cloudflare:workers";
import { accountContext, requireOrganizer } from "@/server/db/access";
import {
  findVolunteer,
  viewVolunteerProfile,
  type VolunteerRow,
} from "@/server/db/volunteers";
import { forwardCookies } from "@/server/auth";
import { RequestError } from "@/server/http";
import { volunteerListReturnUrl } from "@/data/volunteer-list";
import {
  applicationDisplayName,
  formatApplicationSubmittedTime,
  profileFormSections,
  submittedApplicationSections,
} from "@/data/application";
import AccountLayout from "@/components/volunteer/AccountLayout.astro";
import ApplicationSummary from "@/components/volunteer/ApplicationSummary.astro";
import AccountProfileAnswers from "@/components/volunteer/AccountProfileAnswers.astro";
import VolunteerControls from "@/components/volunteer/VolunteerControls.astro";
import PageContents from "@/components/volunteer/PageContents.astro";
import ArrowRightIcon from "@/components/icons/ArrowRightIcon.astro";
import { loadDiscordStatus } from "@/server/discord/status";
import { loadApplicationProgress } from "@/server/db/application-progress";
import "@/styles/volunteer.css";
export const prerender = false;
let profile;
let person: VolunteerRow | null = null;
let accountName = "";
let accountGreeting = "";
let accountEmail = "";
const returnUrl = volunteerListReturnUrl(
  Astro.url.searchParams.get("returnTo"),
);
try {
  const { actor, headers, email, greetingName } = await accountContext(
    env,
    Astro.request,
  );
  forwardCookies(headers, Astro.response.headers);
  if (!actor)
    return Astro.redirect(
      `/volunteer/sign-in?returnTo=${encodeURIComponent(Astro.url.pathname + Astro.url.search)}`,
    );
  requireOrganizer(actor);
  accountName = actor.name;
  accountGreeting = greetingName;
  accountEmail = email;
  profile = await viewVolunteerProfile(env.DB, actor, Astro.params.id ?? "");
  person = await findVolunteer(env.DB, actor, Astro.params.id ?? "");
} catch (error) {
  return new Response(
    error instanceof RequestError
      ? error.message
      : "Volunteer profile is temporarily unavailable.",
    { status: error instanceof RequestError ? error.status : 503 },
  );
}
if (!profile || !person)
  return new Response("Volunteer not found", { status: 404 });
const discord = await loadDiscordStatus(env, person.id);
const progress = await loadApplicationProgress(env.DB, person.id);
const profileSections = profileFormSections();
const contents = [
  { id: "volunteer-profile-panel", heading: "Current profile" },
  ...profileSections.map((section) => ({
    id: `volunteer-current-${section.key}`,
    heading: section.heading,
    nested: true,
  })),
  { id: "volunteer-application-panel", heading: "Submitted application" },
  ...submittedApplicationSections.map((section) => ({
    id: `volunteer-${section.key}`,
    heading: section.heading,
    nested: true,
  })),
  { id: "volunteer-organizer-controls-heading", heading: "Organizer controls" },
];
---

<AccountLayout
  title="Volunteer profile"
  description="Organizer-only volunteer profile."
  signedIn
  organizer
  name={accountName}
  greetingName={accountGreeting}
  email={accountEmail}
>
  <a class="volunteer-back-link" href={returnUrl}>
    <ArrowRightIcon class="size-[1.25em] shrink-0 rotate-180" />
    <span>Back to volunteers</span>
  </a>
  <section class="volunteer-panel">
    <div data-volunteer-profile>
      <div data-volunteer-profile-overview>
        <h2>{applicationDisplayName(profile.answers)}</h2>
        <p>
          {
            person.applicationApproved
              ? profile.applicationApprovedBy
                ? `Application approved by ${profile.applicationApprovedBy.name} (${profile.applicationApprovedBy.email})`
                : "Application approved. Approving organizer not recorded."
              : "Application awaiting approval"
          }
        </p>
        <div class="account-profile-summary mt-8" data-naloxone-review>
          <dl>
            <div>
              <dt>Naloxone 101</dt>
              <dd>
                {
                  profile.naloxoneCompletedAt === null
                    ? "Completion not confirmed"
                    : `Completion confirmed ${formatApplicationSubmittedTime(new Date(profile.naloxoneCompletedAt).toISOString())}`
                }
              </dd>
            </div>
            <div>
              <dt>Discord</dt>
              <dd>
                {
                  !progress.discordRequired
                    ? "Linking not required for this existing volunteer. "
                    : "Required before application approval. "
                }{discord.username ? `${discord.username}: ` : ""}{
                  discord.connection
                }. {discord.sync}.
              </dd>
            </div>
          </dl>
        </div>
      </div>
      <PageContents
        entries={contents}
        heading="Sections"
        idleHeading="Sections"
      />
      <div data-volunteer-profile-body>
        <nav
          class="volunteer-profile-tabs"
          aria-label="Volunteer details"
          data-volunteer-profile-tabs
        >
          <a
            id="volunteer-profile-tab"
            href="#volunteer-profile-panel"
            data-volunteer-profile-tab="profile">Profile</a
          >
          <a
            id="volunteer-application-tab"
            href="#volunteer-application-panel"
            data-volunteer-profile-tab="application">Application</a
          >
        </nav>
        <section
          id="volunteer-profile-panel"
          data-volunteer-profile-panel="profile"
          aria-labelledby="volunteer-profile-heading"
        >
          <h2
            id="volunteer-profile-heading"
            data-volunteer-profile-panel-heading
          >
            Current profile
          </h2>
          <div class="account-profile-summary mt-6 mb-8">
            <dl>
              <div>
                <dt>Email</dt>
                <dd>{profile.email}</dd>
              </div>
            </dl>
          </div>
          {
            profileSections.map((section) => (
              <section class="volunteer-profile-section">
                <h3
                  id={`volunteer-current-${section.key}`}
                  class="volunteer-profile-heading mb-6"
                  data-contents-section
                >
                  {section.heading}
                </h3>
                <AccountProfileAnswers
                  section={section}
                  values={profile.answers}
                />
              </section>
            ))
          }
        </section>
        <section
          id="volunteer-application-panel"
          data-volunteer-profile-panel="application"
          data-submitted-application
          aria-labelledby="volunteer-application-heading"
        >
          <h2
            id="volunteer-application-heading"
            data-volunteer-profile-panel-heading
          >
            Submitted application
          </h2>
          {
            profile.submission ? (
              <ApplicationSummary
                {...profile.submission}
                idPrefix="volunteer"
              />
            ) : (
              <>
                <p class="volunteer-help mt-4">
                  The original submitted application was not recorded. These
                  details use the current profile.
                </p>
                <ApplicationSummary {...profile} idPrefix="volunteer" />
              </>
            )
          }
        </section>
        <VolunteerControls person={person} />
      </div>
    </div>
  </section>
</AccountLayout>
<script>
  import "@/scripts/volunteer";
</script>
