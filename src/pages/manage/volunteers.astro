---
import AccountLayout from "@/components/volunteer/AccountLayout.astro";
import AttendeeAvatar from "@/components/volunteer/AttendeeAvatar.astro";
import SearchIcon from "@/components/icons/SearchIcon.astro";
import { env } from "cloudflare:workers";
import { accountContext, requireOrganizer } from "@/server/db/access";
import { listVolunteers, volunteerPageSize } from "@/server/db/volunteers";
import { forwardCookies } from "@/server/auth";
import { RequestError } from "@/server/http";
import { volunteerListState, volunteerListUrl } from "@/data/volunteer-list";
import "@/styles/volunteer.css";
export const prerender = false;
let team: Awaited<ReturnType<typeof listVolunteers>> = {
  rows: [],
  hasMore: false,
  allApplicantsCount: 0,
  awaitingApprovalCount: 0,
};
let lock = "";
let accountName = "";
let accountGreeting = "";
let accountEmail = "";
const state = volunteerListState(Astro.url.searchParams);
const { search, offset, approval } = state;
const listUrl = volunteerListUrl(state);
try {
  const { actor, headers, email, greetingName } = await accountContext(
    env,
    Astro.request,
  );
  forwardCookies(headers, Astro.response.headers);
  if (!actor)
    return Astro.redirect(
      `/volunteer/sign-in?returnTo=${encodeURIComponent(listUrl)}`,
    );
  if (actor.role !== "organizer")
    return new Response("Organizer access is required.", { status: 403 });
  accountName = actor.name;
  accountGreeting = greetingName;
  accountEmail = email;
  try {
    requireOrganizer(actor);
  } catch (error) {
    if (error instanceof RequestError) lock = error.message;
    else throw error;
  }
  if (!lock)
    team = await listVolunteers(env.DB, actor, search, offset, approval);
} catch {
  return new Response("Volunteer management is temporarily unavailable.", {
    status: 503,
  });
}
---

<AccountLayout
  title="Volunteers"
  description="Organizer volunteer management."
  signedIn
  organizer
  name={accountName}
  greetingName={accountGreeting}
  email={accountEmail}
>
  {
    lock ? (
      <p class="volunteer-notice">
        {lock} <a href="/volunteer/account">Your account</a>
      </p>
    ) : (
      <>
        <section
          class="volunteer-events"
          data-volunteer-browser
          aria-labelledby="volunteers-heading"
        >
          <div class="volunteer-section-heading">
            <h2 id="volunteers-heading">Volunteers</h2>
          </div>
          <form
            class="volunteer-filters"
            method="get"
            role="group"
            aria-label="Application approval"
            data-volunteer-filters
          >
            {search && <input type="hidden" name="q" value={search} />}
            <button
              class="volunteer-filter"
              type="submit"
              name="approval"
              value="all"
              data-volunteer-filter="all"
              aria-pressed={approval === "all" ? "true" : "false"}
            >
              <span>
                All (
                <span data-all-applicants-count>{team.allApplicantsCount}</span>
                )
              </span>
            </button>
            <button
              class="volunteer-filter"
              type="submit"
              name="approval"
              value="awaiting"
              data-volunteer-filter="awaiting"
              aria-pressed={approval === "awaiting" ? "true" : "false"}
            >
              <span>
                Ready for review (
                <span data-awaiting-approval-count>
                  {team.awaitingApprovalCount}
                </span>
                )
              </span>
            </button>
          </form>
          <form
            class="volunteer-search"
            method="get"
            data-volunteer-search-form
          >
            <input type="hidden" name="approval" value={approval} />
            <label class="volunteer-search-field">
              <span class="sr-only">Find a volunteer</span>
              <SearchIcon class="volunteer-search-icon" />
              <input
                type="search"
                name="q"
                data-volunteer-search
                value={search}
                maxlength="100"
                placeholder="Search by name"
              />
            </label>
            <button class="btn btn-outline" type="submit">
              Search
            </button>
          </form>
          <div data-volunteer-results>
            <div
              class="volunteer-table-scroll"
              role="region"
              aria-label="Volunteer table"
              tabindex="0"
            >
              <table class="volunteer-table">
                <caption class="sr-only">
                  Volunteer applicants and access status
                </caption>
                <thead>
                  <tr>
                    <th scope="col">Name and role</th>
                    <th scope="col">Application</th>
                    <th scope="col">Patrol access</th>
                    <th scope="col">Orientations completed</th>
                    <th scope="col">Status</th>
                  </tr>
                </thead>
                <tbody>
                  {team.rows.map((person) => (
                    <tr data-volunteer-row>
                      <th scope="row">
                        <div class="volunteer-table-person">
                          <AttendeeAvatar
                            category={person.category}
                            decorative
                          />
                          <div class="volunteer-table-name">
                            <a
                              href={`/manage/volunteers/${encodeURIComponent(person.id)}?returnTo=${encodeURIComponent(listUrl)}`}
                              data-volunteer-profile-link
                            >
                              {person.name}
                            </a>
                            <span class="volunteer-table-detail">
                              {person.role === "organizer"
                                ? "Organizer"
                                : "Outreach Volunteer"}
                            </span>
                          </div>
                        </div>
                      </th>
                      <td>
                        {person.applicationApproved
                          ? "Approved"
                          : person.applicationRejectionReason
                            ? "Rejected"
                            : person.applicationReadyForReview
                              ? "Ready for review"
                              : "Application in progress"}
                        {person.role === "organizer" && (
                          <span class="volunteer-table-detail">
                            Event access through organizer role
                          </span>
                        )}
                      </td>
                      <td
                        class:list={{
                          "volunteer-table-approved": Boolean(
                            person.patrolApproved,
                          ),
                        }}
                      >
                        {person.patrolApproved
                          ? "Approved for patrols"
                          : "Not approved for patrols"}
                      </td>
                      <td>{person.orientations}</td>
                      <td>{person.active ? "Active" : "Inactive"}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
            {!team.rows.length && (
              <p class="volunteer-notice">
                {approval === "awaiting"
                  ? offset > 0
                    ? "No applications ready for review on this page. Return to the previous page."
                    : search
                      ? "No applications ready for review match your search."
                      : "No applications are ready for review."
                  : "No volunteer applicants match your search."}
              </p>
            )}
            <div class="volunteer-actions">
              {offset > 0 && (
                <a
                  class="btn btn-quiet"
                  href={volunteerListUrl({
                    ...state,
                    offset: Math.max(0, offset - volunteerPageSize),
                  })}
                >
                  Previous volunteers
                </a>
              )}
              {team.hasMore && (
                <a
                  class="btn btn-quiet"
                  href={volunteerListUrl({
                    ...state,
                    offset: offset + volunteerPageSize,
                  })}
                >
                  Next volunteers
                </a>
              )}
            </div>
          </div>
          <p
            data-volunteer-search-error
            class="volunteer-notice"
            role="status"
            hidden
          />
        </section>
      </>
    )
  }
</AccountLayout>
<script>
  import { initVolunteerBrowser } from "@/scripts/volunteer-browser";
  initVolunteerBrowser();
</script>
