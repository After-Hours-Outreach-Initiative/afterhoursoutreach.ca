---
import { env } from "cloudflare:workers";
import AccountLayout from "@/components/volunteer/AccountLayout.astro";
import AccountProfileForm from "@/components/volunteer/AccountProfileForm.astro";
import AccountNotificationSettings from "@/components/volunteer/AccountNotificationSettings.astro";
import AccountEmailSettings from "@/components/volunteer/AccountEmailSettings.astro";
import AccountDeleteSettings from "@/components/volunteer/AccountDeleteSettings.astro";
// Discord connection is temporarily disabled; keep the integration for later.
// import DiscordConnection from "@/components/volunteer/DiscordConnection.astro";
// import DiscordConnectionNotice from "@/components/volunteer/DiscordConnectionNotice.astro";
import ApplicationProgressMini from "@/components/volunteer/ApplicationProgressMini.astro";
import ApplicationSummary from "@/components/volunteer/ApplicationSummary.astro";
import {
  isApplicationComplete,
  loadApplicationProgress,
} from "@/server/db/application-progress";
import PageContents from "@/components/volunteer/PageContents.astro";
import { accountGreeting } from "@/data/account-navigation";
import { contactEmail } from "@/data/site";
import {
  authBindingsForRequest,
  createAuth,
  forwardCookies,
  readAccountSession,
} from "@/server/auth";
import { loadProfile, loadSubmittedApplication } from "@/server/db/profiles";
import { createDatabase } from "@/server/db";
import { accountDeletionFreshAge } from "@/server/db/account-deletion";
import { volunteerStatus } from "@/server/db/schema";
import { eq } from "drizzle-orm";
import {
  profileFormSections,
  type ApplicationAnswers,
} from "@/data/application";
export const prerender = false;
let values: ApplicationAnswers | null = null;
let submission: Awaited<ReturnType<typeof loadSubmittedApplication>> = null;
let applicationProgress: Awaited<ReturnType<typeof loadApplicationProgress>>;
let accountCreatedAt: Date | null = null;
let patrolApprovedAt: Date | null = null;
const accountDate = new Intl.DateTimeFormat("en-CA", {
  timeZone: "America/Vancouver",
  dateStyle: "long",
});
let email = "";
let legacyName = "";
let userId = "";
let twoFactorEnabled = false;
let organizer = false;
let active = false;
let emailNeedsSignIn = false;
let deletionNeedsSignIn = false;
if (!env.BETTER_AUTH_SECRET) return Astro.redirect("/volunteer/sign-in");
try {
  const auth = createAuth(authBindingsForRequest(env, Astro.request));
  const { response: current, headers } = await readAccountSession(
    auth,
    Astro.request,
  );
  forwardCookies(headers, Astro.response.headers);
  if (
    !current?.user.emailVerified ||
    (current.user.twoFactorEnabled && !current.session.twoFactorVerified)
  )
    return Astro.redirect("/volunteer/sign-in?returnTo=/volunteer/account");
  values = await loadProfile(env.DB, current.user.id);
  submission = await loadSubmittedApplication(env.DB, current.user.id);
  applicationProgress = await loadApplicationProgress(env.DB, current.user.id);
  accountCreatedAt = current.user.createdAt;
  email = current.user.email;
  legacyName = current.user.name;
  userId = current.user.id;
  const { sessionConfig } = await auth.$context;
  emailNeedsSignIn =
    sessionConfig.freshAge !== 0 &&
    Date.now() - current.session.createdAt.getTime() >=
      sessionConfig.freshAge * 1000;
  deletionNeedsSignIn =
    Date.now() - current.session.createdAt.getTime() >=
    accountDeletionFreshAge * 1000;
  twoFactorEnabled = Boolean(current.user.twoFactorEnabled);
  organizer = current.user.role === "organizer";
  const status = await createDatabase(env.DB).query.volunteerStatus.findFirst({
    where: eq(volunteerStatus.user_id, current.user.id),
  });
  active = status?.active ?? false;
  patrolApprovedAt = status?.patrol_approved ? status.approved_at : null;
} catch {
  return new Response("Your account is temporarily unavailable.", {
    status: 503,
  });
}
const applicationComplete = isApplicationComplete(applicationProgress);
const contents = [
  { id: "account-profile-heading", heading: "Your profile" },
  ...(values ? profileFormSections() : []).map((section) => ({
    id: `account-profile-${section.key}`,
    heading: section.heading,
    nested: true,
  })),
  ...(applicationComplete || applicationProgress.applicationRejectionReason
    ? [
        {
          id: "submitted-application-heading",
          heading: "Volunteer Application",
        },
      ]
    : []),
  { id: "account-settings-heading", heading: "Account settings" },
  ...(organizer
    ? [
        {
          id: "account-notifications-heading",
          heading: "Email notifications",
          nested: true,
        },
      ]
    : []),
  { id: "account-email-heading", heading: "Email address", nested: true },
  // { id: "account-discord-heading", heading: "Discord", nested: true },
  {
    id: "account-factor-heading",
    heading: "Two-factor authentication",
    nested: true,
  },
  {
    id: "account-sessions-heading",
    heading: "Sign out",
    nested: true,
  },
  { id: "account-delete-heading", heading: "Delete account", nested: true },
];
---

<AccountLayout
  title="Your account"
  description="Edit your volunteer profile and manage your account settings."
  signedIn
  organizer={organizer}
  name={accountGreeting(values, legacyName)}
  greetingName={accountGreeting(values, legacyName)}
  email={email}
>
  <h1 slot="heading" class="mb-6 text-2xl md:text-4xl">
    Account
  </h1>
  {/* Discord connection is temporarily disabled.
  {applicationComplete && <DiscordConnectionNotice {userId} />}
  */}
  <div data-account-contents-flow>
    <PageContents
      entries={contents}
      heading="Sections"
      idleHeading="Sections"
    />
    <div data-account-contents-body>
      {values && !active && (
        <p class="volunteer-notice" role="status">
          Your volunteer account is inactive. Contact an organizer at{" "}
          <a href={`mailto:${contactEmail}`}>{contactEmail}</a> to restore
          access.
        </p>
      )}
      <section class="volunteer-panel">
        <h2 id="account-profile-heading" data-contents-section>
          Your profile
        </h2>
        <div class="account-profile-summary mt-6 mb-8">
          <dl>
            <div>
              <dt>Account created</dt>
              <dd>
                {accountCreatedAt ? (
                  <time datetime={accountCreatedAt.toISOString()}>
                    {accountDate.format(accountCreatedAt)}
                  </time>
                ) : (
                  "Unavailable"
                )}
              </dd>
            </div>
            <div>
              <dt>Approved to patrol</dt>
              <dd>
                {patrolApprovedAt ? (
                  <time datetime={patrolApprovedAt.toISOString()}>
                    {accountDate.format(patrolApprovedAt)}
                  </time>
                ) : (
                  "Not yet approved"
                )}
              </dd>
            </div>
          </dl>
        </div>
        {values ? (
          <AccountProfileForm values={values} userId={userId} />
        ) : (
          <p>
            You have not submitted a volunteer application.{" "}
            <a href="/apply">Continue your application</a>.
          </p>
        )}
      </section>
      {(applicationComplete ||
        applicationProgress.applicationRejectionReason) && (
        <section
          class="volunteer-panel"
          aria-labelledby="submitted-application-heading"
        >
          <h2 id="submitted-application-heading" data-contents-section>
            Volunteer Application
          </h2>
          <ApplicationProgressMini
            progress={applicationProgress}
            idPrefix="account-application"
            showTime
          >
            <section
              slot="application"
              class="px-3 pb-3"
              aria-label="Submitted answers"
            >
              {submission ? (
                <ApplicationSummary
                  {...submission}
                  idPrefix="account-application"
                />
              ) : (
                <p class="volunteer-help mt-4">
                  Your application form was submitted. The original submitted
                  answers were not captured for this account.
                </p>
              )}
            </section>
            <Fragment slot="review">
              {applicationProgress.applicationRejectionReason && (
                <p
                  class="volunteer-help px-3 pb-3 whitespace-pre-wrap"
                  data-application-rejection
                >
                  Reason: {applicationProgress.applicationRejectionReason}
                </p>
              )}
            </Fragment>
          </ApplicationProgressMini>
        </section>
      )}
      <section class="volunteer-panel">
        <h2 id="account-settings-heading" data-contents-section>
          Account settings
        </h2>
        {organizer && <AccountNotificationSettings {userId} />}
        <AccountEmailSettings email={email} needsSignIn={emailNeedsSignIn} />
        {/* Discord connection is temporarily disabled.
        <div class="volunteer-setting">
          <div class="w-full">
            <h3 id="account-discord-heading" data-contents-section>Discord</h3>
            <DiscordConnection
              {userId}
              canConnect={!applicationProgress.discordRequired ||
                applicationProgress.naloxoneCompletedAt !== null}
              required={applicationProgress.discordRequired}
            />
          </div>
        </div>
        */}
        <div
          class="volunteer-setting account-setting-unavailable"
          data-factor-settings
          aria-disabled="true"
        >
          <div>
            <h3 id="account-factor-heading" data-contents-section>
              Two-factor authentication
            </h3>
            <p>Coming soon.</p>
            {twoFactorEnabled && (
              <p role="status">
                Your authenticator is enabled. It is required each time you sign
                in.
              </p>
            )}
          </div>
        </div>
        <div class="volunteer-setting" data-account-sessions>
          <div class="w-full">
            <h3 id="account-sessions-heading" data-contents-section>
              Sign out
            </h3>
            <div class="account-session-actions mt-6">
              <form data-sign-out action="/api/v1/auth/sign-out" method="post">
                <button
                  class="btn btn-outline"
                  type="submit"
                  data-loading-label="Signing out…"
                >
                  Sign out
                </button>
                <p data-form-message role="status" hidden />
              </form>
              <form
                data-sign-out-everywhere
                action="/api/v1/account/session"
                method="post"
              >
                <button
                  class="btn btn-outline"
                  type="submit"
                  data-loading-label="Signing out…"
                >
                  Sign out of all devices
                </button>
                <p data-form-message role="status" hidden />
              </form>
            </div>
          </div>
        </div>
        <AccountDeleteSettings {userId} needsSignIn={deletionNeedsSignIn} />
      </section>
    </div>
  </div>
</AccountLayout>
