---
import { env } from "cloudflare:workers";
import { APIError } from "better-auth/api";
import AccountLayout from "@/components/volunteer/AccountLayout.astro";
import AccountProfileForm from "@/components/volunteer/AccountProfileForm.astro";
import AccountEmailSettings from "@/components/volunteer/AccountEmailSettings.astro";
import SubmittedApplication from "@/components/volunteer/SubmittedApplication.astro";
import FieldError from "@/components/FieldError.astro";
import { accountGreeting } from "@/data/account-navigation";
import {
  authBindingsForRequest,
  authenticatorFreshAge,
  createAuth,
  forwardCookies,
  readAccountSession,
} from "@/server/auth";
import {
  loadProfile,
  loadSubmittedApplication,
  loadFirstCompletedOrientation,
} from "@/server/db/profiles";
import { createDatabase } from "@/server/db";
import { volunteerStatus } from "@/server/db/schema";
import { eq } from "drizzle-orm";
import {
  applicationDisplayName,
  type ApplicationAnswers,
} from "@/data/application";
export const prerender = false;
let values: ApplicationAnswers | null = null;
let submission: Awaited<ReturnType<typeof loadSubmittedApplication>> = null;
let accountCreatedAt: Date | null = null;
let firstOrientationAt: Date | null = null;
const accountDate = new Intl.DateTimeFormat("en-CA", {
  timeZone: "America/Vancouver",
  dateStyle: "long",
});
let email = "";
let userId = "";
let currentId = "";
let twoFactorEnabled = false;
let organizer = false;
let applicationApproved = false;
let active = false;
let sessions: { id: string; userAgent?: string | null; updatedAt: Date }[] = [];
let sessionsNeedSignIn = false;
let emailNeedsSignIn = false;
let factorNeedsSignIn = false;
if (!env.BETTER_AUTH_SECRET) return Astro.redirect("/volunteer/sign-in");
try {
  const auth = createAuth(authBindingsForRequest(env, Astro.request));
  const { response: current, headers } = await readAccountSession(
    auth,
    Astro.request,
  );
  forwardCookies(headers, Astro.response.headers);
  if (!current)
    return Astro.redirect("/volunteer/sign-in?returnTo=/volunteer/account");
  values = await loadProfile(env.DB, current.user.id);
  if (!values) return Astro.redirect("/apply");
  submission = await loadSubmittedApplication(env.DB, current.user.id);
  accountCreatedAt = current.user.createdAt;
  firstOrientationAt = await loadFirstCompletedOrientation(
    env.DB,
    current.user.id,
  );
  email = current.user.email;
  userId = current.user.id;
  const { sessionConfig } = await auth.$context;
  emailNeedsSignIn =
    sessionConfig.freshAge !== 0 &&
    Date.now() - current.session.createdAt.getTime() >=
      sessionConfig.freshAge * 1000;
  currentId = current.session.id;
  factorNeedsSignIn =
    Date.now() - current.session.createdAt.getTime() >=
    authenticatorFreshAge * 1000;
  twoFactorEnabled = Boolean(current.user.twoFactorEnabled);
  organizer = current.user.role === "organizer";
  const status = await createDatabase(env.DB).query.volunteerStatus.findFirst({
    where: eq(volunteerStatus.user_id, current.user.id),
  });
  applicationApproved = status?.registration_approved ?? false;
  active = status?.active ?? false;
  try {
    const listed = await auth.api.listSessions({
      headers: Astro.request.headers,
      returnHeaders: true,
    });
    forwardCookies(listed.headers, Astro.response.headers);
    // Only display IDs and metadata, never session tokens.
    sessions = listed.response
      .slice(0, 100)
      .map(({ id, userAgent, updatedAt }) => ({
        id,
        userAgent,
        updatedAt,
      }));
  } catch (error) {
    if (
      !(error instanceof APIError) ||
      error.body?.code !== "SESSION_NOT_FRESH"
    )
      throw error;
    sessionsNeedSignIn = true;
  }
} catch {
  return new Response("Your account is temporarily unavailable.", {
    status: 503,
  });
}
---

<AccountLayout
  title="Your account"
  description="Edit your volunteer profile and manage your sessions."
  signedIn
  organizer={organizer}
  name={values ? applicationDisplayName(values) : undefined}
  greetingName={accountGreeting(values)}
  email={email}
>
  {
    !active ? (
      <p class="volunteer-notice" role="status">
        Your volunteer account is inactive. Contact an organizer to restore
        access.
      </p>
    ) : !applicationApproved && !organizer ? (
      <p class="volunteer-notice" role="status">
        Your application is awaiting organizer approval. You can update your
        profile while you wait. Events and orientation sign-ups will be
        available once approved.
      </p>
    ) : null
  }
  <section class="volunteer-panel">
    <h2>Your profile</h2>
    <div class="account-profile-summary mb-8">
      <dl>
        <div>
          <dt>Account created</dt>
          <dd>
            {
              accountCreatedAt ? (
                <time datetime={accountCreatedAt.toISOString()}>
                  {accountDate.format(accountCreatedAt)}
                </time>
              ) : (
                "Unavailable"
              )
            }
          </dd>
        </div>
        <div>
          <dt>First completed orientation</dt>
          <dd>
            {
              firstOrientationAt ? (
                <time datetime={firstOrientationAt.toISOString()}>
                  {accountDate.format(firstOrientationAt)}
                </time>
              ) : (
                "Not yet completed"
              )
            }
          </dd>
        </div>
      </dl>
    </div>
    <AccountProfileForm email={email} values={values} userId={userId} />
  </section>
  <SubmittedApplication submission={submission} />
  <section class="volunteer-panel">
    <h2>Account settings</h2>
    <AccountEmailSettings email={email} needsSignIn={emailNeedsSignIn} />
    <div class="volunteer-setting" data-factor-settings>
      <div>
        <h3 tabindex="-1">Two-factor authentication</h3>
        {
          twoFactorEnabled ? (
            <>
              <p role="status">
                Your authenticator is enabled. It is required each time you sign
                in.
              </p>
              <details class="mt-6">
                <summary>Remove or replace your authenticator</summary>
                <p class="mt-4">
                  To use a different app, first remove your current
                  authenticator, then set up and verify the new one. Two-factor
                  protection will be off in between, even if you leave setup
                  unfinished. Your old app and backup codes will stop working,
                  and other devices will be signed out. Keep your current app
                  until removal is confirmed.
                </p>
                <p class="mt-4">
                  You need a code from your current app to remove it. Backup
                  codes cannot authorize removal.
                </p>
                {factorNeedsSignIn ? (
                  <form
                    data-sign-out
                    action="/api/v1/auth/sign-out"
                    method="post"
                    class="mt-6"
                  >
                    <p>
                      Sign in again before removing your authenticator. A
                      sign-in within the last ten minutes is required.
                    </p>
                    <button class="btn btn-outline mt-4" type="submit">
                      Sign out to sign in again
                    </button>
                    <p data-form-message role="status" hidden />
                  </form>
                ) : (
                  <form
                    data-disable-factor
                    class="volunteer-form volunteer-small mt-6"
                    action="/api/v1/auth/two-factor/disable"
                    method="post"
                  >
                    <div class="volunteer-field">
                      <label for="factor-remove-code">
                        Current authenticator code{" "}
                        <span class="volunteer-required" aria-hidden="true">
                          *
                        </span>
                      </label>
                      <input
                        id="factor-remove-code"
                        name="code"
                        inputmode="numeric"
                        autocomplete="one-time-code"
                        pattern="[0-9]{6}"
                        maxlength="6"
                        aria-describedby="error-factor-remove-code"
                        required
                      />
                      <FieldError
                        field="factor-remove-code"
                        message="Enter a six-digit code from your current app."
                      />
                    </div>
                    <label class="volunteer-check">
                      <input name="confirm" type="checkbox" required />
                      <span>
                        I understand that two-factor protection will be off
                        until I verify a new authenticator.
                      </span>
                    </label>
                    <p
                      data-form-message
                      role="status"
                      aria-live="polite"
                      hidden
                    />
                    <button
                      class="btn btn-outline"
                      type="submit"
                      data-loading-label="Removing…"
                    >
                      Confirm and remove authenticator
                    </button>
                  </form>
                )}
              </details>
            </>
          ) : factorNeedsSignIn ? (
            <form
              data-sign-out
              action="/api/v1/auth/sign-out"
              method="post"
              class="mt-6"
            >
              <p>
                Sign in again to set up an authenticator. A sign-in within the
                last ten minutes is required.
              </p>
              <button class="btn btn-outline mt-4" type="submit">
                Sign out to sign in again
              </button>
              <p data-form-message role="status" hidden />
            </form>
          ) : (
            <>
              <p>
                Add an authenticator app for extra sign-in protection. This is
                optional for both volunteers and organizers.
              </p>
              <form
                data-enable-factor
                class="volunteer-form mt-6"
                action="/api/v1/auth/two-factor/enable"
                method="post"
              >
                <p data-form-message role="status" aria-live="polite" hidden />
                <button
                  class="btn btn-outline"
                  type="submit"
                  data-loading-label="Setting up…"
                >
                  Set up an authenticator
                </button>
              </form>
              <div data-factor-setup class="mt-8" hidden>
                <div data-factor-qr class="mb-6" hidden>
                  <p>Scan this QR code with your authenticator app:</p>
                  <img
                    data-factor-qr-image
                    class="mt-4 block h-auto max-w-full"
                    width="256"
                    height="256"
                    alt="QR code for authenticator setup"
                  />
                </div>
                <p data-factor-qr-error role="status" hidden>
                  The QR code could not be displayed. Use the setup key below
                  instead.
                </p>
                <p>You can enter this setup key manually:</p>
                <code data-factor-key class="break-all" />
                <p class="mt-6">
                  Save these one-use backup codes somewhere safe:
                </p>
                <pre data-backup-codes class="mt-4" />
                <form
                  data-confirm-factor
                  class="volunteer-form volunteer-small mt-8"
                  action="/api/v1/auth/two-factor/verify-totp"
                  method="post"
                >
                  <div class="volunteer-field">
                    <label for="factor-setup-code">
                      Authenticator code{" "}
                      <span class="volunteer-required" aria-hidden="true">
                        *
                      </span>
                    </label>
                    <input
                      id="factor-setup-code"
                      name="code"
                      aria-describedby="error-factor-setup-code"
                      inputmode="numeric"
                      autocomplete="one-time-code"
                      pattern="[0-9]{6}"
                      maxlength="6"
                      required
                    />
                    <FieldError
                      field="factor-setup-code"
                      message="Enter a six-digit code."
                    />
                  </div>
                  <p
                    data-form-message
                    role="status"
                    aria-live="polite"
                    hidden
                  />
                  <button
                    class="btn btn-primary"
                    type="submit"
                    data-loading-label="Verifying…"
                  >
                    Verify and enable
                  </button>
                </form>
              </div>
            </>
          )
        }
      </div>
    </div>
    <div class="volunteer-setting" data-account-sessions>
      <div class="w-full">
        <h3 tabindex="-1">Sessions</h3>
        {
          sessionsNeedSignIn && (
            <form
              data-sign-out
              action="/api/v1/auth/sign-out"
              method="post"
              class="mt-6"
            >
              <p>Sign in again to view and manage your active sessions.</p>
              <button class="btn btn-outline mt-4" type="submit">
                Sign out to sign in again
              </button>
              <p data-form-message role="status" hidden />
            </form>
          )
        }
        <ul class="account-sessions mt-6">
          {
            sessions.map((entry) => (
              <li data-session-row>
                <div>
                  <span>
                    {entry.id === currentId
                      ? "This device"
                      : entry.userAgent || "Another device"}
                  </span>
                  <span class="volunteer-help">
                    Last active:{" "}
                    {entry.updatedAt.toLocaleString("en-CA", {
                      timeZone: "America/Vancouver",
                    })}
                  </span>
                </div>
                {entry.id !== currentId && (
                  <form
                    data-end-session
                    action="/api/v1/account/session"
                    method="post"
                  >
                    <input type="hidden" name="id" value={entry.id} />
                    <button
                      class="btn btn-outline"
                      type="submit"
                      data-loading-label="Ending session…"
                    >
                      End session
                    </button>
                    <p data-form-message role="status" hidden />
                  </form>
                )}
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>
</AccountLayout>
