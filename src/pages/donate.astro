---
import { Check, CircleAlert, Copy, ExternalLink } from "@lucide/astro";
import { Image } from "astro:assets";
import Layout from "@/layouts/Layout.astro";
import donateTeam from "@/assets/donate-team.jpg";
import { gofundmeUrl } from "@/data/site";
import { env } from "cloudflare:workers";
import { loadAccountNavigation } from "@/server/account-navigation";
export const prerender = false;
const account = await loadAccountNavigation(
  env,
  Astro.request,
  Astro.response.headers,
);

const equipmentNeeds = [
  {
    name: "Full aluminum D oxygen cylinder",
    description: "A portable 425 L oxygen supply for emergency response.",
    price: "$190.00",
    unit: "each",
    url: "https://pacificfirstaid.ca/products/oxygen-tank-aluminum-d-cylinder-15-0-cu-ft-425l-with-toggle-valve",
    image:
      "https://cdn.shopify.com/s/files/1/0757/3654/7609/files/Screenshot2025-09-16162413.png?v=1758065075&width=180&quality=80",
  },
  {
    name: "Adult bag-valve mask",
    description: "Manual ventilation equipment for respiratory emergencies.",
    price: "$29.95",
    unit: "each",
    url: "https://pacificfirstaid.ca/products/bag-valve-mask-adult",
    image:
      "https://cdn.shopify.com/s/files/1/0757/3654/7609/files/Med-Rescuer.png?v=1730765369&width=180&quality=80",
  },
  {
    name: "Assorted sterile gauze pads",
    description: "A 100-pack for cleaning, covering, and dressing wounds.",
    price: "$12.95",
    unit: "per pack",
    url: "https://pacificfirstaid.ca/products/sterile-gauze-pad-100-assorted",
    image:
      "https://cdn.shopify.com/s/files/1/0757/3654/7609/files/100ASTPads1.png?v=1734032678&width=180&quality=80",
  },
  {
    name: "Oropharyngeal airway set",
    description:
      "Eight colour-coded Guedel airways in neonatal to adult sizes.",
    price: "$11.95",
    unit: "per set",
    url: "https://pacificfirstaid.ca/products/oral-airway-set",
    image:
      "https://cdn.shopify.com/s/files/1/0757/3654/7609/files/PFA-OAK.png?v=1752601748&width=180&quality=80",
  },
  {
    name: "Adhesive bandages",
    description: "A 30-count assorted pack for minor cuts and scrapes.",
    price: "$7.99",
    unit: "per box",
    url: "https://pacificfirstaid.ca/products/band-aid%C2%AE-brand-flexible-fabric-adhesive-bandages",
    image:
      "https://cdn.shopify.com/s/files/1/0757/3654/7609/files/81tsrk9kp7L._AC_SX425.jpg?v=1717801370&width=180&quality=80",
  },
  {
    name: "Adult oxygen mask with tubing",
    description:
      "A disposable partial non-rebreathing mask for oxygen delivery.",
    price: "$4.35",
    unit: "each",
    url: "https://pacificfirstaid.ca/products/partial-non-rebreathing-oxygen-mask-with-tubing-adult",
    image:
      "https://cdn.shopify.com/s/files/1/0757/3654/7609/products/partial_non_-_rebreathing_oxygen_mask_with_tubing_-_adult.jpg?v=1683401429&width=180&quality=80",
  },
];
---

<Layout
  account={account}
  title="Donate | After Hours Outreach Initiative"
  description="Donate to After Hours Outreach Initiative and put supplies and emergency response gear in the hands of volunteers doing evening outreach in Vancouver's Downtown Eastside."
>
  <section class="bg-black text-white" id="donate">
    <div class="mx-auto grid w-full max-w-site items-center gap-14 px-6 pt-24 max-sm:px-4 max-sm:pt-18 lg:grid-cols-[minmax(0,1fr)_26.25rem] lg:gap-20">
      <div class="min-w-0">
        <h1>
          <span class="text-blue">Donate</span>
        </h1>
        <p class="mt-8 max-w-xl text-zinc-300">
          We are a community-run society, and we rely on community support to
          provide outreach. Donations pay for medical equipment like oxygen
          tanks and wound care supplies, hygiene and feminine products, and the
          food, sleeping mats, and emergency blankets we hand out on patrol.
          They also cover the wagons we use to carry everything.
        </p>
        <div class="mt-9 flex flex-wrap gap-3.5 max-sm:flex-col">
          <a
            class="btn btn-primary"
            href={gofundmeUrl}
            target="_blank"
            rel="noreferrer"
          >
            {/* lucide: external-link */}
            <ExternalLink
              size="1em"
              aria-hidden="true"
              class="lucide btn-icon"
            />
            Donate on GoFundMe
          </a>
        </div>
        <div class="mt-6 text-zinc-300">
          <p>You can also donate by e-Transfer to:</p>
          <div class="mt-3 flex w-full max-w-full flex-col gap-2 rounded-lg bg-panel-soft p-2 sm:w-fit">
            <p
              class="w-full min-w-0 overflow-x-auto px-2 py-1 whitespace-pre [scrollbar-width:thin]"
              tabindex="0"
              role="region"
              aria-label="e-Transfer email address"
            >
              <span data-etransfer-email>finance@afterhoursoutreach.ca</span>
            </p>
            <button
              type="button"
              class="btn btn-primary min-h-8 w-full text-sm"
              data-copy-etransfer-email
              aria-label="Copy e-Transfer email address"
              aria-live="polite"
            >
              <span class="grid">
                <span
                  class="etransfer-copy-state"
                  data-etransfer-copy-state="copy"
                  aria-hidden="false"
                >
                  {/* lucide: copy */}
                  <Copy
                    size="1em"
                    aria-hidden="true"
                    class="lucide btn-icon"
                    data-etransfer-copy-icon="copy"
                  />
                  <span data-etransfer-copy-label>Copy</span>
                </span>
                <span
                  class="etransfer-copy-state"
                  data-etransfer-copy-state="copied"
                  aria-hidden="true"
                >
                  {/* lucide: check */}
                  <Check
                    size="1em"
                    aria-hidden="true"
                    class="lucide btn-icon text-green-300"
                    data-etransfer-copy-icon="copied"
                  />
                  <span data-etransfer-copy-label>Copied</span>
                </span>
                <span
                  class="etransfer-copy-state"
                  data-etransfer-copy-state="error"
                  aria-hidden="true"
                >
                  {/* lucide: circle-alert */}
                  <CircleAlert
                    size="1em"
                    aria-hidden="true"
                    class="lucide btn-icon text-red-300"
                    data-etransfer-copy-icon="error"
                  />
                  <span class="text-red-300" data-etransfer-copy-label>
                    Error
                  </span>
                </span>
              </span>
            </button>
          </div>
        </div>
      </div>

      <div class="relative flex items-center justify-center max-lg:order-first">
        <Image
          class="w-full max-w-[26.25rem] rounded-2xl object-cover"
          src={donateTeam}
          alt="Nine volunteers from After Hours Outreach Initiative with supply bags, standing and sitting in front of a graffiti mural at night in the Downtown Eastside."
          widths={[420, 840]}
          sizes="(max-width: 480px) 100vw, 420px"
          loading="eager"
        />
      </div>
    </div>

    <div class="mx-auto w-full max-w-site px-6 pt-20 pb-24 max-sm:px-4 max-sm:pt-14 max-sm:pb-18">
      <h2 class="max-w-3xl">Where the money goes</h2>

      <a
        class="group mt-5 block border border-blue bg-blue/10 p-6 transition-colors hover:bg-blue/15 sm:p-8"
        href="https://coastalreign.com/products/safety-vests/big-k-first-aid-safety-vest?selectedColour=Royal%20Blue"
        target="_blank"
        rel="noreferrer"
      >
        <div class="grid grid-cols-[6.5rem_minmax(0,1fr)] items-start gap-5 sm:grid-cols-[9rem_minmax(0,1fr)] sm:gap-8">
          <div class="aspect-square overflow-hidden bg-white p-2 sm:p-3">
            <img
              class="size-full object-contain"
              src="https://cdn.shopify.com/s/files/1/1016/5405/files/1013591.jpg?v=1758155758&width=240&quality=80"
              alt=""
              width="240"
              height="240"
              loading="lazy"
              decoding="async"
            />
          </div>
          <div class="flex items-end justify-between gap-8 max-sm:flex-col max-sm:items-start max-sm:gap-4">
            <div>
              <h3>High-visibility first aid vest</h3>
              <p class="mt-3 max-w-lg text-zinc-300">
                Durable, reflective vests help identify outreach responders and
                keep essential supplies within reach on evening shifts.
              </p>
              <span class="mt-5 inline-block border-b border-zinc-500 pb-0.5 text-sm font-bold group-hover:border-white">
                View reference item
              </span>
            </div>
            <strong class="shrink-0 font-heading text-4xl leading-none font-bold text-blue md:text-5xl">
              $129.99
            </strong>
          </div>
        </div>
      </a>

      <div class="mt-5 border border-zinc-700 bg-ink">
        {equipmentNeeds.map((item) => (
          <a
            class="group grid grid-cols-[5.5rem_minmax(0,1fr)] items-center gap-x-5 gap-y-2 border-b border-zinc-800 p-5 last:border-b-0 hover:bg-panel-soft sm:grid-cols-[6.5rem_minmax(0,1fr)_auto] sm:gap-x-6 sm:p-6"
            href={item.url}
            target="_blank"
            rel="noreferrer"
          >
            <span class="aspect-square overflow-hidden bg-white p-2">
              <img
                class="size-full object-contain"
                src={item.image}
                alt=""
                width="180"
                height="180"
                loading="lazy"
                decoding="async"
              />
            </span>
            <span>
              <strong class="block text-xl leading-snug">{item.name}</strong>
              <span class="mt-1 block text-sm leading-6 text-zinc-400">
                {item.description}
              </span>
            </span>
            <span class="col-start-2 flex items-baseline gap-2 sm:col-start-auto sm:flex-col sm:items-end sm:gap-0">
              <strong class="text-xl text-white">{item.price}</strong>
              <span class="text-xs text-zinc-500">{item.unit}</span>
            </span>
          </a>
        ))}
      </div>

      <p class="mt-5 text-sm text-zinc-400">
        Reference prices are in CAD and were checked in August 2026. Tax,
        shipping, oxygen handling, customization, and future price changes are
        not included. Medical-response equipment is for use by team members with
        appropriate training.
      </p>
    </div>
  </section>
</Layout>

<style>
  .etransfer-copy-state {
    grid-area: 1 / 1;
    display: inline-flex;
    align-items: center;
    justify-content: flex-start;
    gap: 0.625rem;
    visibility: hidden;
    opacity: 0;
    transition:
      opacity 160ms ease,
      visibility 160ms;
  }

  .etransfer-copy-state[aria-hidden="false"] {
    visibility: visible;
    opacity: 1;
  }

  @media (prefers-reduced-motion: reduce) {
    .etransfer-copy-state {
      transition: none;
    }
  }
</style>

<script>
  const email = document
    .querySelector<HTMLElement>("[data-etransfer-email]")
    ?.textContent?.trim();
  const copyButton = document.querySelector<HTMLButtonElement>(
    "[data-copy-etransfer-email]",
  );

  if (email && copyButton) {
    const copyPanels = copyButton.querySelectorAll<HTMLElement>(
      "[data-etransfer-copy-state]",
    );
    const copyDescriptions = {
      copy: "Copy e-Transfer email address",
      copied: "e-Transfer email address copied",
      error: "Could not copy e-Transfer email address. Try again.",
    };
    let resetTimer: number | undefined;
    let copyAttempt = 0;

    const setCopyState = (state: keyof typeof copyDescriptions) => {
      window.clearTimeout(resetTimer);
      resetTimer = undefined;
      copyButton.setAttribute("aria-label", copyDescriptions[state]);
      for (const panel of copyPanels) {
        panel.setAttribute(
          "aria-hidden",
          String(panel.dataset.etransferCopyState !== state),
        );
      }
      if (state !== "copy") {
        resetTimer = window.setTimeout(() => setCopyState("copy"), 3000);
      }
    };

    copyButton.addEventListener("click", async () => {
      const attempt = ++copyAttempt;
      window.clearTimeout(resetTimer);
      resetTimer = undefined;
      try {
        await navigator.clipboard.writeText(email);
        if (attempt === copyAttempt) setCopyState("copied");
      } catch {
        if (attempt === copyAttempt) setCopyState("error");
      }
    });
  }
</script>
