---
// Organizers' changes that email people wait here so they can be undone.
// Imported here, not only by the script, so every page's head carries the
// styles: a page swap drops styles the next page does not declare, and the
// script does not run again to add them back.
import "@/styles/pending-actions.css";
---

<!-- Persisted as one, so page swaps keep the backdrop and spacer beside the
     toasts, not just the toasts. -->
<div style="display: contents" transition:persist="pending-actions">
  <!-- Dims the page while the toasts are open. -->
  <div class="pending-backdrop" aria-hidden="true" data-pending-backdrop></div>
  <div class="pending-actions" data-pending-actions></div>
  <!-- Room under the page so toasts never hide its end. -->
  <div aria-hidden="true" data-pending-spacer></div>
</div>

<script>
  import "@/scripts/pending-actions";
</script>
