---
import { env } from "cloudflare:workers";
import { safeReturnTo } from "@/server/http";
import SecondFactorForm from "./SecondFactorForm.astro";
import FieldError from "@/components/FieldError.astro";
interface Props {
  returnTo?: string;
}
const returnTo = safeReturnTo(Astro.props.returnTo);
const localTesting = Boolean(import.meta.env.DEV);
const ready = Boolean(
  env.BETTER_AUTH_SECRET && (localTesting || env.RESEND_API_KEY),
);
---

<section class="volunteer-panel volunteer-signin-panel" id="volunteer-signin">
  <h2>Sign in or create an account</h2>
  <p>Please sign in to sign up for volunteer events.</p>
  {
    !ready && (
      <p class="volunteer-notice" role="status">
        Sign-in is not configured yet. Please check back later.
      </p>
    )
  }
  <form
    data-email-request
    data-return-to={returnTo}
    class="volunteer-form"
    action="/api/auth/email-otp/send-verification-otp"
    method="post"
  >
    <div class="volunteer-field">
      <label for="sign-in-email">Email</label>
      <input
        id="sign-in-email"
        name="email"
        type="email"
        autocomplete="email"
        placeholder="you@example.com"
        maxlength="254"
        aria-describedby="error-email"
        required
        disabled={!ready}
      />
      <FieldError field="email" message="Enter a valid email address." />
    </div>
    <p data-form-message role="status" aria-live="polite" hidden></p>
    <button
      type="submit"
      class="btn btn-primary"
      data-loading-label="Sending email…"
      disabled={!ready}>Continue with Email</button
    >
  </form>
  <form
    data-email-code
    class="volunteer-form"
    action="/api/auth/sign-in/email-otp"
    method="post"
    hidden
  >
    <p>
      Check your email, then open the link or enter the six-digit code below.
    </p>
    <input name="email" type="hidden" />
    <div class="volunteer-field">
      <label for="sign-in-code">
        Six-digit code <span class="volunteer-required" aria-hidden="true"
          >*</span
        >
      </label>
      <input
        id="sign-in-code"
        name="code"
        aria-describedby="error-email-code"
        inputmode="numeric"
        autocomplete="one-time-code"
        pattern="[0-9]{6}"
        maxlength="6"
        required
      />
      <FieldError field="email-code" message="Enter a six-digit code." />
    </div>
    <p data-form-message role="status" aria-live="polite" hidden></p>
    <button type="submit" class="btn btn-primary">Sign in with code</button>
  </form>
  <SecondFactorForm />
  <a
    href="/volunteer/sign-in"
    class="volunteer-email-reset"
    data-use-different-email
    hidden>Use a different email</a
  >
  <noscript><p>JavaScript is required to sign in.</p></noscript>
</section>
