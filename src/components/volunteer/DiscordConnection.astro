---
import { env } from "cloudflare:workers";
import { loadDiscordStatus } from "@/server/discord/status";
import DiscordIcon from "@/components/icons/DiscordIcon.astro";
interface Props {
  userId: string;
  canConnect?: boolean;
  required?: boolean;
}
const { userId, canConnect = true, required = false } = Astro.props;
const status = import.meta.env.DEV
  ? await (
      await import("@/dev/server/discord")
    ).loadLocalDiscordStatus(env, userId)
  : await loadDiscordStatus(env, userId);
const result = Astro.url.searchParams.get("discord");
---

<div
  class="min-w-0 wrap-anywhere"
  data-discord-connection
  data-discord-user={userId}
>
  <p>
    {
      !status.configured
        ? "Discord connection is coming soon."
        : required
          ? "Connect Discord to access our volunteer channels once you’re approved."
          : "Connect Discord to keep your volunteer channel access up to date. This is optional."
    }
  </p>
  {
    result && (
      <p class="volunteer-notice" role="status">
        {result === "connected"
          ? "Discord linked. Checking membership and volunteer access."
          : result}
      </p>
    )
  }
  <p class="mt-4" data-discord-identity hidden={!status.username}>
    {status.username ? `Connected as ${status.username}.` : ""}
  </p>
  <p
    class="mt-4"
    data-discord-status
    role="status"
    hidden={!status.configured || !status.username}
  >
    {
      status.username
        ? `${status.connection.replace(/\.$/, "")}. ${status.sync.replace(/\.$/, "")}.`
        : ""
    }
  </p>
  {
    status.configured && canConnect && (
      <form class="volunteer-form mt-4" data-discord-connect>
        <label class="volunteer-check">
          <>
            <input type="checkbox" name="consent" required />
            <span>
              I agree to link my Discord account, join the After Hours Outreach
              server, and keep my volunteer channel access up to date.{" "}
              <a href="/privacy">Privacy policy</a>.
            </span>
          </>
        </label>
        <p data-discord-message role="status" hidden />
        <button class="btn btn-primary mt-4" type="submit">
          <DiscordIcon class="btn-icon fill-current" />
          {status.username ? "Reconnect Discord" : "Connect Discord"}
        </button>
      </form>
    )
  }
  <button
    type="button"
    class="btn btn-outline mt-4"
    data-discord-refresh
    hidden={!status.configured || !status.username}>Refresh status</button
  >
</div>
<script src="../../scripts/discord.ts"></script>
