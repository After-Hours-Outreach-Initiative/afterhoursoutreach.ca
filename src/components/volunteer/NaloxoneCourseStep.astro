---
import ArrowUpRightIcon from "@/components/icons/ArrowUpRightIcon.astro";

interface Props {
  userId: string;
  completedAt: number | null;
  canConfirm: boolean;
}
const { userId, completedAt, canConfirm } = Astro.props;
---

<section class="volunteer-panel" aria-label="Naloxone 101" data-naloxone-step>
  <p class="text-base">
    Naloxone 101 is an online course that teaches you how to recognize and
    respond to an opioid overdose, and how to administer naloxone. It takes
    about 1 hour to complete
  </p>
  <a
    class="btn btn-outline mt-6"
    href="https://towardtheheart.com/naloxone-course"
    target="_blank"
    rel="noreferrer"
  >
    Take Naloxone 101
    <ArrowUpRightIcon class="btn-icon" />
    <span class="sr-only">(opens in a new tab)</span>
  </a>
  {
    canConfirm && (
      <form
        class="volunteer-form mt-6"
        data-naloxone-confirm
        data-naloxone-user-id={userId}
        action="/api/v1/account/naloxone"
        method="post"
      >
        <label class="volunteer-check">
          <input
            type="checkbox"
            name="completed"
            value="true"
            required
            checked={completedAt !== null}
            disabled={completedAt !== null}
          />
          <span>I confirm I have completed Naloxone 101.</span>
        </label>
        <p
          class="text-base"
          data-form-message
          role="status"
          aria-live="polite"
          hidden={completedAt === null}
        >
          Completion saved to your account.
        </p>
        <button
          class="btn btn-primary"
          type="submit"
          data-loading-label="Saving…"
          hidden={completedAt !== null}
        >
          Confirm completion
        </button>
      </form>
    )
  }
</section>

<style>
  .volunteer-panel > p {
    margin: 0;
  }
</style>
