---
interface Props {
  userId: string;
  completedAt: number | null;
  idPrefix: string;
}
const { userId, completedAt, idPrefix } = Astro.props;
---

<div
  id={idPrefix}
  class="naloxone-course-row"
  data-contents-section
  data-naloxone-step
>
  <p data-naloxone-status role="status" aria-live="polite">
    {
      completedAt === null
        ? "Naloxone 101: Not confirmed"
        : "Naloxone 101 completed."
    }
  </p>
  {
    completedAt === null && (
      <>
        <a
          class="text-indigo-300 underline underline-offset-4"
          href="https://towardtheheart.com/naloxone-course"
          target="_blank"
          rel="noreferrer"
        >
          Take Naloxone 101
          <span class="sr-only">(opens in a new tab)</span>
        </a>
        <form
          data-naloxone-confirm
          data-naloxone-user-id={userId}
          action="/api/v1/account/naloxone"
          method="post"
        >
          <label class="volunteer-check">
            <input type="checkbox" name="completed" value="true" required />
            <span>I confirm I have completed Naloxone 101.</span>
          </label>
          <button
            class="btn btn-outline"
            type="submit"
            data-loading-label="Saving…"
          >
            Confirm completion
          </button>
          <p data-form-message role="status" aria-live="polite" hidden />
        </form>
      </>
    )
  }
</div>

<style>
  .naloxone-course-row,
  form {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1rem;
  }
  .naloxone-course-row {
    margin-top: 1.5rem;
  }
  [data-form-message] {
    flex-basis: 100%;
  }
</style>
