---
import ChevronDownIcon from "@/components/icons/ChevronDownIcon.astro";
import SearchIcon from "@/components/icons/SearchIcon.astro";
import "@/styles/filter-menu.css";

export interface FilterMenuOption {
  value: string;
  label: string;
  /** Shown beside the option and kept current by the page's script. */
  count?: number;
  /** Extra attributes for the count, such as a stable hook for its value. */
  countAttributes?: Record<string, string>;
}
interface Props {
  /** Checkbox name; each checked option submits one value. */
  name: string;
  label: string;
  groups: { label?: string; options: FilterMenuOption[] }[];
  selected: readonly string[];
  search?: boolean;
  idPrefix: string;
}
const { name, label, groups, selected, search = false, idPrefix } = Astro.props;
const id = `${idPrefix}-${name}`;
---

<button
  class="volunteer-filter filter-menu-trigger"
  type="button"
  id={`${id}-trigger`}
  popovertarget={id}
  aria-expanded="false"
  data-filter-trigger={name}
  data-active={selected.length ? "" : undefined}
>
  {label}
  <span
    class="volunteer-filter-count"
    data-filter-selected
    hidden={!selected.length}
  >
    {selected.length}
    <span class="sr-only"> selected</span>
  </span>
  <ChevronDownIcon class="filter-menu-chevron" />
</button>
<div
  class="filter-menu"
  id={id}
  popover="auto"
  role="group"
  aria-labelledby={`${id}-trigger`}
  data-filter-menu={name}
>
  {search && (
    <label class="volunteer-search-field filter-menu-search">
      <span class="sr-only">Search {label.toLowerCase()}</span>
      <input
        type="search"
        placeholder="Search"
        autocomplete="off"
        data-filter-search
      />
      <SearchIcon class="volunteer-search-icon" />
    </label>
  )}
  <div class="filter-menu-options">
    {groups.map((group) => (
      <div class="filter-menu-group">
        {group.label && <p class="filter-menu-group-label">{group.label}</p>}
        {group.options.map((option) => (
          <label class="volunteer-check" data-filter-option>
            <input
              type="checkbox"
              name={name}
              value={option.value}
              checked={selected.includes(option.value)}
            />
            <span class="filter-menu-option-label">{option.label}</span>
            {option.count !== undefined && (
              <span
                class="filter-menu-option-count"
                data-filter-count={option.value}
                {...option.countAttributes}
              >
                {option.count}
              </span>
            )}
          </label>
        ))}
      </div>
    ))}
    <p class="filter-menu-empty" data-filter-empty hidden>
      No matches.
    </p>
  </div>
  <div class="filter-menu-actions">
    <button class="btn btn-quiet" type="button" data-filter-clear>
      Clear
    </button>
    <button class="btn btn-primary" type="submit" data-filter-apply>
      Apply
    </button>
  </div>
</div>
