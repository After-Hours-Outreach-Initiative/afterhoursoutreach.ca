---
import DialogHeader from "@/components/DialogHeader.astro";
import FieldError from "@/components/FieldError.astro";
import FieldGroup from "./FieldGroup.astro";
import StepperField from "./StepperField.astro";
import RecurringIcon from "@/components/icons/RecurringIcon.astro";
import CloseIcon from "@/components/icons/CloseIcon.svg";
import { maxUnregisterMinutes } from "@/data/event-unregistration";
---

<div
  class="volunteer-bulk-bar"
  data-bulk-actions
  role="group"
  aria-label="Selected events"
  hidden
>
  <div class="volunteer-bulk-heading">
    <p data-bulk-count role="status" aria-live="polite" aria-atomic="true">
      0 selected
    </p>
    <button
      class="btn btn-quiet volunteer-bulk-close"
      type="button"
      data-bulk-exit
      aria-label="Exit selection mode"
    >
      <CloseIcon />
    </button>
  </div>
  <div class="volunteer-bulk-buttons">
    <button class="btn btn-quiet" type="button" data-bulk-select-all>
      Select all
    </button>
    <button class="btn btn-quiet" type="button" data-bulk-clear disabled>
      Clear
    </button>
    <button
      class="btn btn-primary"
      type="button"
      data-bulk-open
      aria-haspopup="dialog"
      aria-controls="bulk-event-editor"
      disabled
    >
      Bulk edit
    </button>
  </div>
</div>
<dialog
  id="bulk-event-editor"
  class="dialog-pop dialog-frame volunteer-dialog"
  aria-labelledby="bulk-event-heading"
>
  <DialogHeader id="bulk-event-heading" title="Bulk edit events" />
  <div class="dialog-body">
    <p class="volunteer-bulk-summary" data-bulk-summary></p>
    <ul class="volunteer-bulk-targets" data-bulk-targets></ul>
    <template data-bulk-target-template>
      <li class="volunteer-bulk-target">
        <span class="volunteer-bulk-target-when">
          <span data-day></span>
          <span data-time></span>
          <span class="volunteer-bulk-target-recurring" data-recurring>
            <RecurringIcon />
            <span class="sr-only">Recurring</span>
          </span>
        </span>
        <span class="volunteer-bulk-target-place" data-place></span>
      </li>
    </template>
    <form
      id="bulk-event-save"
      class="volunteer-form"
      data-bulk-event-save
      data-email-prompt="bulk"
      action="/api/v1/events/action"
      method="post"
    >
      <input type="hidden" name="selection" />
      <input type="hidden" name="initial" />
      <div class="volunteer-fields">
        <FieldGroup id="bulk-type-time-group" heading="Type and time">
          <fieldset class="volunteer-radio-field volunteer-wide">
            <legend>Event type</legend>
            <div class="volunteer-radio-group">
              {(
                [
                  ["true", "Orientation + Patrol"],
                  ["false", "Patrol"],
                ] as const
              ).map(([value, text]) => (
                <label class="volunteer-check">
                  <input
                    type="radio"
                    name="includesOrientation"
                    value={value}
                  />
                  <span>{text}</span>
                </label>
              ))}
            </div>
            <p class="volunteer-help volunteer-bulk-mixed">
              Varies across the selected events.
            </p>
          </fieldset>
          <div class="volunteer-field">
            <label for="bulk-startTime">Start time</label>
            <input
              id="bulk-startTime"
              name="startTime"
              type="time"
              step="60"
              aria-describedby="bulk-startTime-help error-bulk-startTime"
            />
            <p
              id="bulk-startTime-help"
              class="volunteer-help"
              data-bulk-time-help
            >
              Each event keeps its date.
            </p>
            <FieldError field="bulk-startTime" message="Enter a valid time." />
          </div>
        </FieldGroup>
        <FieldGroup id="bulk-location-group" heading="Location">
          <div class="volunteer-field">
            <label for="bulk-meetingPoint">Meeting point</label>
            <input
              id="bulk-meetingPoint"
              name="meetingPoint"
              maxlength="500"
              pattern={String.raw`.*\S.*`}
              aria-describedby="error-bulk-meetingPoint"
            />
            <FieldError
              field="bulk-meetingPoint"
              message="Enter a meeting point (up to 500 characters)."
            />
          </div>
          <div class="volunteer-field">
            <label for="bulk-meetingPointUrl">Map link (optional)</label>
            <input
              id="bulk-meetingPointUrl"
              name="meetingPointUrl"
              type="url"
              maxlength="2048"
              pattern="https://.*"
              aria-describedby="error-bulk-meetingPointUrl"
            />
            <FieldError
              field="bulk-meetingPointUrl"
              message="Enter a valid HTTPS map link."
            />
          </div>
        </FieldGroup>
        <FieldGroup
          id="bulk-spots-group"
          heading="Spots"
          descriptionId="bulk-capacity-help"
          description="Capacity and limits must fit each event's registrations. If any event conflicts, nothing is saved."
        >
          <StepperField
            id="bulk-spots"
            name="spots"
            label="Volunteer spots"
            help="Total places, including the reserved ones below."
            describedBy="bulk-capacity-help"
            min="1"
            max="100"
            error="Enter a whole number from 1 to 100, covering the event's reserved places."
            waitForScript={false}
            primary
          />
          <div
            class="volunteer-spot-limits volunteer-wide"
            role="group"
            aria-labelledby="bulk-spot-limits"
          >
            <p id="bulk-spot-limits" class="volunteer-spot-limits-label">
              Reserved places and limits
            </p>
            {(
              [
                [
                  "minMedicSpots",
                  "Minimum medic spots",
                  "Held for approved medics.",
                ],
                [
                  "minNewVolunteerSpots",
                  "Minimum new volunteer spots",
                  "Held for new volunteers when orientation is included.",
                ],
                [
                  "maxNewVolunteers",
                  "Maximum new volunteers",
                  "Cap on new volunteers when orientation is included.",
                ],
              ] as const
            ).map(([name, label, help]) => (
              <StepperField
                id={`bulk-${name}`}
                name={name}
                label={label}
                help={help}
                describedBy="bulk-capacity-help"
                min="0"
                max="100"
                error="Enter a whole number from 0 to 100."
                waitForScript={false}
              />
            ))}
          </div>
        </FieldGroup>
        <FieldGroup id="bulk-registration-group" heading="Registration">
          <div class="volunteer-field">
            <label for="bulk-unregisterMinutes">
              Unregister until (minutes after start)
            </label>
            <input
              id="bulk-unregisterMinutes"
              name="unregisterMinutes"
              type="number"
              min="0"
              max={maxUnregisterMinutes}
              step="1"
              aria-describedby="error-bulk-unregisterMinutes"
            />
            <FieldError
              field="bulk-unregisterMinutes"
              message={`Enter a whole number from 0 to ${maxUnregisterMinutes}.`}
            />
          </div>
          <fieldset class="volunteer-state-field volunteer-wide">
            <legend>Public visibility</legend>
            <div class="volunteer-state-selector">
              {(
                [
                  ["true", "Visible", "positive"],
                  ["false", "Hidden", "negative"],
                ] as const
              ).map(([value, text, tone]) => (
                <label class={`volunteer-state-option volunteer-state-${tone}`}>
                  <input
                    class="sr-only"
                    type="radio"
                    name="publicVisibility"
                    value={value}
                  />
                  <span>{text}</span>
                </label>
              ))}
            </div>
            <p class="volunteer-help volunteer-bulk-mixed">
              Varies across the selected events.
            </p>
          </fieldset>
        </FieldGroup>
      </div>
      <p data-bulk-stale role="alert" hidden>
        The selection changed while this dialog was open. Close it, review the
        events and select again before saving.
      </p>
      <p data-form-message role="status" hidden></p>
    </form>
  </div>
  <div class="dialog-footer">
    <button class="btn btn-quiet" type="button" data-dismiss-dialog>
      Cancel
    </button>
    <button
      class="btn btn-primary"
      type="submit"
      form="bulk-event-save"
      data-loading-label="Saving…"
      disabled
    >
      Save selected events
    </button>
  </div>
</dialog>

<style>
  fieldset:has(input:checked) > .volunteer-bulk-mixed {
    display: none;
  }

  .volunteer-bulk-bar {
    position: fixed;
    z-index: 40;
    bottom: max(1rem, env(safe-area-inset-bottom));
    left: 50%;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem 1.25rem;
    width: min(42rem, calc(100% - 2rem));
    padding: 0.75rem 0.75rem 0.75rem 1.25rem;
    border: 1px solid #52525b;
    border-radius: 0.75rem;
    background: var(--color-panel-soft);
    box-shadow: 0 0.75rem 2rem #000000b3;
    translate: -50% 0;
  }
  [data-bulk-count] {
    color: #e4e4e7;
    font-variant-numeric: tabular-nums;
  }
  .volunteer-bulk-heading {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    width: 100%;
  }
  .volunteer-bulk-close {
    width: 2.5rem;
    min-height: 2.5rem;
    padding: 0;
    flex-shrink: 0;
  }
  .volunteer-bulk-close :global(svg) {
    width: 1.25rem;
    height: 1.25rem;
  }
  .volunteer-bulk-buttons {
    display: flex;
    justify-content: flex-end;
    width: 100%;
    gap: 0.5rem;
  }
  @media (max-width: 40rem) {
    .volunteer-bulk-bar {
      padding: 0.75rem;
    }
    .volunteer-bulk-buttons {
      width: 100%;
    }
    .volunteer-bulk-buttons > .btn {
      flex: 1 1 0;
      min-width: 0;
      padding-inline: 0.75rem;
    }
  }
  .volunteer-bulk-summary {
    margin-bottom: 0.75rem;
    color: #d4d4d8;
  }
  .volunteer-bulk-targets {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(10.5rem, 1fr));
    gap: 0.5rem;
    max-height: 11.5rem;
    margin-bottom: 1.5rem;
    overflow-y: auto;
    overscroll-behavior: contain;
  }
  .volunteer-bulk-target {
    display: flex;
    flex-direction: column;
    gap: 0.125rem;
    min-width: 0;
    padding: 0.5rem 0.75rem;
    border: 1px solid #3f3f46;
    border-radius: 0.5rem;
    background: var(--color-panel-soft);
    font-size: 0.875rem;
    line-height: 1.35;
  }
  .volunteer-bulk-target-when {
    display: flex;
    align-items: center;
    gap: 0.375rem;
    color: #f4f4f5;
    font-weight: 500;
  }
  .volunteer-bulk-target-recurring {
    display: flex;
    margin-left: auto;
    color: #a1a1aa;
  }
  .volunteer-bulk-target-recurring :global(svg) {
    width: 1em;
    height: 1em;
  }
  .volunteer-bulk-target-place {
    overflow: hidden;
    color: #a1a1aa;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
</style>
