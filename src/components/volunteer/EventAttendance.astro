---
import type { EventRow } from "@/server/db/events";
import AttendeeAvatar from "./AttendeeAvatar.astro";
interface Props {
  event: EventRow;
}
const { event } = Astro.props;
const medics = event.medicConfirmed;
const orientees = event.includesOrientation ? event.orientationConfirmed : 0;
const volunteers = Math.max(0, event.confirmed - medics - orientees);
---

{
  medics + volunteers + orientees > 0 && (
    <span class="event-attendance">
      <span class="event-attendance-row">
        <span
          class="event-avatar-row"
          role="group"
          aria-label={`${medics} approved medics, ${volunteers} other volunteers and ${orientees} orientees registered`}
        >
          {Array.from({ length: medics }, () => (
            <AttendeeAvatar category="medic" />
          ))}
          {Array.from({ length: volunteers }, () => (
            <AttendeeAvatar category="volunteer" />
          ))}
          {Array.from({ length: orientees }, () => (
            <AttendeeAvatar category="orientee" />
          ))}
        </span>
      </span>
    </span>
  )
}

<style>
  .event-attendance {
    min-width: 0;
  }
  .event-avatar-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    min-width: 0;
    gap: 0.25rem;
  }
</style>
