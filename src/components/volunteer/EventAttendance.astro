---
import type { EventRow } from "@/server/db/events";
import AttendeeAvatar from "./AttendeeAvatar.astro";
interface Props {
  event: EventRow;
}
const { event } = Astro.props;
const medics = event.medicConfirmed;
const orientees = event.includesOrientation ? event.orientationConfirmed : 0;
const volunteers = Math.max(0, event.confirmed - medics - orientees);
---

<div class="event-attendance">
  <p class="event-row-label">Volunteers</p>
  <div
    class="event-avatar-row"
    role="group"
    aria-label={`${medics} approved medics and ${volunteers} other volunteers registered; two medic places reserved`}
  >
    {
      Array.from({ length: Math.max(2, medics) }, (_, index) => (
        <AttendeeAvatar category="medic" booked={index < medics} />
      ))
    }
    {
      Array.from({ length: volunteers }, () => (
        <AttendeeAvatar category="volunteer" />
      ))
    }
  </div>
  {
    Boolean(event.includesOrientation) && (
      <>
        <p class="event-row-label event-orientee-label">Orientees</p>
        <div
          class="event-orientee-box"
          role="group"
          aria-label={`${orientees} orientees registered; two reserved places, maximum four`}
        >
          {Array.from({ length: Math.max(2, orientees) }, (_, index) => (
            <AttendeeAvatar category="orientee" booked={index < orientees} />
          ))}
        </div>
      </>
    )
  }
  <details class="event-avatar-description">
    <summary>About these places</summary>
    <p>
      Filled people are registered; outlines are reserved places. Red: approved
      medics with completed orientation (two reserved, extra medics welcome).
      Green: other volunteers.
    </p>
    {
      Boolean(event.includesOrientation) && (
        <p>
          Blue: orientees, including first-time medics (two reserved, maximum
          four). No minimum orientee attendance.
        </p>
      )
    }
    <p>
      Each person uses one place. Everyone shares total capacity without using
      another category’s outstanding reservations.
    </p>
  </details>
</div>

<style>
  .event-attendance {
    margin-block: 1rem;
    min-width: 0;
  }
  .event-avatar-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
  }
  .event-orientee-box {
    display: grid;
    grid-template-columns: repeat(4, 1.75rem);
    gap: 0.375rem;
    width: fit-content;
    border: 1px solid #60a5fa;
    border-radius: 0.5rem;
    padding: 0.375rem;
  }
  .event-avatar-description {
    margin-top: 0.75rem;
    color: var(--color-zinc-300, #d4d4d8);
    font-size: 0.875rem;
  }
  summary {
    cursor: pointer;
  }
  p {
    margin-block: 0.5rem;
    max-width: 65ch;
  }
  .event-row-label {
    margin: 0 0 0.375rem;
    font-size: 1rem;
    font-weight: 400;
  }
  .event-orientee-label {
    margin-top: 0.75rem;
  }
</style>
