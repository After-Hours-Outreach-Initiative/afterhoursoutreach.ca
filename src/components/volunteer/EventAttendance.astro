---
import type { EventRow } from "@/server/db/events";
import AttendeeAvatar from "./AttendeeAvatar.astro";
interface Props {
  event: EventRow;
  newMedicCount: number;
}
const { event, newMedicCount } = Astro.props;
const medics = event.medicConfirmed;
const newVolunteers = event.newVolunteerConfirmed;
const outreachVolunteers = Math.max(
  0,
  event.confirmed - medics - newVolunteers,
);
---

{
  medics + outreachVolunteers + newVolunteers > 0 && (
    <span class="event-attendance">
      <span class="event-attendance-row">
        <span
          class="event-avatar-row"
          role="group"
          aria-label={`${medics} approved medics, ${outreachVolunteers} outreach volunteer${outreachVolunteers === 1 ? "" : "s"} and ${newVolunteers} new volunteer${newVolunteers === 1 ? "" : "s"} registered`}
        >
          {Array.from({ length: medics }, () => (
            <AttendeeAvatar category="medic" />
          ))}
          {Array.from({ length: outreachVolunteers }, () => (
            <AttendeeAvatar category="outreach-volunteer" />
          ))}
          {Array.from({ length: newVolunteers }, (_, index) => (
            <AttendeeAvatar
              category="new-volunteer"
              medicMark={index < newMedicCount}
            />
          ))}
        </span>
      </span>
    </span>
  )
}

<style>
  .event-attendance {
    min-width: 0;
  }
  .event-avatar-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    min-width: 0;
    gap: 0.25rem;
  }
</style>
