---
import type { EventRow } from "@/server/db/events";
import AttendeeAvatar from "./AttendeeAvatar.astro";
interface Props {
  event: EventRow;
}
const { event } = Astro.props;
const medics = event.medicConfirmed;
const orientees = event.includesOrientation ? event.orientationConfirmed : 0;
const volunteers = Math.max(0, event.confirmed - medics - orientees);
---

<div class="event-attendance">
  <div class="event-attendance-row">
    <span class="event-row-label">Volunteers</span>
    <div
      class="event-avatar-row"
      role="group"
      aria-label={`${medics} approved medics, ${volunteers} other volunteers and ${orientees} orientees registered`}
      tabindex="0"
    >
      {
        Array.from({ length: medics }, () => (
          <AttendeeAvatar category="medic" />
        ))
      }
      {
        Array.from({ length: volunteers }, () => (
          <AttendeeAvatar category="volunteer" />
        ))
      }
      {
        Array.from({ length: orientees }, () => (
          <AttendeeAvatar category="orientee" />
        ))
      }
    </div>
  </div>
  <details class="event-avatar-description">
    <summary>About these places</summary>
    <p>
      Each person shown is registered. Red: approved medics with completed
      orientation (two reserved, extra medics welcome). Green: other volunteers.
    </p>
    {
      Boolean(event.includesOrientation) && (
        <p>
          Blue: orientees, including first-time medics (two reserved, maximum
          four). No minimum orientee attendance.
        </p>
      )
    }
    <p>
      Each person uses one place. Everyone shares total capacity without using
      another category’s outstanding reservations.
    </p>
  </details>
</div>

<style>
  .event-attendance {
    min-width: 0;
  }
  .event-attendance-row {
    display: grid;
    grid-template-columns: 5.25rem minmax(0, 1fr);
    align-items: start;
    gap: 0.5rem;
  }
  .event-avatar-row {
    display: flex;
    flex-wrap: nowrap;
    align-items: center;
    min-width: 0;
    min-height: 2rem;
    gap: 0.25rem;
    padding: 0.25rem;
    overflow-x: auto;
    scrollbar-color: #52525b transparent;
    scrollbar-width: thin;
  }
  .event-avatar-description {
    color: var(--color-zinc-300, #d4d4d8);
    font-size: 0.875rem;
  }
  summary {
    cursor: pointer;
    min-height: 2.75rem;
    width: fit-content;
    padding-block: 0.5rem;
    align-content: center;
  }
  .event-avatar-description p {
    margin-block: 0.5rem;
    max-width: 65ch;
    font-size: 0.875rem;
    line-height: 1.5;
  }
  .event-row-label {
    padding-block: 0.25rem;
    color: var(--color-zinc-400, #a1a1aa);
    font-size: 1rem;
    font-weight: 400;
    line-height: 1.5;
  }
</style>
