---
import type { EventRow, PublicRosterRow } from "@/server/db/events";
import AttendeeAvatar from "./AttendeeAvatar.astro";
interface Props {
  event: EventRow;
  roster: Pick<PublicRosterRow, "category" | "medicMark">[];
}
const { event, roster } = Astro.props;
const medics = event.medicConfirmed;
const newVolunteers = event.newVolunteerConfirmed;
const outreachVolunteers = Math.max(
  0,
  event.confirmed - medics - newVolunteers,
);
---

<span class="event-attendance">
  {
    roster.length > 0 && (
      <span class="event-attendance-row">
        <span
          class="event-avatar-row"
          role="group"
          aria-label={`${medics} approved medics, ${outreachVolunteers} outreach volunteer${outreachVolunteers === 1 ? "" : "s"} and ${newVolunteers} new volunteer${newVolunteers === 1 ? "" : "s"} registered`}
        >
          {roster.map((person) => (
            <AttendeeAvatar
              category={person.category}
              medicMark={Boolean(person.medicMark)}
            />
          ))}
        </span>
      </span>
    )
  }
</span>

<style>
  .event-attendance {
    min-width: 0;
  }
  .event-avatar-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    min-width: 0;
    gap: 0.25rem;
  }
</style>
