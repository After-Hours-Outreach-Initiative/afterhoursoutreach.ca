---
import CloudSaveIcon from "@/components/icons/CloudSaveIcon.astro";
---

<p
  class="volunteer-draft-save-status"
  data-draft-save-indicator
  data-save-state="initializing"
  role="status"
  aria-live="polite"
  aria-atomic="true"
>
  <CloudSaveIcon class="volunteer-draft-save-icon" />
  <span data-draft-save-message></span>
  <span class="sr-only" data-draft-save-announcement></span>
</p>
