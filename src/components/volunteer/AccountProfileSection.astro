---
import PencilIcon from "@/components/icons/PencilIcon.astro";
interface Props {
  id: string;
  heading: string;
  description?: string;
  application?: boolean;
  describedBy?: string;
}
const {
  id,
  heading,
  description,
  application = false,
  describedBy,
} = Astro.props;
const descriptionId = description ? `help-${id}` : undefined;
const sectionDescribedBy =
  [descriptionId, describedBy].filter(Boolean).join(" ") || undefined;
---

{
  application ? (
    <section class="volunteer-application-section" aria-labelledby={id}>
      <h3 id={id} class="volunteer-profile-heading" data-application-section>
        {heading}
      </h3>
      <fieldset
        class="volunteer-profile-section"
        aria-describedby={sectionDescribedBy}
      >
        <legend class="sr-only">{heading}</legend>
        {description && (
          <p class="volunteer-help" id={descriptionId}>
            {description}
          </p>
        )}
        <slot />
      </fieldset>
    </section>
  ) : (
    <fieldset
      class="volunteer-profile-section"
      aria-describedby={sectionDescribedBy}
      data-profile-section
    >
      <legend class="sr-only">{heading}</legend>
      <div class="volunteer-profile-section-heading">
        <h3 id={id} class="volunteer-profile-heading" data-contents-section>
          {heading}
        </h3>
        <button
          type="button"
          class="btn btn-outline"
          data-profile-edit
          aria-label={`Edit ${heading.toLowerCase()}`}
          aria-controls={`${id}-fields`}
          aria-expanded="false"
          disabled
        >
          <PencilIcon />
          Edit
        </button>
      </div>
      {description && (
        <p class="volunteer-help" id={descriptionId}>
          {description}
        </p>
      )}
      <slot />
    </fieldset>
  )
}
