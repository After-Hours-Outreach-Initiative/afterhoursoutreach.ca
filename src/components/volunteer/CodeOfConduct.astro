---
import { ChevronDown } from "@lucide/astro";
import FieldError from "@/components/FieldError.astro";
import {
  codeOfConductConfirmation,
  codeOfConductError,
  codeOfConductRules,
} from "@/data/code-of-conduct";
---

<section
  class="volunteer-code-of-conduct"
  aria-labelledby="code-of-conduct-heading"
>
  <h3 id="code-of-conduct-heading" class="volunteer-profile-heading">
    Code of Conduct
  </h3>
  <ul class="volunteer-conduct-preview">
    {codeOfConductRules.slice(0, 2).map((rule) => <li>{rule}</li>)}
  </ul>
  <details class="volunteer-conduct-details">
    <summary aria-controls="code-of-conduct-more-rules">
      <span class="volunteer-conduct-show-more">Read all rules</span>
      <span class="volunteer-conduct-show-less">Show fewer rules</span>
      <ChevronDown size="1em" aria-hidden="true" />
    </summary>
    <ul id="code-of-conduct-more-rules">
      {codeOfConductRules.slice(2).map((rule) => <li>{rule}</li>)}
    </ul>
  </details>
  <div class="volunteer-field">
    <label
      class="volunteer-check volunteer-conduct-confirmation"
      for="profile-codeOfConductAccepted"
    >
      <input
        id="profile-codeOfConductAccepted"
        type="checkbox"
        name="codeOfConductAccepted"
        value="true"
        required
        data-validation-untouched
        aria-describedby="error-codeOfConductAccepted"
      />
      <span>
        {codeOfConductConfirmation}
        <span class="volunteer-required" aria-hidden="true"> *</span>
      </span>
    </label>
    <FieldError field="codeOfConductAccepted" message={codeOfConductError} />
  </div>
</section>
