---
import type { EventRow, PatrolSeriesRow } from "@/server/db/events";
import { vancouverInput } from "@/data/event-time";
import {
  defaultEventLimits,
  minimumEventSpots,
  orientationNeededMessage,
} from "@/data/event-limits";
import {
  defaultUnregisterMinutes,
  maxUnregisterMinutes,
} from "@/data/event-unregistration";
import FieldError from "@/components/FieldError.astro";
import FieldGroup from "./FieldGroup.astro";
import StepperField from "./StepperField.astro";
import RecurringIcon from "@/components/icons/RecurringIcon.astro";
import { maxIntervalWeeks } from "@/data/event-series";
import DateInput from "./DateInput.astro";
import NativePickerInput from "./NativePickerInput.astro";

interface Props {
  id: string;
  event?: EventRow;
  series?: PatrolSeriesRow;
}
const { id, event, series } = Astro.props;
const settings = event;
// Repeat settings for an existing date come from its series.
const recurring = Boolean(event?.seriesId && series);
const limits = { ...defaultEventLimits, ...settings };
// New volunteers already booked need the orientation, so it cannot be dropped.
const orientationNeeded = Boolean(
  event?.includesOrientation && event.newVolunteerConfirmed > 0,
);
const publicVisibility = settings
  ? Boolean(settings.open && !settings.hidden)
  : true;
---

<FieldGroup id={`${id}-type-time-group`} heading="Type and time">
  <fieldset class="volunteer-radio-field volunteer-wide">
    <legend>Event type</legend>
    <div class="volunteer-radio-group">
      <label class="volunteer-check">
        <input
          type="radio"
          name="includesOrientation"
          value="true"
          checked={settings ? Boolean(settings.includesOrientation) : true}
        />
        <span>Orientation + Patrol</span>
      </label>
      <div>
        <label
          class="volunteer-check"
          data-unavailable={orientationNeeded ? "" : undefined}
        >
          <input
            type="radio"
            name="includesOrientation"
            value="false"
            checked={settings ? !settings.includesOrientation : false}
            disabled={orientationNeeded}
            aria-describedby={orientationNeeded
              ? `${id}-orientation-needed`
              : undefined}
          />
          <span>Patrol</span>
        </label>
        {orientationNeeded && (
          <p class="volunteer-check-note" id={`${id}-orientation-needed`}>
            {orientationNeededMessage}
          </p>
        )}
      </div>
    </div>
  </fieldset>
  <div class="volunteer-event-start volunteer-wide">
    <DateInput
      name="startsAt"
      id={`${id}-startsAt`}
      errorField={`${id}-startsAt`}
      label="Start date"
      value={event ? vancouverInput(event.startsAt) : ""}
      withTime
      defaultTime="21:00"
      warnPast
    />
  </div>
  {(!event || recurring) && (
    <div class="volunteer-field volunteer-wide" data-recurrence-controls>
      {!recurring && (
        <label class="volunteer-check volunteer-recurrence-toggle">
          <input
            type="checkbox"
            name="recurring"
            aria-describedby={`${id}-recurring-help`}
          />
          <span class="volunteer-recurrence-label">
            <RecurringIcon class="volunteer-recurrence-icon" />
            <span>Recurring patrol</span>
          </span>
        </label>
      )}
      <div class="volunteer-fields" data-recurrence-fields hidden={!recurring}>
        <label class="volunteer-field">
          Repeat every (weeks)
          <input
            name="intervalWeeks"
            type="number"
            min="1"
            max={maxIntervalWeeks}
            value={event?.intervalWeeks ?? 2}
            disabled={!recurring}
            data-series-schedule={recurring ? "" : undefined}
            required
          />
        </label>
        <div class="volunteer-field">
          <label for={`${id}-endDate`}>
            Last recurring date (optional, inclusive)
          </label>
          <NativePickerInput
            id={`${id}-endDate`}
            name="endDate"
            min={event?.occurrenceDate ?? undefined}
            value={series?.endDate ?? ""}
            aria-describedby={`error-${id}-endDate`}
            disabled={!recurring}
            data-series-schedule={recurring ? "" : undefined}
          />
          <FieldError
            field={`${id}-endDate`}
            message="Choose a valid last recurring date on or after the start date."
          />
        </div>
      </div>
      <p class="volunteer-help" id={`${id}-recurring-help`}>
        {recurring
          ? "Changing these applies to this and following events, or all events."
          : "Volunteers can register for dates up to two months ahead."}
      </p>
    </div>
  )}
</FieldGroup>
<FieldGroup id={`${id}-location-group`} heading="Location">
  <div class="volunteer-field">
    <label for={`${id}-meetingPoint`}>Meeting point</label>
    <input
      id={`${id}-meetingPoint`}
      name="meetingPoint"
      aria-describedby={`error-${id}-meetingPoint`}
      required
      pattern={String.raw`.*\S.*`}
      maxlength="500"
      value={settings?.meetingPoint ?? "Lord Strathcona Elementary"}
    />
    <FieldError
      field={`${id}-meetingPoint`}
      message="Enter a meeting point (up to 500 characters)."
    />
  </div>
  <div class="volunteer-field">
    <label for={`${id}-meetingPointUrl`}>Map link (optional)</label>
    <input
      id={`${id}-meetingPointUrl`}
      type="url"
      name="meetingPointUrl"
      aria-describedby={`error-${id}-meetingPointUrl`}
      maxlength="2048"
      value={
        settings
          ? (settings.meetingPointUrl ?? "")
          : "https://maps.app.goo.gl/4ommJyZFCRJRGf9F9"
      }
      placeholder="https://"
    />
    <FieldError
      field={`${id}-meetingPointUrl`}
      message="Enter a valid map URL (up to 2048 characters)."
    />
  </div>
</FieldGroup>
<FieldGroup id={`${id}-spots-group`} heading="Spots">
  <StepperField
    id={`${id}-spots`}
    name="spots"
    label="Volunteer spots"
    help="Total places, including the reserved ones below."
    min={minimumEventSpots(limits)}
    max="100"
    value={settings?.spots ?? 8}
    required
    primary
    error={
      minimumEventSpots(limits) > 100
        ? "Reduce reserved places to a combined maximum of 100."
        : `Enter a whole number from ${minimumEventSpots(limits)} to 100, covering all reserved places.`
    }
  />
  <div
    class="volunteer-spot-limits volunteer-wide"
    role="group"
    aria-labelledby={`${id}-spot-limits`}
  >
    <p id={`${id}-spot-limits`} class="volunteer-spot-limits-label">
      Reserved places and limits
    </p>
    {[
      {
        name: "minMedicSpots",
        label: "Minimum medic spots",
        help: "Held for approved medics.",
        error: "Enter a whole number from 0 to 100.",
      },
      {
        name: "minNewVolunteerSpots",
        label: "Minimum new volunteer spots",
        help: "Held for new volunteers when orientation is included.",
        error: "Enter a whole number from 0 to 100.",
      },
      {
        name: "maxNewVolunteers",
        label: "Maximum new volunteers",
        help: "Cap on new volunteers when orientation is included.",
        error:
          "Enter a whole number from 0 to 100, at least the minimum new volunteer spots.",
      },
    ].map(({ name, label, help, error }) => (
      <StepperField
        id={`${id}-${name}`}
        name={name}
        label={label}
        help={help}
        min="0"
        max="100"
        value={limits[name as keyof typeof defaultEventLimits]}
        required
        error={error}
      />
    ))}
  </div>
</FieldGroup>
<FieldGroup id={`${id}-registration-group`} heading="Registration">
  <div class="volunteer-field">
    <label for={`${id}-unregisterMinutes`}>
      Unregister until (minutes after start)
    </label>
    <input
      id={`${id}-unregisterMinutes`}
      name="unregisterMinutes"
      type="number"
      min="0"
      max={maxUnregisterMinutes}
      step="1"
      required
      value={settings?.unregisterMinutes ?? defaultUnregisterMinutes}
      aria-describedby={`${id}-unregisterMinutes-help error-${id}-unregisterMinutes`}
    />
    <p class="volunteer-help" id={`${id}-unregisterMinutes-help`}>
      Volunteers can unregister until this many minutes after the event starts.
    </p>
    <FieldError
      field={`${id}-unregisterMinutes`}
      message={`Enter a whole number from 0 to ${maxUnregisterMinutes}.`}
    />
  </div>
  <fieldset class="volunteer-state-field volunteer-wide">
    <legend>Public visibility</legend>
    <div class="volunteer-state-selector">
      <label class="volunteer-state-option volunteer-state-positive">
        <input
          class="sr-only"
          type="radio"
          name="publicVisibility"
          value="true"
          checked={publicVisibility}
        />
        <span>Visible</span>
      </label>
      <label class="volunteer-state-option volunteer-state-negative">
        <input
          class="sr-only"
          type="radio"
          name="publicVisibility"
          value="false"
          checked={!publicVisibility}
        />
        <span>Hidden</span>
      </label>
    </div>
  </fieldset>
</FieldGroup>

<style>
  .volunteer-event-start {
    container-type: inline-size;
    min-width: 0;
  }

  @container (min-width: 30rem) {
    .volunteer-event-start :global(.volunteer-date-input) {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: 1.5rem;
    }

    .volunteer-event-start :global(legend) {
      /* Let the legend share the grid with the time label. */
      float: left;
      grid-column: 1;
      grid-row: 1;
      margin-bottom: 0;
    }

    .volunteer-event-start :global(.volunteer-native-picker) {
      grid-column: 1;
      grid-row: 2;
    }

    .volunteer-event-start :global(.volunteer-date-input > .volunteer-field) {
      grid-column: 2;
      grid-row: 1 / span 2;
    }

    .volunteer-event-start :global([data-error]),
    .volunteer-event-start :global(.volunteer-help) {
      grid-column: 1 / -1;
    }
  }
</style>
