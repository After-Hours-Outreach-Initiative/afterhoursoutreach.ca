---
import type { PublicRosterRow } from "@/server/db/events";
import AttendeeAvatar from "./AttendeeAvatar.astro";
interface Props {
  roster: PublicRosterRow[];
}
const { roster } = Astro.props;
---

<details class="public-event-roster">
  <summary>Volunteers ({roster.length})</summary>
  {roster.length === 0 && <p>No volunteers registered yet.</p>}
  <ul hidden={roster.length === 0}>
    {
      roster.map((person) => (
        <li>
          <>
            <AttendeeAvatar category={person.category} />
            <span>{person.name}</span>
          </>
        </li>
      ))
    }
  </ul>
</details>

<style>
  .public-event-roster {
    margin-top: 0.5rem;
  }
  summary {
    cursor: pointer;
    min-height: 2.75rem;
    padding-block: 0.5rem;
    align-content: center;
    width: fit-content;
  }
  ul {
    list-style: none;
    margin: 0.75rem 0 0;
    padding: 0;
    display: grid;
    gap: 0.5rem;
  }
  li {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    overflow-wrap: anywhere;
  }
</style>
