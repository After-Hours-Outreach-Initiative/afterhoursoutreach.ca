---
import type { PublicRosterRow } from "@/server/db/events";
import AttendeeAvatar from "./AttendeeAvatar.astro";
interface Props {
  roster: PublicRosterRow[];
}
const { roster } = Astro.props;
---

<details class="public-event-roster">
  <summary>Volunteers ({roster.length})</summary>
  {roster.length === 0 && <p>No volunteers registered yet.</p>}
  <table class="event-roster-table" hidden={roster.length === 0}>
    <caption class="sr-only">Registered volunteers</caption>
    <thead class="sr-only"><tr><th scope="col">Volunteer</th></tr></thead>
    <tbody>
      {
        roster.map((person) => (
          <tr>
            <th scope="row">
              <div class="event-roster-person">
                <AttendeeAvatar category={person.category} />
                <span>{person.name}</span>
              </div>
            </th>
          </tr>
        ))
      }
    </tbody>
  </table>
</details>

<style>
  .public-event-roster {
    margin-top: 0.5rem;
  }
  summary {
    cursor: pointer;
    min-height: 2.75rem;
    padding-block: 0.5rem;
    align-content: center;
    width: fit-content;
  }
</style>
