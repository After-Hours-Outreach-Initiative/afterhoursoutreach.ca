---
import DialogHeader from "@/components/DialogHeader.astro";
---

<dialog
  class="dialog-pop dialog-frame volunteer-dialog volunteer-profile-dialog"
  data-volunteer-profile-dialog
  aria-labelledby="volunteer-profile-dialog-heading"
>
  <DialogHeader
    id="volunteer-profile-dialog-heading"
    title="Volunteer profile"
    closeLabel="Close volunteer profile"
  />
  <div class="dialog-body" data-profile-dialog-content><slot /></div>
  <template data-profile-dialog-loading>
    <div class="volunteer-profile-loading" role="status">
      <span class="volunteer-profile-loading-icon" aria-hidden="true"></span>
      <span>Loading</span>
    </div>
  </template>
</dialog>
