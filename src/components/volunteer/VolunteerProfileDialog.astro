<dialog
  class="dialog-pop volunteer-dialog"
  data-volunteer-profile-dialog
  aria-labelledby="volunteer-profile-dialog-heading"
>
  <div class="volunteer-section-heading">
    <h2 id="volunteer-profile-dialog-heading">Volunteer profile</h2>
    <button
      class="btn btn-quiet"
      data-dismiss-dialog
      type="button"
      aria-label="Close volunteer profile">Close</button
    >
  </div>
  <div data-profile-dialog-content></div>
</dialog>
