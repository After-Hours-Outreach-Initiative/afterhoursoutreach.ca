---
import type { VolunteerRow } from "@/server/db/volunteers";
import VolunteerAccessButton from "./VolunteerAccessButton.astro";

interface Props {
  person: VolunteerRow;
  kind: "application" | "patrol";
}
const { person, kind } = Astro.props;
const approved =
  kind === "application"
    ? Boolean(person.applicationApproved)
    : Boolean(person.patrolApproved);
---

<form
  class="volunteer-form"
  data-organizer-status
  data-access-kind={kind}
  data-email-prompt="access"
  action="/api/v1/organizer/action"
  method="post"
>
  <input type="hidden" name="userId" value={person.id} />
  <input type="hidden" name="version" value={person.updatedAt} />
  {kind === "patrol" && !approved && (
    <input type="hidden" name="approvePatrols" value="true" />
  )}
  <input
    type="checkbox"
    name="active"
    checked={Boolean(person.active)}
    hidden
  />
  <input
    type="checkbox"
    name="applicationApproved"
    checked={
      kind === "application" ? !approved : Boolean(person.applicationApproved)
    }
    hidden
  />
  <input
    type="checkbox"
    name="patrolApproved"
    checked={kind === "patrol" ? !approved : Boolean(person.patrolApproved)}
    hidden
  />
  <p data-form-message role="status" hidden></p>
  <VolunteerAccessButton
    {kind}
    {approved}
    data-loading-label="Saving…"
    data-volunteer-control
    disabled
  />
</form>
