---
import type { VolunteerRow } from "@/server/db/volunteers";
interface Props {
  person: VolunteerRow;
}
const { person } = Astro.props;
---

<section
  class="volunteer-profile-controls"
  data-volunteer-controls
  aria-labelledby="volunteer-organizer-controls-heading"
>
  <h2 id="volunteer-organizer-controls-heading" data-contents-section>
    Organizer controls
  </h2>
  {
    Boolean(person.applicationApproved) && (
      <>
        <form
          class="volunteer-form"
          data-organizer-status
          data-access-kind="active"
          data-submit-on-change
          data-email-prompt="access"
          action="/api/v1/organizer/action"
          method="post"
        >
          <input type="hidden" name="userId" value={person.id} />
          <input type="hidden" name="version" value={person.updatedAt} />
          <input
            type="checkbox"
            name="applicationApproved"
            checked={Boolean(person.applicationApproved)}
            hidden
          />
          <input
            type="checkbox"
            name="patrolApproved"
            checked={Boolean(person.patrolApproved)}
            hidden
          />
          <label class="volunteer-check">
            <input
              type="checkbox"
              name="active"
              checked={Boolean(person.active)}
              data-volunteer-control
              disabled
            />
            Active volunteer
          </label>
          <p data-form-message role="status" hidden />
          <span
            class="volunteer-control-loading"
            data-action-loading
            role="status"
            hidden
          >
            Saving…
          </span>
          <noscript>
            <button class="btn btn-quiet" type="submit">
              Save active status
            </button>
          </noscript>
        </form>
        <form
          class="volunteer-form"
          data-organizer-role
          data-email-prompt="role"
          data-submit-on-change
          action="/api/v1/organizer/action"
          method="post"
        >
          <input type="hidden" name="userId" value={person.id} />
          <label class="volunteer-field">
            Account role
            <select name="role" data-volunteer-control disabled>
              <option value="volunteer" selected={person.role === "volunteer"}>
                Outreach Volunteer
              </option>
              <option value="organizer" selected={person.role === "organizer"}>
                Organizer
              </option>
            </select>
          </label>
          <p data-form-message role="status" hidden />
          <span
            class="volunteer-control-loading"
            data-action-loading
            role="status"
            hidden
          >
            Saving…
          </span>
          <noscript>
            <button class="btn btn-outline" type="submit">
              Save role
            </button>
          </noscript>
        </form>
      </>
    )
  }
</section>
