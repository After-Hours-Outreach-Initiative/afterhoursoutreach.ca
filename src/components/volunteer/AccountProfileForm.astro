---
import {
  profileFields,
  registrationFields,
  type RegistrationAnswers,
} from "@/data/registration";
import FieldError from "@/components/FieldError.astro";
import CodeOfConduct from "./CodeOfConduct.astro";
interface Props {
  email: string;
  values?: RegistrationAnswers | null;
  registration?: boolean;
}
const { email, values, registration = false } = Astro.props;
---

<form
  data-account-profile
  data-registration={registration || undefined}
  class="volunteer-form"
  action="/api/account/profile"
  method="post"
>
  <div class="volunteer-fields">
    <label class="volunteer-field"
      >Email<input type="email" value={email} readonly /><span
        class="volunteer-help">From your signed-in account.</span
      ></label
    >
    {
      (registration ? registrationFields : profileFields).map((field) => (
        <div
          class:list={[
            "volunteer-field",
            { "volunteer-wide": "multiline" in field },
          ]}
        >
          <label for={`profile-${field.name}`}>
            {field.label}
            {field.required ? (
              <span class="volunteer-required" aria-hidden="true">
                {" "}
                *
              </span>
            ) : (
              <span class="volunteer-help"> (optional)</span>
            )}
          </label>
          {"multiline" in field ? (
            <textarea
              id={`profile-${field.name}`}
              name={field.name}
              aria-describedby={`error-${field.name}${"help" in field ? ` help-${field.name}` : ""}`}
              required={field.required}
              rows="3"
              maxlength="2000"
              set:text={values?.[field.name] ?? ""}
            />
          ) : (
            <input
              id={`profile-${field.name}`}
              name={field.name}
              aria-describedby={`error-${field.name}${"help" in field ? ` help-${field.name}` : ""}`}
              type={"type" in field ? field.type : "text"}
              autocomplete={
                "autocomplete" in field ? field.autocomplete : "off"
              }
              value={values?.[field.name] ?? ""}
              required={field.required}
              maxlength={
                field.name === "phone" || field.name === "emergencyPhone"
                  ? "40"
                  : "200"
              }
              min={field.name === "birthDate" ? "1900-01-01" : undefined}
              max={
                field.name === "birthDate"
                  ? new Date().toISOString().slice(0, 10)
                  : undefined
              }
            />
          )}
          {"help" in field && (
            <span class="volunteer-help" id={`help-${field.name}`}>
              {field.help}
            </span>
          )}
          <FieldError field={field.name} />
        </div>
      ))
    }
    <fieldset
      class="volunteer-wide"
      data-required-checkboxes="teams"
      aria-describedby="error-teams"
    >
      <legend>
        Which teams interest you? <span
          class="volunteer-required"
          aria-hidden="true">*</span
        >
      </legend>
      <span class="volunteer-help">Choose at least one.</span>
      <div class="volunteer-checks">
        {
          ["outreach", "medic", "non-patrol"].map((team) => (
            <label>
              <input
                type="checkbox"
                name="teams"
                value={team}
                checked={values?.teams.includes(team)}
              />
              {team === "non-patrol"
                ? "Non-patrol support"
                : team === "medic"
                  ? "Medic"
                  : "Outreach"}
            </label>
          ))
        }
      </div>
      <FieldError field="teams" />
    </fieldset>
  </div>
  {registration && <CodeOfConduct />}
  <p data-form-message role="status" aria-live="polite" hidden></p>
  <button type="submit" class="btn btn-primary"
    >{registration ? "Complete registration" : "Save profile"}</button
  >
  <noscript><p>JavaScript is required to submit this form.</p></noscript>
</form>
