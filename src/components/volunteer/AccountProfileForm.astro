---
import {
  profileFields,
  applicationFields,
  type ApplicationAnswers,
} from "@/data/application";
import AccountProfileField from "./AccountProfileField.astro";
import CodeOfConduct from "./CodeOfConduct.astro";
import MedicalCertifications from "./MedicalCertifications.astro";
import RelevantTraining from "./RelevantTraining.astro";
import ReferralSources from "./ReferralSources.astro";
interface Props {
  email: string;
  values?: ApplicationAnswers | null;
  application?: boolean;
}
const { email, values, application = false } = Astro.props;
const fields = application ? applicationFields : profileFields;
const medicSelected = values?.teams.includes("medic") ?? false;
const legacyName = Boolean(values && !values.firstName && !values.lastName);
const teams = [
  {
    value: "outreach",
    label: "Outreach",
    description: "Hand out supplies and connect with the DTES community.",
  },
  {
    value: "medic",
    label: "Medic",
    description: "Provide first aid and assist in emergency overdose response.",
    requirement:
      "Minimum requirement: Valid OFA Level 3 or Advanced First Aid certification.",
  },
  {
    value: "non-patrol",
    label: "Non-patrol support",
    description:
      "Assist with inventory, logistics, grant writing, community partnerships, and other operational needs.",
  },
] as const;
const sections = [
  { key: "personal-info", heading: "Personal info" },
  { key: "emergency-contact", heading: "Emergency contact" },
  { key: "team-interests", heading: "Team interests" },
  { key: "training-and-safety", heading: "Training and safety" },
  { key: "about-volunteering", heading: "About volunteering" },
]
  .map((section) => ({
    ...section,
    fields: fields.filter((field) => field.section === section.key),
  }))
  .filter(
    (section) => section.key === "team-interests" || section.fields.length,
  );
---

<form
  data-account-profile
  data-application={application || undefined}
  data-save-changes={!application || undefined}
  class="volunteer-form volunteer-profile-form"
  action="/api/v1/account/profile"
  method="post"
>
  {
    sections.map((section) => (
      <fieldset
        class="volunteer-profile-section"
        aria-describedby={
          section.key === "team-interests" ? "help-teams" : undefined
        }
      >
        <legend>
          <h3 class="volunteer-profile-heading">{section.heading}</h3>
        </legend>
        {section.key === "team-interests" ? (
          <>
            <input type="hidden" name="teams" value="outreach" />
            <div class="volunteer-field">
              <span>
                Which teams interest you?{" "}
                <span class="volunteer-required" aria-hidden="true">
                  *
                </span>
              </span>
              <span class="volunteer-help" id="help-teams">
                Outreach is included for everyone. Other teams are optional.
              </span>
            </div>
            <div class="volunteer-team-options">
              {teams.map((team) => (
                <label
                  class="volunteer-team-option"
                  data-included={team.value === "outreach" || undefined}
                >
                  <input
                    type="checkbox"
                    name="teams"
                    value={team.value}
                    checked={
                      team.value === "outreach" ||
                      values?.teams.includes(team.value)
                    }
                    disabled={team.value === "outreach"}
                    aria-labelledby={`team-${team.value}-label`}
                    aria-describedby={`team-${team.value}-description help-teams`}
                  />
                  <span class="volunteer-team-content">
                    <span
                      class="volunteer-team-title"
                      id={`team-${team.value}-label`}
                    >
                      {team.label}
                    </span>
                    <span
                      class="volunteer-team-description"
                      id={`team-${team.value}-description`}
                    >
                      {team.description}
                      {"requirement" in team && (
                        <span class="volunteer-team-requirement">
                          {team.requirement}
                        </span>
                      )}
                    </span>
                  </span>
                </label>
              ))}
            </div>
          </>
        ) : (
          <div class="volunteer-fields">
            {section.key === "training-and-safety" && (
              <MedicalCertifications values={values} active={medicSelected} />
            )}
            {application && section.key === "personal-info" && (
              <label class="volunteer-field">
                Email
                <input type="email" value={email} readonly />
              </label>
            )}
            {legacyName && section.key === "personal-info" && (
              <p class="volunteer-help volunteer-wide">
                Your previous full or preferred name is kept unchanged in
                Preferred name. You can leave first and last names blank, or
                provide both.
              </p>
            )}
            {section.fields
              .filter(
                (field) =>
                  field.name !== "experience" && field.name !== "otherTraining",
              )
              .map((field) =>
                field.name === "heardAboutUs" ? (
                  <ReferralSources values={values} />
                ) : (
                  <AccountProfileField
                    field={field}
                    values={values}
                    required={
                      field.required &&
                      !(
                        legacyName &&
                        ["firstName", "lastName"].includes(field.name)
                      )
                    }
                    active={
                      field.name !== "certificationExpiry" || medicSelected
                    }
                  />
                ),
              )}
            {section.key === "training-and-safety" && (
              <RelevantTraining values={values} />
            )}
          </div>
        )}
      </fieldset>
    ))
  }
  {application && <CodeOfConduct />}
  <p data-form-message role="status" aria-live="polite" hidden></p>
  <button type="submit" class="btn btn-primary" disabled={!application}
    >{application ? "Complete application" : "Save profile"}</button
  >
  <noscript><p>JavaScript is required to submit this form.</p></noscript>
</form>
