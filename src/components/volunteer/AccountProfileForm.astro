---
import {
  profileFields,
  registrationFields,
  type RegistrationAnswers,
} from "@/data/registration";
import FieldError from "@/components/FieldError.astro";
import AccountProfileField from "./AccountProfileField.astro";
import CodeOfConduct from "./CodeOfConduct.astro";
interface Props {
  email: string;
  values?: RegistrationAnswers | null;
  registration?: boolean;
}
const { email, values, registration = false } = Astro.props;
const fields = registration ? registrationFields : profileFields;
const sections = [
  { key: "personal-info", heading: "Personal info" },
  { key: "emergency-contact", heading: "Emergency contact" },
  { key: "about-volunteering", heading: "About volunteering" },
  { key: "training-and-safety", heading: "Training and safety" },
]
  .map((section) => ({
    ...section,
    fields: fields.filter((field) => field.section === section.key),
  }))
  .filter((section) => section.fields.length);
---

<form
  data-account-profile
  data-registration={registration || undefined}
  data-save-changes={!registration || undefined}
  class="volunteer-form volunteer-profile-form"
  action="/api/v1/account/profile"
  method="post"
>
  {
    sections.map((section) => (
      <fieldset class="volunteer-profile-section">
        <legend>
          <h3 class="volunteer-profile-heading">{section.heading}</h3>
        </legend>
        <div class="volunteer-fields">
          {registration && section.key === "personal-info" && (
            <label class="volunteer-field">
              Email
              <input type="email" value={email} readonly />
            </label>
          )}
          {section.fields.map((field) => (
            <AccountProfileField field={field} values={values} />
          ))}
        </div>
      </fieldset>
    ))
  }
  <fieldset
    class="volunteer-profile-section"
    data-required-checkboxes="teams"
    aria-describedby="error-teams help-teams"
  >
    <legend><h3 class="volunteer-profile-heading">Team interests</h3></legend>
    <div class="volunteer-field">
      <span>
        Which teams interest you? <span
          class="volunteer-required"
          aria-hidden="true">*</span
        >
      </span>
      <span class="volunteer-help" id="help-teams">Choose at least one.</span>
    </div>
    <div class="volunteer-checks">
      {
        ["outreach", "medic", "non-patrol"].map((team) => (
          <label>
            <input
              type="checkbox"
              name="teams"
              value={team}
              checked={values?.teams.includes(team)}
              required={!values?.teams.length}
              aria-describedby="error-teams help-teams"
            />
            {team === "non-patrol"
              ? "Non-patrol support"
              : team === "medic"
                ? "Medic"
                : "Outreach"}
          </label>
        ))
      }
    </div>
    <FieldError field="teams" message="Choose at least one team." />
  </fieldset>
  {registration && <CodeOfConduct />}
  <p data-form-message role="status" aria-live="polite" hidden></p>
  <button type="submit" class="btn btn-primary" disabled={!registration}
    >{registration ? "Complete registration" : "Save profile"}</button
  >
  <noscript><p>JavaScript is required to submit this form.</p></noscript>
</form>
