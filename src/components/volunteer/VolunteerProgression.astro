---
import type {
  VolunteerOrientation,
  VolunteerRow,
} from "@/server/db/volunteers";
import CheckIcon from "@/components/icons/CheckIcon.astro";
import VolunteerAccessAction from "./VolunteerAccessAction.astro";
import { formatEventDate } from "@/data/event-time";

interface Props {
  person: VolunteerRow;
  orientation: VolunteerOrientation | null;
  completedOrientation: VolunteerOrientation | null;
  medic: boolean;
}
const { person, orientation, completedOrientation, medic } = Astro.props;
const current = !person.applicationApproved
  ? -1
  : !person.patrolApproved
    ? 0
    : 1;
const orientationEvent = completedOrientation ?? orientation;
const steps = [
  {
    title: "New volunteer",
    description: "Review readiness for outreach patrols.",
  },
  {
    title: medic ? "Medic" : "Outreach Volunteer",
    description: "Approved to participate in patrols in this role.",
  },
];
---

<section
  class="volunteer-progression"
  data-volunteer-progression
  data-volunteer-controls
  aria-labelledby="volunteer-progression-heading"
>
  <h2 id="volunteer-progression-heading" data-contents-section>
    Volunteer progression
  </h2>
  <ol
    class="volunteer-progression-list"
    role="list"
    aria-label="Volunteer progression"
  >
    {
      steps.map((step, index) => (
        <li
          class="volunteer-progression-step"
          data-progression-stage={index === 0 ? "new-volunteer" : "approved"}
          data-state={
            index < current
              ? "complete"
              : index === current
                ? "current"
                : "upcoming"
          }
          aria-current={index === current ? "step" : undefined}
        >
          <div class="progression-content">
            <div class="progression-heading">
              <span class="progression-marker" aria-hidden="true">
                {index < current ? <CheckIcon class="size-5" /> : index + 1}
              </span>
              <h3>{step.title}</h3>
            </div>
            <p class="progression-description">{step.description}</p>
            {index === 0 && (
              <>
                <p class="progression-status" data-orientation-status>
                  {completedOrientation
                    ? "Orientation completed"
                    : "Orientation not completed"}
                </p>
                {orientationEvent && (
                  <p class="progression-status" data-orientation-event>
                    {!completedOrientation && "Registered orientation: "}
                    <time
                      datetime={new Date(
                        orientationEvent.startsAt,
                      ).toISOString()}
                    >
                      {formatEventDate(orientationEvent.startsAt)}
                    </time>{" "}
                    · {orientationEvent.meetingPoint}
                  </p>
                )}
                {current >= 0 && (
                  <p class="progression-status">
                    {person.patrolApproved
                      ? "Patrol access approved"
                      : "Awaiting patrol approval"}
                  </p>
                )}
                {!person.active && (
                  <p class="progression-status">Volunteer account inactive</p>
                )}
                {current === 0 && (
                  <div class="volunteer-progression-actions">
                    <VolunteerAccessAction {person} kind="patrol" />
                  </div>
                )}
              </>
            )}
            {index === 1 && current === 1 && (
              <div class="volunteer-progression-actions">
                <a
                  class="btn btn-outline"
                  href="#volunteer-organizer-controls-heading"
                >
                  Manage volunteer
                </a>
              </div>
            )}
          </div>
        </li>
      ))
    }
  </ol>
</section>
