---
import type {
  viewVolunteerProfile,
  VolunteerRow,
  VolunteerOrientation,
} from "@/server/db/volunteers";
import {
  profileFormSections,
  submittedApplicationSections,
} from "@/data/application";
import { personFullName } from "@/data/person-name";
import OrganizerApplicationSteps from "@/components/volunteer/OrganizerApplicationSteps.astro";
import AccountProfileAnswers from "@/components/volunteer/AccountProfileAnswers.astro";
import VolunteerAccessAction from "@/components/volunteer/VolunteerAccessAction.astro";
import VolunteerControls from "@/components/volunteer/VolunteerControls.astro";
import VolunteerProgression from "@/components/volunteer/VolunteerProgression.astro";
import PageContents from "@/components/volunteer/PageContents.astro";
import type { ApplicationProgress } from "@/server/db/application-progress";
interface Props {
  profile: NonNullable<Awaited<ReturnType<typeof viewVolunteerProfile>>>;
  person: VolunteerRow;
  orientation: VolunteerOrientation | null;
  completedOrientation: VolunteerOrientation | null;
  progress: ApplicationProgress;
}
const { profile, person, orientation, completedOrientation, progress } =
  Astro.props;
const profileSections = profileFormSections();
const medic = profile.answers.teams.includes("medic");
const contents = [
  { id: "volunteer-progression-heading", heading: "Volunteer progression" },
  ...(person.applicationApproved
    ? [
        { id: "volunteer-profile-panel", heading: "Profile" },
        ...profileSections.map((section) => ({
          id: `volunteer-current-${section.key}`,
          heading: section.heading,
          nested: true,
        })),
      ]
    : []),
  { id: "volunteer-application-panel", heading: "Application" },
  ...submittedApplicationSections.map((section) => ({
    id: `volunteer-${section.key}`,
    heading: section.heading,
    nested: true,
  })),
  ...(person.applicationApproved
    ? [
        {
          id: "volunteer-organizer-controls-heading",
          heading: "Organizer controls",
        },
      ]
    : []),
];
---

<div data-volunteer-profile>
  <div data-volunteer-profile-overview>
    <h2>{personFullName(profile.answers, person.name)}</h2>
  </div>
  <PageContents entries={contents} heading="Sections" idleHeading="Sections" />
  <div data-volunteer-profile-body>
    <VolunteerProgression
      {person}
      {orientation}
      {completedOrientation}
      {medic}
    />
    {
      Boolean(person.applicationApproved) && (
        <section
          id="volunteer-profile-panel"
          data-volunteer-profile-panel="profile"
          aria-labelledby="volunteer-profile-heading"
        >
          <h2 id="volunteer-profile-heading" data-contents-section>
            Profile
          </h2>
          <div class="account-profile-summary mt-6 mb-8">
            <dl>
              <div>
                <dt>Email</dt>
                <dd>{profile.email}</dd>
              </div>
            </dl>
          </div>
          {profileSections.map((section) => (
            <section class="volunteer-profile-section">
              <h3
                id={`volunteer-current-${section.key}`}
                class="volunteer-profile-heading mb-6"
                data-contents-section
              >
                {section.heading}
              </h3>
              <AccountProfileAnswers
                section={section}
                values={profile.answers}
              />
            </section>
          ))}
        </section>
      )
    }
    <section
      id="volunteer-application-panel"
      data-volunteer-profile-panel="application"
      aria-labelledby="volunteer-application-heading"
    >
      <h2 id="volunteer-application-heading" data-contents-section>
        Application
      </h2>
      <OrganizerApplicationSteps
        {profile}
        {progress}
        idPrefix="volunteer"
        showReview
      >
        <div slot="review" data-volunteer-controls>
          <div class="organizer-application-review-actions">
            <VolunteerAccessAction {person} kind="application" />
          </div>
          {
            !person.applicationApproved &&
              !person.applicationRejectionReason && (
                <details class="organizer-application-rejection">
                  <summary class="cursor-pointer text-red-300 underline underline-offset-4">
                    Reject application
                  </summary>
                  <form
                    class="volunteer-form mt-4"
                    data-organizer-rejection
                    action="/api/v1/organizer/action"
                    method="post"
                  >
                    <input type="hidden" name="userId" value={person.id} />
                    <input
                      type="hidden"
                      name="version"
                      value={person.updatedAt}
                    />
                    <label class="volunteer-field">
                      Reason for rejection
                      <textarea
                        name="reason"
                        required
                        maxlength="2000"
                        rows="4"
                        data-volunteer-control
                        disabled
                      />
                    </label>
                    <p class="volunteer-help">
                      This reason will be emailed to the applicant and shown in
                      their application.
                    </p>
                    <p data-form-message role="status" hidden />
                    <button
                      class="btn btn-red"
                      type="submit"
                      data-loading-label="Sending…"
                      data-volunteer-control
                      disabled
                    >
                      Reject application and email reason
                    </button>
                  </form>
                </details>
              )
          }
        </div>
      </OrganizerApplicationSteps>
    </section>
    {
      Boolean(person.applicationApproved) && (
        <VolunteerControls person={person} />
      )
    }
  </div>
</div>
