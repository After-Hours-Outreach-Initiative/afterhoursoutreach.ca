---
import { profileSummaryRows } from "@/data/account-profile";
import type { ApplicationAnswers } from "@/data/application";

interface Props {
  values?: ApplicationAnswers | null;
  sections: { key: string; heading: string }[];
}
const { values, sections } = Astro.props;
const rows = profileSummaryRows(values ?? {});
---

<div class="account-profile-summary" data-profile-summary>
  {
    sections.map((section) => (
      <section
        class="volunteer-profile-section"
        aria-labelledby={`profile-summary-${section.key}`}
      >
        <h3
          class="volunteer-profile-heading"
          id={`profile-summary-${section.key}`}
        >
          {section.heading}
        </h3>
        <dl>
          {rows
            .filter((row) => row.section === section.key)
            .map((row) => (
              <div data-profile-row={row.name} hidden={row.hidden}>
                <dt>{row.label}</dt>
                <dd data-profile-answer={row.name}>
                  {Array.isArray(row.value) ? (
                    row.value.length ? (
                      <ul>
                        {row.value.map((value) => (
                          <li>{value}</li>
                        ))}
                      </ul>
                    ) : (
                      "None selected"
                    )
                  ) : (
                    row.value
                  )}
                </dd>
              </div>
            ))}
        </dl>
      </section>
    ))
  }
</div>
