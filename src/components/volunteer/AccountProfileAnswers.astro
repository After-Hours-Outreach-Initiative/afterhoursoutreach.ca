---
import {
  type ApplicationAnswers,
  profileFormSections,
} from "@/data/application";
import { profileAnswerRows } from "@/data/profile-answers";
import AnswerValue from "./AnswerValue.astro";

interface Props {
  section: ReturnType<typeof profileFormSections>[number];
  values?: ApplicationAnswers | null;
  hideEmptyMiddleNames?: boolean;
}
const { section, values, hideEmptyMiddleNames = false } = Astro.props;
const rows = profileAnswerRows(section, values).filter(
  (row) =>
    !hideEmptyMiddleNames ||
    row.name !== "middleNames" ||
    Boolean(values?.middleNames?.trim()),
);
---

<div class="account-profile-summary" data-profile-answers={section.key}>
  <dl>
    {
      rows.map((row) => (
        <div
          data-profile-answer={row.name}
          class:list={{ "volunteer-wide": row.wide }}
          hidden={row.hidden}
        >
          <dt>{row.label}</dt>
          <dd>
            <AnswerValue value={row.value} />
          </dd>
        </div>
      ))
    }
  </dl>
</div>
