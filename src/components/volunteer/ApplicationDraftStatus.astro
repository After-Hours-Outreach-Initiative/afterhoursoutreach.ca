<div class="volunteer-help">
  <button type="button" data-draft-discard class="btn btn-quiet" disabled>
    Discard application draft
  </button>
  <p data-draft-discard-status role="status" aria-live="polite" hidden></p>
  <a href="/apply" data-draft-new class="inline-block mt-2 underline" hidden>
    Reload to start or check your draft
  </a>
</div>
<div class="volunteer-help" data-draft-status-panel hidden>
  <p data-draft-status role="status" aria-live="polite" hidden></p>
  <button type="button" data-draft-retry class="btn btn-quiet mt-2" hidden>
    Retry saving
  </button>
  <div data-draft-conflict class="mt-2" hidden>
    <p>
      Your account has different answers saved from another tab or device. Your
      answers here have been kept. Choose which version to continue with.
    </p>
    <button type="button" data-draft-keep-local class="btn btn-quiet mt-2">
      Keep these answers
    </button>
    <button type="button" data-draft-use-account class="btn btn-quiet mt-2">
      Use account answers
    </button>
  </div>
</div>
