---
interface Props {
  counts: { pending: number; expired: number };
}
const { counts } = Astro.props;
---

<section class="volunteer-panel" data-event-notifications>
  <h2>Event notifications</h2>
  <p>{counts.pending} notifications awaiting delivery.</p>
  {
    Boolean(counts.expired) && (
      <p>
        {counts.expired} notifications expired and cannot be retried. Contact
        the recipients directly.
      </p>
    )
  }
  <form data-retry-notifications action="/api/v1/events/action" method="post">
    <p data-form-message role="status" hidden></p>
    <button class="btn btn-outline" type="submit" data-loading-label="Retrying…"
      >Retry pending notifications</button
    >
  </form>
</section>
