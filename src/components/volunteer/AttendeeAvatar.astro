---
import type { AttendeeCategory } from "@/data/event-roster";
interface Props {
  category: AttendeeCategory;
  booked?: boolean;
}
const { category, booked = true } = Astro.props;
const label = `${category === "medic" ? "Approved medic" : category === "orientee" ? "Orientee" : "Volunteer"}: ${booked ? "registered" : "reserved place available"}`;
---

<span
  class:list={[
    "attendee-avatar",
    `attendee-${category}`,
    { "attendee-booked": booked },
  ]}
  role="img"
  aria-label={label}
  title={label}
>
  <svg
    viewBox="0 0 24 24"
    aria-hidden="true"
    focusable="false"
    stroke="currentColor"
    stroke-width="1.15"
    stroke-linejoin="round"
  >
    <circle cx="12" cy="6" r="3.5"></circle>
    <path d="M5 22v-5a7 7 0 0 1 14 0v5Z"></path>
  </svg>
</span>

<style>
  .attendee-avatar {
    display: inline-flex;
    width: var(--attendee-avatar-width);
    height: 1.5rem;
    flex: 0 0 var(--attendee-avatar-width);
  }
  svg {
    width: 100%;
    height: 100%;
    fill: none;
  }
  .attendee-booked svg {
    fill: currentColor;
  }
  .attendee-medic {
    color: #f87171;
  }
  .attendee-volunteer {
    color: #4ade80;
  }
  .attendee-orientee {
    color: #60a5fa;
  }
</style>
