---
import type { AttendeeCategory } from "@/data/event-roster";
interface Props {
  category: AttendeeCategory;
  decorative?: boolean;
}
const { category, decorative = false } = Astro.props;
const label = `${category === "medic" ? "Approved medic" : category === "orientee" ? "Orientee" : "Volunteer"}: registered`;
---

<span
  class:list={["attendee-avatar", `attendee-${category}`]}
  role={decorative ? undefined : "img"}
  aria-hidden={decorative ? "true" : undefined}
  aria-label={decorative ? undefined : label}
  title={decorative ? undefined : label}
>
  <svg viewBox="5 2.5 14 19.5" aria-hidden="true" focusable="false">
    <circle cx="12" cy="6" r="3.5" fill="currentColor" stroke="none"></circle>
    <path d="M5 22v-5a7 7 0 0 1 14 0v5Z" fill="currentColor" stroke="none"
    ></path>
    {
      category === "medic" && (
        <path
          d="M10.75 12.25h2.5v2.5h2.5v2.5h-2.5v2.5h-2.5v-2.5h-2.5v-2.5h2.5Z"
          fill="#fff"
          stroke="none"
        />
      )
    }
  </svg>
</span>

<style>
  .attendee-avatar {
    display: inline-flex;
    height: var(--attendee-avatar-height, 1.5rem);
    aspect-ratio: 14 / 19.5;
    flex: 0 0 auto;
  }
  svg {
    width: 100%;
    height: 100%;
  }
  .attendee-medic {
    color: #b91c1c;
  }
  .attendee-volunteer {
    color: #15803d;
  }
  .attendee-orientee {
    color: #1d4ed8;
  }
</style>
