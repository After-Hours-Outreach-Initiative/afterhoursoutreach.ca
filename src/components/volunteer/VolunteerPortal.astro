---
import { env } from "cloudflare:workers";
import {
  accountContext,
  canViewEvents,
  requireOrganizer,
} from "@/server/db/access";
import {
  listEvents,
  listRosters,
  listPublicRosters,
  listPatrolSeries,
} from "@/server/db/events";
import { eventViewVersion } from "@/server/events/version";
import AccountLayout from "./AccountLayout.astro";
import SignInPanel from "./SignInPanel.astro";
import EventCard from "./EventCard.astro";
import EventEditor from "./EventEditor.astro";
import PatrolSeriesCard from "./PatrolSeriesCard.astro";
import {
  eventFilter,
  matchesEventFilter,
  groupManagementEvents,
} from "@/data/event-browser";
import VolunteerProfileDialog from "./VolunteerProfileDialog.astro";
import DiscordIcon from "@/components/icons/DiscordIcon.astro";
import PlusIcon from "@/components/icons/PlusIcon.astro";
import WarningIcon from "@/components/icons/WarningIcon.astro";
import ArrowRightIcon from "@/components/icons/ArrowRightIcon.astro";
import { social } from "@/data/site";
import "@/styles/volunteer.css";

interface Props {
  account: Awaited<ReturnType<typeof accountContext>>;
  manage?: boolean;
}
const { manage = false } = Astro.props;
const { actor, email, greetingName } = Astro.props.account;
const title = manage
  ? "Manage events"
  : !actor && Astro.url.pathname.replace(/\/$/, "") === "/volunteer"
    ? "Volunteer"
    : "Events";
let organizer = false;
try {
  requireOrganizer(actor);
  organizer = true;
} catch {
  /* Organizer actions remain locked. */
}
const events = await listEvents(
  env.DB,
  actor,
  Astro.url.searchParams.get("occurrence") ?? undefined,
  manage ? "manage" : "volunteer",
);
const management = manage && organizer;
const series = management && actor ? await listPatrolSeries(env.DB, actor) : [];
const eventAccess = canViewEvents(actor);
const rosters =
  management && actor
    ? await listRosters(
        env.DB,
        actor,
        events.map((event) => event.id),
      )
    : [];
const publicRoster =
  !management && eventAccess && actor
    ? await listPublicRosters(
        env.DB,
        actor,
        events.map((event) => event.id),
      )
    : undefined;
const eventVersion = await eventViewVersion(
  events,
  actor,
  rosters,
  Date.now(),
  series,
  publicRoster,
);
const destinations = events.filter(
  (event) =>
    event.startsAt > Date.now() &&
    event.open &&
    !event.hidden &&
    event.inSignupWindow &&
    !event.cancelledAt,
);
// Legacy ?type=patrol now means all patrols, including those with orientation.
const filter = eventFilter(Astro.url.searchParams.get("type"), management);
const managementItems = management ? groupManagementEvents(events, series) : [];
const selectedOccurrence = Astro.url.searchParams.get("occurrence");
const hasVisibleEvents = management
  ? managementItems.some((item) =>
      matchesEventFilter(
        filter,
        item.kind === "series",
        item.kind === "series"
          ? Boolean(item.series.includesOrientation) ||
              item.events.some((event) => Boolean(event.includesOrientation))
          : Boolean(item.event.includesOrientation),
      ),
    )
  : events.some((event) =>
      matchesEventFilter(
        filter,
        Boolean(event.seriesId),
        Boolean(event.includesOrientation),
      ),
    );
---

<AccountLayout
  title={title}
  description="Volunteer with After Hours Outreach Initiative, doing evening street outreach in Vancouver's Downtown Eastside."
  signedIn={Boolean(actor)}
  organizer={actor?.role === "organizer"}
  name={actor?.name}
  greetingName={greetingName}
  email={email}
  publicSpacing={!actor}
>
  <Fragment slot="heading">
    {
      !manage && (
        <h1 class:list={["max-w-4xl text-blue", { "sr-only": eventAccess }]}>
          {title}
        </h1>
      )
    }
  </Fragment>
  {
    manage && (
      <a class="volunteer-back-link" href="/events">
        <ArrowRightIcon class="size-[1.25em] shrink-0 rotate-180" />
        <span>View events</span>
      </a>
    )
  }
  <div
    data-event-browser
    data-event-view={manage ? "manage" : "volunteer"}
    data-event-version={eventVersion}
    data-event-access={String(eventAccess)}
  >
    {
      !actor ? (
        <div class="volunteer-introduction">
          <p class="mt-8 max-w-3xl text-zinc-300">
            Our volunteers are community advocates, people with lived experience
            of recovery, first responders, healthcare workers, students heading
            into healthcare, and people who simply wanted to help out at night.
          </p>
          <p class="mt-6 max-w-3xl text-zinc-300">
            Patrols typically run Tuesdays and Thursdays, 8:30 PM to midnight.
            How often we go out depends on how many volunteers are available and
            what supplies we have on hand.
          </p>
          <p class="mt-6 max-w-3xl text-zinc-300">
            Sign in or create an account below to apply or register for
            volunteer events.
          </p>

          <SignInPanel returnTo={`/events${Astro.url.search}`} />
        </div>
      ) : !actor.applicationSubmitted ? (
        <section class="volunteer-panel">
          <h2>Welcome to After Hours Outreach</h2>
          <p>
            Thanks for your interest in volunteering. Complete your application
            so an organizer can review it. Once approved, you can view upcoming
            events and sign up for an orientation.
          </p>
          <a class="volunteer-application-warning" href="/apply">
            <WarningIcon class="volunteer-warning-icon" />
            <span class="volunteer-application-warning-text">
              Please complete your Volunteer Application
            </span>
            <svg
              class="volunteer-application-warning-arrow"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M5 12h14m-6-6 6 6-6 6" />
            </svg>
          </a>
        </section>
      ) : !actor.active ? (
        <p class="volunteer-notice" role="status">
          Your volunteer account is inactive. Contact an organizer to restore
          access.
        </p>
      ) : !actor.applicationApproved && actor.role !== "organizer" ? (
        <section class="volunteer-panel" data-application-pending>
          <h2 class="flex items-center gap-4">
            <svg
              class="size-12 shrink-0 text-green-400"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
              focusable="false"
            >
              <circle cx="12" cy="12" r="10" />
              <path d="m9 12 2 2 4-4" />
            </svg>
            Application Submitted
          </h2>
          <p>
            We'll review your application and email you at{" "}
            <strong>{email}</strong> to let you know whether it's approved and
            what to do next.
          </p>
          <p>You can see your submitted application on the account page.</p>
          <a class="btn btn-outline mt-6" href="/volunteer/account">
            View Account
            <ArrowRightIcon class="btn-icon" />
          </a>
        </section>
      ) : null
    }
    {
      !eventAccess && (
        <>
          <p class="mt-12 max-w-3xl text-zinc-300">
            Join our Discord for more information and to become more involved.
          </p>
          <div class="mt-6 flex flex-wrap gap-3.5 max-sm:flex-col">
            <a
              class="btn btn-primary"
              href={social.discord}
              target="_blank"
              rel="noreferrer"
            >
              <DiscordIcon class="btn-icon fill-current" />
              Join Discord
            </a>
          </div>
        </>
      )
    }
    {
      manage && actor?.role === "organizer" && !organizer && (
        <p class="volunteer-notice">
          Organizer tools require an active application. If you enabled an
          authenticator, finish signing in with it.{" "}
          <a href="/volunteer/account">Go to Your account</a>.
        </p>
      )
    }
    {
      eventAccess && (
        <section class="volunteer-events" aria-labelledby="events-heading">
          <div class="volunteer-section-heading">
            <div>
              {manage ? (
                <h1 id="events-heading">Manage events</h1>
              ) : (
                <h2 id="events-heading">Events</h2>
              )}
            </div>
            {management ? (
              <button
                class="btn btn-primary"
                data-show-dialog="event-editor-new"
                type="button"
              >
                <PlusIcon class="btn-icon" />
                Create
              </button>
            ) : actor?.role === "organizer" ? (
              <a class="btn btn-primary" href="/manage/events">
                Manage events
                <ArrowRightIcon class="btn-icon" />
              </a>
            ) : null}
          </div>
          <form
            class="volunteer-filters"
            method="get"
            role="group"
            aria-label="Filter events"
          >
            {[
              ["all", "All events"],
              ...(management
                ? [
                    ["one-off", "One-off events"],
                    ["recurring", "Recurring series"],
                  ]
                : []),
              ["orientation", "Includes orientation"],
            ].map(([type, label]) => (
              <button
                class="volunteer-filter"
                type="submit"
                name="type"
                value={type}
                data-event-filter={type}
                aria-pressed={filter === type ? "true" : "false"}
              >
                {label}
              </button>
            ))}
          </form>
          <ul class="volunteer-event-list" data-event-list>
            {management
              ? managementItems.map((item) =>
                  item.kind === "series" ? (
                    <PatrolSeriesCard
                      series={item.series}
                      events={item.events}
                      actor={actor}
                      rosters={rosters}
                      destinations={destinations}
                      filter={filter}
                      selectedOccurrence={selectedOccurrence}
                    />
                  ) : (
                    <EventCard
                      event={item.event}
                      actor={actor}
                      organizer
                      roster={rosters.filter(
                        (person) => person.eventId === item.event.id,
                      )}
                      destinations={destinations}
                      filter={filter}
                    />
                  ),
                )
              : events.map((event) => (
                  <EventCard
                    event={event}
                    actor={actor}
                    organizer={management}
                    publicRoster={publicRoster?.people.filter(
                      (person) => person.eventId === event.id,
                    )}
                    roster={rosters.filter(
                      (person) => person.eventId === event.id,
                    )}
                    destinations={destinations}
                    filter={filter}
                    series={series.find((item) => item.id === event.seriesId)}
                  />
                ))}
          </ul>
          <p
            class="volunteer-notice"
            data-empty-events
            role="status"
            hidden={hasVisibleEvents}
          >
            {events.length || series.length
              ? "No upcoming events match this filter. Check back soon."
              : "No upcoming events are scheduled. Check back soon."}
          </p>
          <p
            class="volunteer-help"
            data-event-limit
            hidden={events.length !== 100}
          >
            {management
              ? "Showing up to 100 loaded occurrences and one-off events. Open any other recurring date from its series settings."
              : "Showing up to 100 events."}
          </p>
        </section>
      )
    }
    {
      management && (
        <>
          <EventEditor />
          <VolunteerProfileDialog />
        </>
      )
    }
  </div>
  <noscript
    ><p class="volunteer-notice">
      JavaScript is required to save changes and register for events.
    </p></noscript
  >
</AccountLayout>
<script>
  import "@/scripts/volunteer";
</script>
