---
import { env } from "cloudflare:workers";
import {
  accountContext,
  canViewEvents,
  requireOrganizer,
} from "@/server/db/access";
import { forwardCookies } from "@/server/auth";
import { listEvents, listRosters, listPatrolSeries } from "@/server/db/events";
import { eventViewVersion } from "@/server/events/version";
import AccountLayout from "./AccountLayout.astro";
import SignInPanel from "./SignInPanel.astro";
import EventCard from "./EventCard.astro";
import EventEditor from "./EventEditor.astro";
import PatrolSeriesControls from "./PatrolSeriesControls.astro";
import VolunteerProfileDialog from "./VolunteerProfileDialog.astro";
import DiscordIcon from "@/components/icons/DiscordIcon.astro";
import PlusIcon from "@/components/icons/PlusIcon.astro";
import WarningIcon from "@/components/icons/WarningIcon.astro";
import { social } from "@/data/site";
import "@/styles/volunteer.css";

const { actor, headers, email, greetingName } = await accountContext(
  env,
  Astro.request,
);
forwardCookies(headers, Astro.response.headers);
let organizer = false;
try {
  requireOrganizer(actor);
  organizer = true;
} catch {
  /* Organizer actions remain locked. */
}
const events = await listEvents(
  env.DB,
  actor,
  Astro.url.searchParams.get("occurrence") ?? undefined,
);
const series = organizer && actor ? await listPatrolSeries(env.DB, actor) : [];
const eventAccess = canViewEvents(actor);
const rosters =
  organizer && actor
    ? await listRosters(
        env.DB,
        actor,
        events.map((event) => event.id),
      )
    : [];
const eventVersion = await eventViewVersion(
  events,
  actor,
  rosters,
  Date.now(),
  series,
);
const destinations = events.filter(
  (event) =>
    event.startsAt > Date.now() &&
    event.open &&
    !event.hidden &&
    event.inSignupWindow &&
    !event.cancelledAt,
);
const filter = ["patrol", "orientation"].includes(
  Astro.url.searchParams.get("type") ?? "",
)
  ? Astro.url.searchParams.get("type")!
  : "all";
---

<AccountLayout
  title="Volunteer"
  description="Volunteer with After Hours Outreach Initiative, doing evening street outreach in Vancouver's Downtown Eastside."
  signedIn={Boolean(actor)}
  organizer={actor?.role === "organizer"}
  name={actor?.name}
  greetingName={greetingName}
  email={email}
  publicSpacing={!actor}
>
  <h1
    slot="heading"
    class:list={["max-w-4xl text-blue", { "sr-only": Boolean(actor) }]}
  >
    Volunteer
  </h1>
  <div
    data-event-browser
    data-event-version={eventVersion}
    data-event-access={String(eventAccess)}
  >
    {
      !actor ? (
        <div class="volunteer-introduction">
          <p class="mt-8 max-w-3xl text-zinc-300">
            Our volunteers are community advocates, people with lived experience
            of recovery, first responders, healthcare workers, students heading
            into healthcare, and people who simply wanted to help out at night.
          </p>
          <p class="mt-6 max-w-3xl text-zinc-300">
            Patrols typically run Tuesdays and Thursdays, 8:30 PM to midnight.
            How often we go out depends on how many volunteers are available and
            what supplies we have on hand.
          </p>
          <p class="mt-6 max-w-3xl text-zinc-300">
            Sign in or create an account below to apply or register for
            volunteer events.
          </p>

          <SignInPanel returnTo="/volunteer" />
        </div>
      ) : !actor.applicationSubmitted ? (
        <section class="volunteer-panel">
          <h2>Welcome to After Hours Outreach</h2>
          <p>
            Thanks for your interest in volunteering. Complete your application
            so an organizer can review it. Once approved, you can view upcoming
            events and sign up for an orientation.
          </p>
          <a class="volunteer-application-warning" href="/apply">
            <WarningIcon class="volunteer-warning-icon" />
            <span class="volunteer-application-warning-text">
              Please complete your Volunteer Application
            </span>
            <svg
              class="volunteer-application-warning-arrow"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M5 12h14m-6-6 6 6-6 6" />
            </svg>
          </a>
        </section>
      ) : !actor.active ? (
        <p class="volunteer-notice" role="status">
          Your volunteer account is inactive. Contact an organizer to restore
          access.
        </p>
      ) : !actor.applicationApproved && actor.role !== "organizer" ? (
        <section class="volunteer-panel" data-application-pending>
          <h2>Application awaiting approval</h2>
          <p>
            An organizer will review your application before you can view events
            or sign up for an orientation.
          </p>
          <p>
            You can review your submitted application and update your profile
            while you wait.
          </p>
          <a class="btn btn-outline mt-6" href="/volunteer/account">
            Review application and profile
          </a>
        </section>
      ) : null
    }
    {
      !eventAccess && (
        <>
          <p class="mt-12 max-w-3xl text-zinc-300">
            Join our Discord for more information and to become more involved.
          </p>
          <div class="mt-6 flex flex-wrap gap-3.5 max-sm:flex-col">
            <a
              class="btn btn-primary"
              href={social.discord}
              target="_blank"
              rel="noreferrer"
            >
              <DiscordIcon class="btn-icon fill-current" />
              Join Discord
            </a>
          </div>
        </>
      )
    }
    {
      actor?.role === "organizer" && !organizer && (
        <p class="volunteer-notice">
          Organizer tools require an active application. If you enabled an
          authenticator, finish signing in with it.{" "}
          <a href="/volunteer/account">Go to Your account</a>.
        </p>
      )
    }
    {
      eventAccess && (
        <section class="volunteer-events" aria-labelledby="events-heading">
          <div class="volunteer-section-heading">
            <div>
              <h2 id="events-heading">
                {organizer ? "Events" : "Upcoming events"}
              </h2>
            </div>
            {organizer && (
              <button
                class="btn btn-primary"
                data-show-dialog="event-editor-new"
                type="button"
              >
                <PlusIcon class="btn-icon" />
                Add an event
              </button>
            )}
          </div>
          <form
            class="volunteer-filters"
            method="get"
            role="group"
            aria-label="Filter events"
          >
            {[
              ["all", "All events"],
              ["orientation", "Orientations"],
              ["patrol", "Patrols"],
            ].map(([type, label]) => (
              <button
                class="volunteer-filter"
                type="submit"
                name="type"
                value={type}
                data-event-filter={type}
                aria-pressed={filter === type ? "true" : "false"}
              >
                {label}
              </button>
            ))}
          </form>
          <ul class="volunteer-event-list" data-event-list>
            {events.map((event) => (
              <EventCard
                event={event}
                actor={actor}
                organizer={organizer}
                roster={rosters.filter((person) => person.eventId === event.id)}
                destinations={destinations}
                filter={filter}
                series={series.find((item) => item.id === event.seriesId)}
              />
            ))}
          </ul>
          <p
            class="volunteer-notice"
            data-empty-events
            role="status"
            hidden={events.some(
              (event) => filter === "all" || event.type === filter,
            )}
          >
            {events.length
              ? "No upcoming events match this filter. Check back soon."
              : "No upcoming events are scheduled. Check back soon."}
          </p>
          <p
            class="volunteer-help"
            data-event-limit
            hidden={events.length !== 100}
          >
            Showing up to 100 events.
          </p>
        </section>
      )
    }
    {
      organizer && (
        <>
          <EventEditor />
          <PatrolSeriesControls series={series} />
          <VolunteerProfileDialog />
        </>
      )
    }
  </div>
  <noscript
    ><p class="volunteer-notice">
      JavaScript is required to save changes and register for events.
    </p></noscript
  >
</AccountLayout>
<script>
  import "@/scripts/volunteer";
</script>
