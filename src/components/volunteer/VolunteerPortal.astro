---
import { env } from "cloudflare:workers";
import {
  accountContext,
  canViewEvents,
  requireOrganizer,
} from "@/server/db/access";
import {
  listEvents,
  listRosters,
  listPublicRosters,
  listPatrolSeries,
} from "@/server/db/events";
import { eventViewVersion } from "@/server/events/version";
import { countReadyApplications, listVolunteers } from "@/server/db/volunteers";
import { listViewerEvents, type EventViewer } from "@/server/events/view-as";
import ViewAsMenu from "./ViewAsMenu.astro";
import VolunteerRoleBadge from "./VolunteerRoleBadge.astro";
import RosterPerson from "./RosterPerson.astro";
import AccountLayout from "./AccountLayout.astro";
import EventCard from "./EventCard.astro";
import EventCalendar from "./EventCalendar.astro";
import EventEditor from "./EventEditor.astro";
import BulkEventEditor from "./BulkEventEditor.astro";
import PatrolSeriesCard from "./PatrolSeriesCard.astro";
import { groupManagementEvents } from "@/data/event-browser";
import ApplicationProgress from "./ApplicationProgress.astro";
// Discord connection is temporarily disabled.
// import DiscordConnectionNotice from "./DiscordConnectionNotice.astro";
import SubmittedApplication from "./SubmittedApplication.astro";
import { loadSubmittedApplication } from "@/server/db/profiles";
import {
  isApplicationComplete,
  loadApplicationProgress,
} from "@/server/db/application-progress";
import DiscordIcon from "@/components/icons/DiscordIcon.astro";
import PlusIcon from "@/components/icons/PlusIcon.astro";
import { contactEmail, social } from "@/data/site";
import "@/styles/volunteer.css";

interface Props {
  account: Awaited<ReturnType<typeof accountContext>>;
  manage?: boolean;
  /** An organizer's read-only preview of another viewer's event list. */
  viewer?: EventViewer | null;
}
const { viewer = null } = Astro.props;
const manage = !viewer && (Astro.props.manage ?? false);
const { actor, email, greetingName } = Astro.props.account;
// Callers authenticate first. Organizer controls always require authorization.
if (!actor) throw new Error("VolunteerPortal requires a signed-in account.");
if (manage || viewer) requireOrganizer(actor);
// Events are listed for the previewed viewer; the account itself stays the organizer.
const subject = viewer?.actor ?? actor;
const events = viewer
  ? await listViewerEvents(env.DB, viewer, "volunteer")
  : await listEvents(
      env.DB,
      actor,
      Astro.url.searchParams.get("occurrence") ?? undefined,
      manage ? "manage-upcoming" : "volunteer",
    );
const pastEvents = viewer
  ? await listViewerEvents(env.DB, viewer, "past")
  : await listEvents(
      env.DB,
      actor,
      manage
        ? (Astro.url.searchParams.get("occurrence") ?? undefined)
        : undefined,
      manage ? "manage-past" : "past",
    );
const series = manage ? await listPatrolSeries(env.DB, actor) : [];
const eventAccess = canViewEvents(subject);
const viewAsPeople =
  manage || viewer
    ? (await listVolunteers(env.DB, actor, "", "name")).allRows
        .filter((person) => person.active && person.applicationApproved)
        .map(({ id, name, searchName, role, category, medicMark }) => ({
          id,
          name,
          searchName,
          role,
          category,
          medicMark: Boolean(medicMark),
        }))
    : [];
const readyApplicationCount =
  actor.role === "organizer" && eventAccess
    ? await countReadyApplications(env.DB, actor)
    : 0;
const showApplicationProgress =
  !manage && !viewer && (!actor.twoFactorEnabled || actor.twoFactorVerified);
const applicationProgress = showApplicationProgress
  ? await loadApplicationProgress(env.DB, actor.id)
  : null;
const incompleteApplication =
  applicationProgress && !isApplicationComplete(applicationProgress);
const submission =
  incompleteApplication && applicationProgress.submittedAt !== null
    ? await loadSubmittedApplication(env.DB, actor.id)
    : null;
const title =
  incompleteApplication && actor.role !== "organizer" && !actor.patrolApproved
    ? "Welcome"
    : "Events";
const rosters = manage
  ? await listRosters(
      env.DB,
      actor,
      [...events, ...(manage ? pastEvents : [])].map((event) => event.id),
    )
  : [];
const publicRoster =
  !manage && eventAccess
    ? await listPublicRosters(
        env.DB,
        subject,
        events.map((event) => event.id),
      )
    : undefined;
const eventVersion = await eventViewVersion(
  [...events, ...pastEvents],
  subject,
  rosters,
  Date.now(),
  series,
  publicRoster,
);
const destinations = events.filter(
  (event) =>
    event.startsAt > Date.now() &&
    event.open &&
    !event.hidden &&
    event.inSignupWindow &&
    !event.cancelledAt,
);
const seriesItems = manage
  ? groupManagementEvents(events, series).filter(
      (item) => item.kind === "series",
    )
  : [];
---

<AccountLayout
  title={title}
  description="Volunteer with After Hours Outreach Initiative, doing evening street outreach in Vancouver's Downtown Eastside."
  signedIn
  organizer={actor.role === "organizer"}
  eventAccess={eventAccess}
  {readyApplicationCount}
  name={actor.name}
  greetingName={greetingName}
  email={email}
>
  <Fragment slot="heading">
    {!manage && !viewer && (
      <h1
        data-portal-heading
        class:list={[
          "max-w-4xl text-2xl md:text-4xl",
          {
            "sr-only": eventAccess,
          },
        ]}
      >
        {title}
      </h1>
    )}
  </Fragment>
  <div
    data-event-browser
    data-event-view={manage ? "manage" : "volunteer"}
    data-event-view-as={viewer?.value}
    data-event-version={eventVersion}
    data-event-access={String(eventAccess)}
    data-event-path={eventAccess ? Astro.url.pathname : "/volunteer"}
    data-application-awaiting-approval={String(
      Boolean(
        actor.applicationSubmitted &&
        actor.active &&
        !actor.applicationApproved &&
        actor.role !== "organizer",
      ),
    )}
  >
    {/* Discord connection is temporarily disabled.
    {
      !manage && actor.applicationComplete && (
        <DiscordConnectionNotice userId={actor.id} />
      )
    }
    */}
    {actor.applicationSubmitted && !actor.active && (
      <p class="volunteer-notice" role="status">
        Your volunteer account is inactive. Contact an organizer at{" "}
        <a href={`mailto:${contactEmail}`}>{contactEmail}</a> to restore access.
      </p>
    )}
    {applicationProgress && incompleteApplication && (
      <>
        {title === "Welcome" && (
          <p class="mt-6 max-w-3xl text-zinc-300">
            Thanks for your interest in volunteering. Please complete the steps
            below to complete your application.
          </p>
        )}
        <ApplicationProgress
          progress={applicationProgress}
          userId={actor.id}
          idPrefix="events"
          {email}
        >
          <Fragment slot="application">
            {submission ? (
              <SubmittedApplication submission={submission} embedded />
            ) : (
              <p class="text-base">
                Your application form was submitted. The original submitted
                answers were not captured for this account.
              </p>
            )}
          </Fragment>
        </ApplicationProgress>
      </>
    )}
    {!eventAccess && (
      <>
        <p class="mt-12 max-w-3xl text-zinc-300">
          Join our Discord for the most up-to-date information.
        </p>
        <div class="mt-6 flex flex-wrap gap-3.5 max-sm:flex-col">
          <a
            class="btn btn-primary"
            href={social.discord}
            target="_blank"
            rel="noreferrer"
          >
            <DiscordIcon class="btn-icon fill-current" />
            Join Discord
          </a>
        </div>
      </>
    )}
    {eventAccess && (
      <section class="volunteer-events" aria-labelledby="events-heading">
        <div class="volunteer-section-heading">
          <div>
            {manage || viewer ? (
              <h1 id="events-heading">Events</h1>
            ) : (
              <h2 id="events-heading">Events</h2>
            )}
          </div>
          {viewer && (
            <div class="volunteer-event-tools">
              <ViewAsMenu people={viewAsPeople} current={viewer} />
            </div>
          )}
          {manage && (
            <div class="volunteer-event-tools volunteer-event-manage-tools">
              <ViewAsMenu people={viewAsPeople} current={null} />
              <button
                class="btn btn-quiet"
                type="button"
                data-bulk-select-mode
                aria-pressed="false"
              >
                Select
              </button>
            </div>
          )}
          {manage && (
            <button
              class="btn btn-primary volunteer-event-create"
              data-show-dialog="event-editor-new"
              type="button"
            >
              <PlusIcon class="btn-icon" />
              Create
            </button>
          )}
        </div>
        {viewer && (
          <div class="volunteer-notice view-as-notice" data-view-as-notice>
            <div class="view-as-viewer">
              Viewing events as
              {viewer.person ? (
                <RosterPerson
                  name={viewer.label}
                  category={viewer.person.category}
                  medicMark={viewer.person.medicMark}
                >
                  {viewer.actor.role === "organizer" && (
                    <VolunteerRoleBadge role="organizer" />
                  )}
                  {(viewer.person.category === "medic" ||
                    viewer.person.medicMark) && (
                    <VolunteerRoleBadge role="medic" />
                  )}
                </RosterPerson>
              ) : (
                <strong>{viewer.label}</strong>
              )}
            </div>
            <a href="/events">Back to managing events</a>
          </div>
        )}
        <div class="volunteer-event-schedule">
          <EventCalendar
            events={events.map((event) => ({
              id: event.id,
              startsAt: event.startsAt,
              label: `${event.includesOrientation ? "Orientation + Patrol" : "Patrol"} at ${event.meetingPoint}`,
            }))}
          />
          <div class="volunteer-event-results">
            {manage && <BulkEventEditor />}
            <ul class="volunteer-event-list" data-event-list>
              {events.map((event) => (
                <EventCard
                  event={event}
                  actor={subject}
                  organizer={manage}
                  preview={Boolean(viewer)}
                  publicRoster={publicRoster?.people.filter(
                    (person) => person.eventId === event.id,
                  )}
                  roster={rosters.filter(
                    (person) => person.eventId === event.id,
                  )}
                  destinations={destinations}
                  series={series.find((item) => item.id === event.seriesId)}
                />
              ))}
            </ul>
            <p
              class="volunteer-notice"
              data-empty-events
              role="status"
              hidden={events.length > 0}
            >
              No upcoming events are scheduled. Check back soon.
            </p>
            <p
              class="volunteer-help"
              data-event-limit
              hidden={events.length !== 100}
            >
              {manage
                ? "Showing up to 100 events. Open another date under Manage recurring series."
                : "Showing up to 100 events."}
            </p>
          </div>
        </div>
        {manage && (
          <details class="volunteer-series-management" data-series-management>
            <summary>Manage recurring series</summary>
            <ul class="volunteer-event-list" data-series-list>
              {seriesItems.map((item) => (
                <PatrolSeriesCard series={item.series} events={item.events} />
              ))}
            </ul>
            <p
              class="volunteer-help"
              data-empty-series
              hidden={seriesItems.length > 0}
            >
              No recurring series have been created.
            </p>
          </details>
        )}
      </section>
    )}
    {eventAccess && pastEvents.length > 0 && (
      <section class="volunteer-events" aria-labelledby="past-events-heading">
        <div class="volunteer-section-heading">
          <h2 id="past-events-heading">Past events</h2>
        </div>
        <ul class="volunteer-event-list" data-past-event-list>
          {pastEvents.map((event) => (
            <EventCard
              event={event}
              actor={subject}
              organizer={manage}
              preview={Boolean(viewer)}
              roster={rosters.filter((person) => person.eventId === event.id)}
              destinations={[]}
            />
          ))}
        </ul>
        <p
          class="volunteer-help"
          data-past-event-limit
          hidden={pastEvents.length !== 100}
        >
          {manage
            ? "Showing up to 100 past events. Open another date under Manage recurring series."
            : "Showing the 100 most recent past events."}
        </p>
      </section>
    )}
    {manage && <EventEditor />}
  </div>
  <noscript>
    <p class="volunteer-notice">
      JavaScript is required to save changes and register for events.
    </p>
  </noscript>
</AccountLayout>
<script>
  import "@/scripts/volunteer";
</script>

<style>
  [data-event-view="manage"] [data-past-event-list] {
    grid-template-columns: minmax(0, 1fr);
  }
  .volunteer-series-management {
    margin-top: 1.5rem;
    padding: 0.75rem 1rem;
    border: 1px solid #3f3f46;
    border-radius: 0.5rem;
  }
  .volunteer-series-management > summary {
    min-height: 2rem;
    color: #d4d4d8;
    cursor: pointer;
  }
  .volunteer-series-management > summary:focus-visible {
    outline: 3px solid #a5b4fc;
    outline-offset: 0.25rem;
  }
  .volunteer-series-management > ul {
    margin-top: 1rem;
  }
  .volunteer-event-schedule {
    container: event-schedule / inline-size;
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    gap: 1.125rem;
  }
  .volunteer-event-results {
    min-width: 0;
  }
  .view-as-notice {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem 1rem;
    margin-bottom: 1.5rem;
  }
  .view-as-viewer {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.25rem 0.5rem;
  }
  .view-as-viewer :global(.event-roster-name) {
    flex: none;
    font-weight: 700;
  }
  .volunteer-event-tools {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }
  /* Create sits beside the tools, after a flexible gap after the title. */
  .volunteer-section-heading:has(> .volunteer-event-create) {
    column-gap: 0.75rem;
  }
  .volunteer-section-heading:has(> .volunteer-event-create) > :first-child {
    margin-right: auto;
  }
  /* On narrow screens Create stays beside the title; the other tools wrap. */
  @media (width < 48rem) {
    .volunteer-event-create {
      order: 1;
    }
    .volunteer-event-manage-tools {
      order: 2;
      flex-basis: 100%;
    }
  }
  [data-bulk-select-mode][aria-pressed="true"] {
    border-color: #818cf8;
    background: var(--color-blue-deep);
    color: #e0e7ff;
  }
  /* Keep the last cards reachable above the floating selection bar. */
  [data-event-browser][data-bulk-selecting] {
    padding-bottom: 9rem;
  }
  .volunteer-event-schedule > .volunteer-event-results {
    /* Wrap based on actual content width, including any account navigation. */
    flex: 1 1 26rem;
  }
</style>
