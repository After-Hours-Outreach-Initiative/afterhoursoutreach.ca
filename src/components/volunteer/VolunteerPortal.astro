---
import { env } from "cloudflare:workers";
import { accountContext, canViewEvents } from "@/server/db/access";
import {
  listEvents,
  listRosters,
  listPublicRosters,
  listPatrolSeries,
} from "@/server/db/events";
import { eventViewVersion } from "@/server/events/version";
import AccountLayout from "./AccountLayout.astro";
import EventCard from "./EventCard.astro";
import EventCalendar from "./EventCalendar.astro";
import EventEditor from "./EventEditor.astro";
import PatrolSeriesCard from "./PatrolSeriesCard.astro";
import {
  eventFilter,
  matchesEventFilter,
  groupManagementEvents,
} from "@/data/event-browser";
import VolunteerProfileDialog from "./VolunteerProfileDialog.astro";
import ApplicationProgress from "./ApplicationProgress.astro";
import SubmittedApplication from "./SubmittedApplication.astro";
import { loadSubmittedApplication } from "@/server/db/profiles";
import {
  isApplicationComplete,
  loadApplicationProgress,
} from "@/server/db/application-progress";
import DiscordIcon from "@/components/icons/DiscordIcon.astro";
import PlusIcon from "@/components/icons/PlusIcon.astro";
import ArrowRightIcon from "@/components/icons/ArrowRightIcon.astro";
import { contactEmail } from "@/data/site";
import "@/styles/volunteer.css";

interface Props {
  account: Awaited<ReturnType<typeof accountContext>>;
  manage?: boolean;
}
const { manage = false } = Astro.props;
const { actor, email, greetingName } = Astro.props.account;
// Callers authenticate first; the manage route also requires organizer access.
if (!actor) throw new Error("VolunteerPortal requires a signed-in account.");
const events = await listEvents(
  env.DB,
  actor,
  Astro.url.searchParams.get("occurrence") ?? undefined,
  manage ? "manage" : "volunteer",
);
const pastEvents = manage
  ? []
  : await listEvents(env.DB, actor, undefined, "past");
const series = manage ? await listPatrolSeries(env.DB, actor) : [];
const eventAccess = canViewEvents(actor);
const showApplicationProgress =
  !manage && (!actor.twoFactorEnabled || actor.twoFactorVerified);
const applicationProgress = showApplicationProgress
  ? await loadApplicationProgress(env.DB, actor.id)
  : null;
const incompleteApplication =
  applicationProgress && !isApplicationComplete(applicationProgress);
const submission =
  incompleteApplication && applicationProgress.submittedAt !== null
    ? await loadSubmittedApplication(env.DB, actor.id)
    : null;
const title = manage
  ? "Manage events"
  : incompleteApplication && actor.role !== "organizer" && !actor.patrolApproved
    ? "Welcome"
    : "Events";
const rosters = manage
  ? await listRosters(
      env.DB,
      actor,
      events.map((event) => event.id),
    )
  : [];
const publicRoster =
  !manage && eventAccess
    ? await listPublicRosters(
        env.DB,
        actor,
        events.map((event) => event.id),
      )
    : undefined;
const eventVersion = await eventViewVersion(
  [...events, ...pastEvents],
  actor,
  rosters,
  Date.now(),
  series,
  publicRoster,
);
const destinations = events.filter(
  (event) =>
    event.startsAt > Date.now() &&
    event.open &&
    !event.hidden &&
    event.inSignupWindow &&
    !event.cancelledAt,
);
// Legacy ?type=patrol now means all patrols, including those with orientation.
const filter = eventFilter(Astro.url.searchParams.get("type"), manage);
const managementItems = manage ? groupManagementEvents(events, series) : [];
const selectedOccurrence = Astro.url.searchParams.get("occurrence");
const hasVisibleEvents = manage
  ? managementItems.some((item) =>
      matchesEventFilter(
        filter,
        item.kind === "series",
        item.kind === "series"
          ? Boolean(item.series.includesOrientation) ||
              item.events.some((event) => Boolean(event.includesOrientation))
          : Boolean(item.event.includesOrientation),
      ),
    )
  : events.some((event) =>
      matchesEventFilter(
        filter,
        Boolean(event.seriesId),
        Boolean(event.includesOrientation),
      ),
    );
const hasVisiblePastEvents = pastEvents.some((event) =>
  matchesEventFilter(
    filter,
    Boolean(event.seriesId),
    Boolean(event.includesOrientation),
  ),
);
---

<AccountLayout
  title={title}
  description="Volunteer with After Hours Outreach Initiative, doing evening street outreach in Vancouver's Downtown Eastside."
  signedIn
  organizer={actor.role === "organizer"}
  eventAccess={eventAccess}
  name={actor.name}
  greetingName={greetingName}
  email={email}
>
  <Fragment slot="heading">
    {
      !manage && (
        <h1
          data-portal-heading
          class:list={[
            "max-w-4xl text-2xl md:text-4xl",
            {
              "sr-only": eventAccess,
            },
          ]}
        >
          {title}
        </h1>
      )
    }
  </Fragment>
  {
    manage && (
      <a class="volunteer-back-link" href="/events">
        <ArrowRightIcon class="size-[1.25em] shrink-0 rotate-180" />
        <span>View events</span>
      </a>
    )
  }
  <div
    data-event-browser
    data-event-view={manage ? "manage" : "volunteer"}
    data-event-version={eventVersion}
    data-event-access={String(eventAccess)}
    data-event-path={manage
      ? "/manage/events"
      : eventAccess
        ? Astro.url.pathname
        : "/volunteer"}
    data-application-awaiting-approval={String(
      Boolean(
        actor.applicationSubmitted &&
        actor.active &&
        !actor.applicationApproved &&
        actor.role !== "organizer",
      ),
    )}
  >
    {
      actor.applicationSubmitted && !actor.active && (
        <p class="volunteer-notice" role="status">
          Your volunteer account is inactive. Contact an organizer at{" "}
          <a href={`mailto:${contactEmail}`}>{contactEmail}</a> to restore
          access.
        </p>
      )
    }
    {
      applicationProgress && incompleteApplication && (
        <>
          {title === "Welcome" && (
            <p class="mt-6 max-w-3xl text-zinc-300">
              Thanks for your interest in volunteering. Please complete the
              steps below to complete your application.
            </p>
          )}
          <ApplicationProgress
            progress={applicationProgress}
            userId={actor.id}
            idPrefix="events"
            {email}
          >
            <Fragment slot="application">
              {submission ? (
                <SubmittedApplication submission={submission} embedded />
              ) : (
                <p class="text-base">
                  Your application form was submitted. The original submitted
                  answers were not captured for this account.
                </p>
              )}
            </Fragment>
          </ApplicationProgress>
        </>
      )
    }
    {
      !eventAccess && (
        <>
          <p class="mt-12 max-w-3xl text-zinc-300">
            Connect your Discord identity through your account. Joining with an
            invite alone does not complete the required application step.
          </p>
          <div class="mt-6 flex flex-wrap gap-3.5 max-sm:flex-col">
            <a
              class="btn btn-primary"
              href="/volunteer/account#account-discord-heading"
            >
              <DiscordIcon class="btn-icon fill-current" />
              Manage Discord connection
            </a>
          </div>
        </>
      )
    }
    {
      eventAccess && (
        <section class="volunteer-events" aria-labelledby="events-heading">
          <div class="volunteer-section-heading">
            <div>
              {manage ? (
                <h1 id="events-heading">Manage events</h1>
              ) : (
                <h2 id="events-heading">Events</h2>
              )}
            </div>
            {manage ? (
              <button
                class="btn btn-primary"
                data-show-dialog="event-editor-new"
                type="button"
              >
                <PlusIcon class="btn-icon" />
                Create
              </button>
            ) : actor.role === "organizer" ? (
              <a class="btn btn-primary" href="/manage/events">
                Manage events
                <ArrowRightIcon class="btn-icon" />
              </a>
            ) : null}
          </div>
          <form
            class="volunteer-filters"
            method="get"
            role="group"
            aria-label="Filter events"
          >
            {[
              ["all", "All"],
              ...(manage
                ? [
                    ["one-off", "One-off events"],
                    ["recurring", "Recurring series"],
                  ]
                : []),
              ["orientation", "Orientations"],
            ].map(([type, label]) => (
              <button
                class="volunteer-filter"
                type="submit"
                name="type"
                value={type}
                data-event-filter={type}
                aria-pressed={filter === type ? "true" : "false"}
              >
                {label}
              </button>
            ))}
          </form>
          <div class:list={{ "volunteer-event-schedule": !manage }}>
            {!manage && (
              <EventCalendar
                events={events
                  .filter((event) =>
                    matchesEventFilter(
                      filter,
                      Boolean(event.seriesId),
                      Boolean(event.includesOrientation),
                    ),
                  )
                  .map((event) => ({
                    id: event.id,
                    startsAt: event.startsAt,
                    label: `${event.includesOrientation ? "Orientation + Patrol" : "Patrol"} at ${event.meetingPoint}`,
                  }))}
              />
            )}
            <div class="volunteer-event-results">
              <ul class="volunteer-event-list" data-event-list>
                {manage
                  ? managementItems.map((item) =>
                      item.kind === "series" ? (
                        <PatrolSeriesCard
                          series={item.series}
                          events={item.events}
                          actor={actor}
                          rosters={rosters}
                          destinations={destinations}
                          filter={filter}
                          selectedOccurrence={selectedOccurrence}
                        />
                      ) : (
                        <EventCard
                          event={item.event}
                          actor={actor}
                          organizer
                          roster={rosters.filter(
                            (person) => person.eventId === item.event.id,
                          )}
                          destinations={destinations}
                          filter={filter}
                        />
                      ),
                    )
                  : events.map((event) => (
                      <EventCard
                        event={event}
                        actor={actor}
                        organizer={manage}
                        publicRoster={publicRoster?.people.filter(
                          (person) => person.eventId === event.id,
                        )}
                        roster={rosters.filter(
                          (person) => person.eventId === event.id,
                        )}
                        destinations={destinations}
                        filter={filter}
                        series={series.find(
                          (item) => item.id === event.seriesId,
                        )}
                      />
                    ))}
              </ul>
              <p
                class="volunteer-notice"
                data-empty-events
                role="status"
                hidden={hasVisibleEvents}
              >
                {events.length || series.length
                  ? "No upcoming events match this filter. Check back soon."
                  : "No upcoming events are scheduled. Check back soon."}
              </p>
              <p
                class="volunteer-help"
                data-event-limit
                hidden={events.length !== 100}
              >
                {manage
                  ? "Showing up to 100 loaded occurrences and one-off events. Open another recurring date under Occurrences."
                  : "Showing up to 100 events."}
              </p>
            </div>
          </div>
        </section>
      )
    }
    {
      eventAccess && !manage && (
        <section class="volunteer-events" aria-labelledby="past-events-heading">
          <div class="volunteer-section-heading">
            <h2 id="past-events-heading">Past events</h2>
          </div>
          <ul class="volunteer-event-list" data-past-event-list>
            {pastEvents.map((event) => (
              <EventCard
                event={event}
                actor={actor}
                organizer={false}
                roster={[]}
                destinations={[]}
                filter={filter}
              />
            ))}
          </ul>
          <p
            class="volunteer-notice"
            data-empty-past-events
            role="status"
            hidden={hasVisiblePastEvents}
          >
            {pastEvents.length
              ? "No past events match this filter."
              : "No past events yet."}
          </p>
          <p
            class="volunteer-help"
            data-past-event-limit
            hidden={pastEvents.length !== 100}
          >
            Showing the 100 most recent past events.
          </p>
        </section>
      )
    }
    {
      manage && (
        <>
          <EventEditor />
          <VolunteerProfileDialog />
        </>
      )
    }
  </div>
  <noscript
    ><p class="volunteer-notice">
      JavaScript is required to save changes and register for events.
    </p></noscript
  >
</AccountLayout>
<script>
  import "@/scripts/volunteer";
</script>

<style>
  .volunteer-event-schedule {
    container: event-schedule / inline-size;
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    gap: 1.5rem;
  }
  .volunteer-event-results {
    min-width: 0;
  }
  .volunteer-event-schedule > .volunteer-event-results {
    /* Wrap based on actual content width, including any account navigation. */
    flex: 1 1 26rem;
  }
</style>
