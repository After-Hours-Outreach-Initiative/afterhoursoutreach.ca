---
import { env } from "cloudflare:workers";
import { accountContext, requireOrganizer } from "@/server/db/access";
import { forwardCookies } from "@/server/auth";
import { listEvents, listRosters } from "@/server/db/events";
import { eventViewVersion } from "@/server/events/stream";
import { countNotifications } from "@/server/db/notifications";
import AccountLayout from "./AccountLayout.astro";
import SignInPanel from "./SignInPanel.astro";
import EventCard from "./EventCard.astro";
import EventEditor from "./EventEditor.astro";
import EventNotifications from "./EventNotifications.astro";
import VolunteerProfileDialog from "./VolunteerProfileDialog.astro";
import WarningIcon from "@/components/icons/WarningIcon.astro";
import "@/styles/volunteer.css";

const { actor, headers, email } = await accountContext(env, Astro.request);
forwardCookies(headers, Astro.response.headers);
let organizer = false;
try {
  requireOrganizer(actor);
  organizer = true;
} catch {
  /* Organizer actions remain locked. */
}
const events = await listEvents(env.DB, actor);
const eventVersion = await eventViewVersion(events, actor);
const rosters =
  organizer && actor
    ? await listRosters(
        env.DB,
        actor,
        events.map((event) => event.id),
      )
    : [];
const notifications = organizer ? await countNotifications(env.DB) : null;
const destinations = events.filter(
  (event) =>
    event.startsAt > Date.now() &&
    event.open &&
    !event.hidden &&
    !event.cancelledAt,
);
const filter = ["patrol", "orientation"].includes(
  Astro.url.searchParams.get("type") ?? "",
)
  ? Astro.url.searchParams.get("type")!
  : "all";
---

<AccountLayout
  title="Volunteer"
  description="Sign up for volunteer orientations and patrols."
  signedIn={Boolean(actor)}
  organizer={actor?.role === "organizer"}
  name={actor?.name}
  email={email}
>
  {
    !actor ? (
      <SignInPanel returnTo="/volunteer" />
    ) : !actor.registered ? (
      <a class="volunteer-registration-warning" href="/volunteer/register">
        <WarningIcon class="volunteer-warning-icon" />
        <span class="volunteer-registration-warning-text">
          Complete your registration to sign up for events
        </span>
        <svg
          class="volunteer-registration-warning-arrow"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M5 12h14m-6-6 6 6-6 6" />
        </svg>
      </a>
    ) : null
  }
  {
    actor?.role === "organizer" && !organizer && (
      <p class="volunteer-notice">
        Organizer tools require an active registration. If you enabled an
        authenticator, finish signing in with it.{" "}
        <a href="/volunteer/account">Go to Your account</a>.
      </p>
    )
  }
  <section
    class="volunteer-events"
    data-event-browser
    data-event-version={eventVersion}
    aria-labelledby="events-heading"
  >
    <div class="volunteer-section-heading">
      <div>
        <h2 id="events-heading">{organizer ? "Events" : "Upcoming events"}</h2>
      </div>
      {
        organizer && (
          <button
            class="btn btn-primary"
            data-show-dialog="event-editor-new"
            type="button"
          >
            Add an event
          </button>
        )
      }
    </div>
    <form
      class="volunteer-filters"
      method="get"
      role="group"
      aria-label="Filter events"
    >
      {
        [
          ["all", "All events"],
          ["orientation", "Orientations"],
          ["patrol", "Patrols"],
        ].map(([type, label]) => (
          <button
            class="btn btn-quiet"
            type="submit"
            name="type"
            value={type}
            data-event-filter={type}
            aria-pressed={filter === type ? "true" : "false"}
          >
            {label}
          </button>
        ))
      }
    </form>
    <ul class="volunteer-event-list" data-event-list>
      {
        events.map((event) => (
          <EventCard
            event={event}
            actor={actor}
            organizer={organizer}
            roster={rosters.filter((person) => person.eventId === event.id)}
            destinations={destinations}
            filter={filter}
          />
        ))
      }
    </ul>
    <p
      class="volunteer-notice"
      data-empty-events
      role="status"
      hidden={events.some((event) => filter === "all" || event.type === filter)}
    >
      {
        events.length
          ? "No upcoming events match this filter. Check back soon."
          : "No upcoming events are scheduled. Check back soon."
      }
    </p>
    <p class="volunteer-help" data-event-limit hidden={events.length !== 100}>
      Showing up to 100 events.
    </p>
  </section>
  {
    organizer && notifications && (
      <>
        <EventEditor />
        <VolunteerProfileDialog />
        <EventNotifications counts={notifications} />
      </>
    )
  }
  <noscript
    ><p class="volunteer-notice">
      JavaScript is required to save changes and sign up for events.
    </p></noscript
  >
</AccountLayout>
<script>
  import "@/scripts/volunteer";
</script>
