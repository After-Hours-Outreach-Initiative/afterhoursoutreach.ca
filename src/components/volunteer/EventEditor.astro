---
import type { EventRow, PatrolSeriesRow } from "@/server/db/events";
import { vancouverInput } from "@/data/event-time";
import FieldError from "@/components/FieldError.astro";
import DialogHeader from "@/components/DialogHeader.astro";
import RecurringIcon from "@/components/icons/RecurringIcon.astro";
import MinusIcon from "@/components/icons/MinusIcon.astro";
import PlusIcon from "@/components/icons/PlusIcon.astro";
import DateInput from "./DateInput.astro";
import NativePickerInput from "./NativePickerInput.astro";
interface Props {
  event?: EventRow;
  series?: PatrolSeriesRow;
}
const { event, series } = Astro.props;
const dialogId = `event-editor-${event?.id ?? "new"}`;
const publicVisibility = event ? Boolean(event.open && !event.hidden) : true;
---

<dialog
  class="dialog-pop dialog-frame volunteer-dialog"
  id={dialogId}
  aria-labelledby={`${dialogId}-heading`}
>
  <DialogHeader
    id={`${dialogId}-heading`}
    title={event ? "Edit event" : "Create event"}
  />
  <div class="dialog-body">
    <form
      id={`${dialogId}-save`}
      class="volunteer-form"
      data-event-save
      data-email-prompt={event && event.confirmed > 0 ? "event" : undefined}
      data-future-email-prompt={event && event.futureEditableConfirmed > 0
        ? "series"
        : undefined}
      action="/api/v1/events/action"
      method="post"
    >
      {
        event && (
          <>
            <input type="hidden" name="id" value={event.id} />
            <input type="hidden" name="version" value={event.updatedAt} />
          </>
        )
      }
      <div class="volunteer-fields">
        {
          event?.seriesId && series && (
            <>
              <input type="hidden" name="seriesId" value={series.id} />
              <input
                type="hidden"
                name="seriesVersion"
                value={series.updatedAt}
              />
              <input
                type="hidden"
                name="occurrenceDate"
                value={event.occurrenceDate!}
              />
              <label class="volunteer-field volunteer-wide">
                Apply changes to
                <select name="scope">
                  <option value="occurrence">Only this occurrence</option>
                  <option value="future">This and future occurrences</option>
                </select>
                <span class="volunteer-help">
                  Future edits keep bookings and individual exceptions
                  unchanged. Dates retain their original recurring identity; the
                  date shift may be up to 366 days earlier or later.
                </span>
              </label>
            </>
          )
        }
        <div class="volunteer-field volunteer-wide">
          <label class="volunteer-check">
            <input
              type="checkbox"
              name="includesOrientation"
              checked={Boolean(event?.includesOrientation)}
              aria-describedby={`${dialogId}-orientation-help`}
            />
            <span>Includes orientation</span>
          </label>
          <p class="volunteer-help" id={`${dialogId}-orientation-help`}>
            Orientation places count toward total capacity: reserve two for
            volunteers without completed orientation, with a maximum of four.
            Fewer than two orientation registrations do not cancel the patrol.
            Existing bookings must remain eligible.
          </p>
        </div>
        {
          !event && (
            <div
              class="volunteer-field volunteer-wide"
              data-recurrence-controls
            >
              <label class="volunteer-check volunteer-recurrence-toggle">
                <input
                  type="checkbox"
                  name="recurring"
                  aria-describedby={`${dialogId}-recurring-help`}
                />
                <span class="volunteer-recurrence-label">
                  <RecurringIcon class="volunteer-recurrence-icon" />
                  <span>Recurring patrol</span>
                </span>
              </label>
              <div class="volunteer-fields" data-recurrence-fields hidden>
                <label class="volunteer-field">
                  Interval (weeks)
                  <input
                    name="intervalWeeks"
                    type="number"
                    min="1"
                    max="52"
                    value="1"
                    disabled
                  />
                </label>
                <div class="volunteer-field">
                  <label for={`${dialogId}-endDate`}>
                    Last recurring date (optional, inclusive)
                  </label>
                  <NativePickerInput
                    id={`${dialogId}-endDate`}
                    name="endDate"
                    aria-describedby={`error-${dialogId}-endDate`}
                    disabled
                  />
                  <FieldError
                    field={`${dialogId}-endDate`}
                    message="Choose a valid last recurring date on or after the start date."
                  />
                </div>
              </div>
              <p class="volunteer-help" id={`${dialogId}-recurring-help`}>
                Volunteers see the next 3 occurrences per series.
              </p>
            </div>
          )
        }
        <DateInput
          name="startsAt"
          id={`${dialogId}-startsAt`}
          errorField={`${dialogId}-startsAt`}
          label="Start date"
          value={event ? vancouverInput(event.startsAt) : ""}
          withTime
          defaultTime="21:00"
          futureOnly
        />
        <div class="volunteer-field">
          <label for={`${dialogId}-spots`}>Volunteer spots</label>
          <div class="volunteer-spots-stepper">
            <button
              class="btn btn-quiet"
              type="button"
              data-spots-step="-1"
              aria-label="Decrease volunteer spots"
              aria-controls={`${dialogId}-spots`}
              disabled
            >
              <MinusIcon />
            </button>
            <input
              id={`${dialogId}-spots`}
              name="spots"
              type="number"
              min={event?.includesOrientation ? "2" : "1"}
              max="100"
              step="1"
              aria-describedby={`error-${dialogId}-spots`}
              required
              value={event?.spots ?? 8}
            />
            <button
              class="btn btn-quiet"
              type="button"
              data-spots-step="1"
              aria-label="Increase volunteer spots"
              aria-controls={`${dialogId}-spots`}
              disabled
            >
              <PlusIcon />
            </button>
          </div>
          <FieldError
            field={`${dialogId}-spots`}
            message={event?.includesOrientation
              ? "Enter a whole number from 2 to 100 for a patrol that includes orientation."
              : "Enter a whole number from 1 to 100."}
          />
        </div>
        <div class="volunteer-field">
          <label for={`${dialogId}-meetingPoint`}>Meeting point</label>
          <input
            id={`${dialogId}-meetingPoint`}
            name="meetingPoint"
            aria-describedby={`error-${dialogId}-meetingPoint`}
            required
            pattern={String.raw`.*\S.*`}
            maxlength="500"
            value={event?.meetingPoint}
          />
          <FieldError
            field={`${dialogId}-meetingPoint`}
            message="Enter a meeting point (up to 500 characters)."
          />
        </div>
        <div class="volunteer-field">
          <label for={`${dialogId}-meetingPointUrl`}>Map link (optional)</label>
          <input
            id={`${dialogId}-meetingPointUrl`}
            type="url"
            name="meetingPointUrl"
            aria-describedby={`error-${dialogId}-meetingPointUrl`}
            maxlength="2048"
            value={event?.meetingPointUrl ?? ""}
            placeholder="https://"
          />
          <FieldError
            field={`${dialogId}-meetingPointUrl`}
            message="Enter a valid map URL (up to 2048 characters)."
          />
        </div>
        <fieldset class="volunteer-state-field volunteer-wide">
          <legend>Public visibility</legend>
          <div class="volunteer-state-selector">
            <label class="volunteer-state-option volunteer-state-positive">
              <input
                class="sr-only"
                type="radio"
                name="publicVisibility"
                value="true"
                checked={publicVisibility}
              />
              <span>Visible</span>
            </label>
            <label class="volunteer-state-option volunteer-state-negative">
              <input
                class="sr-only"
                type="radio"
                name="publicVisibility"
                value="false"
                checked={!publicVisibility}
              />
              <span>Hidden</span>
            </label>
          </div>
        </fieldset>
      </div>
      <p data-form-message role="status" hidden></p>
      <noscript
        ><p>
          Enable JavaScript to edit event dates and save this event.
        </p></noscript
      >
    </form>
    {
      event && (
        <form
          id={`${dialogId}-cancel`}
          class="volunteer-form volunteer-danger"
          data-event-cancel
          data-email-prompt={event.confirmed > 0 ? "event-cancel" : undefined}
          data-future-email-prompt={
            event.futureConfirmed > 0 ? "series-cancel" : undefined
          }
          action="/api/v1/events/action"
          method="post"
        >
          <h3 data-event-cancel-heading hidden={event.confirmed === 0}>
            Cancel event
          </h3>
          <input type="hidden" name="id" value={event.id} />
          <input type="hidden" name="version" value={event.updatedAt} />
          {series && (
            <>
              <input type="hidden" name="seriesId" value={series.id} />
              <input
                type="hidden"
                name="seriesVersion"
                value={series.updatedAt}
              />
              <input
                type="hidden"
                name="occurrenceDate"
                value={event.occurrenceDate!}
              />
              <label class="volunteer-field">
                Cancel
                <select name="scope">
                  <option value="occurrence">Only this occurrence</option>
                  <option value="future">
                    This and future occurrences (stop recurrence)
                  </option>
                </select>
              </label>
              <p class="volunteer-help">
                Cancelling future occurrences also cancels their bookings,
                including individual exceptions. Past attendance and
                cancellation history are kept.
              </p>
            </>
          )}
          <div
            class="volunteer-field"
            data-event-cancel-reason
            hidden={event.confirmed === 0}
          >
            <label for={`${dialogId}-reason`}>Reason (optional)</label>
            <textarea
              id={`${dialogId}-reason`}
              name="reason"
              aria-describedby={`error-${dialogId}-reason`}
              maxlength="1000"
              rows="3"
              disabled={event.confirmed === 0}
            />
            <FieldError
              field={`${dialogId}-reason`}
              message="Keep the reason to 1000 characters or fewer."
            />
          </div>
          <p data-form-message role="status" hidden />
        </form>
      )
    }
  </div>
  <div class="dialog-footer">
    <button
      class="btn btn-primary"
      type="submit"
      form={`${dialogId}-save`}
      data-loading-label={event ? "Saving…" : "Creating…"}
      disabled
    >
      {event ? "Save event" : "Create event"}
    </button>
    {
      event && (
        <button
          class="btn btn-red"
          type="submit"
          form={`${dialogId}-cancel`}
          data-loading-label="Cancelling…"
        >
          Cancel event
        </button>
      )
    }
  </div>
</dialog>
