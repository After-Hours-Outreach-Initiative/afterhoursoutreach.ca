---
import type { EventRow } from "@/server/db/events";
import { vancouverInput } from "@/data/event-time";
interface Props {
  event?: EventRow;
}
const { event } = Astro.props;
const dialogId = `event-editor-${event?.id ?? "new"}`;
---

<dialog
  class="dialog-pop volunteer-dialog"
  id={dialogId}
  aria-labelledby={`${dialogId}-heading`}
>
  <div class="volunteer-section-heading">
    <h2 id={`${dialogId}-heading`}>{event ? "Edit event" : "Add an event"}</h2>
    <button class="btn btn-quiet" data-dismiss-dialog type="button"
      >Close</button
    >
  </div>
  <form
    class="volunteer-form"
    data-event-save
    data-email-prompt={event ? "event" : undefined}
    action="/api/events/action"
    method="post"
  >
    {
      event && (
        <>
          <input type="hidden" name="id" value={event.id} />
          <input type="hidden" name="version" value={event.updatedAt} />
        </>
      )
    }
    <div class="volunteer-fields">
      {
        event ? (
          <div class="volunteer-field volunteer-wide" data-event-type-readonly>
            <span>Event type</span>
            <span class="volunteer-readonly-value">
              {event.type === "patrol" ? "Patrol" : "Orientation"}
            </span>
            <input type="hidden" name="type" value={event.type} />
          </div>
        ) : (
          <label class="volunteer-field volunteer-wide">
            Event type
            <select name="type">
              <option value="patrol">Patrol</option>
              <option value="orientation">Orientation</option>
            </select>
          </label>
        )
      }
      <label class="volunteer-field"
        >Start date and time<input
          type="datetime-local"
          name="startsAt"
          required
          value={event ? vancouverInput(event.startsAt) : ""}
        /><span class="volunteer-help"
          >Vancouver time, regardless of your device’s time zone.</span
        ></label
      >
      <label class="volunteer-field"
        >Volunteer spots<input
          name="spots"
          type="number"
          min="1"
          max="100"
          required
          value={event?.spots ?? 8}
        /></label
      >
      <label class="volunteer-field"
        >Meeting point<input
          name="meetingPoint"
          required
          maxlength="500"
          value={event?.meetingPoint}
        /></label
      >
      <label class="volunteer-field"
        >Map link (optional)<input
          type="url"
          name="meetingPointUrl"
          maxlength="2048"
          value={event?.meetingPointUrl ?? ""}
          placeholder="https://"
        /></label
      >
      <fieldset class="volunteer-state-field">
        <legend>Signups</legend>
        <div class="volunteer-state-selector">
          <label class="volunteer-state-option volunteer-state-positive">
            <input
              class="sr-only"
              type="radio"
              name="open"
              value="true"
              checked={event ? Boolean(event.open) : true}
            />
            <span>Open</span>
          </label>
          <label class="volunteer-state-option volunteer-state-negative">
            <input
              class="sr-only"
              type="radio"
              name="open"
              value="false"
              checked={event ? !event.open : false}
            />
            <span>Closed</span>
          </label>
        </div>
      </fieldset>
      <fieldset class="volunteer-state-field">
        <legend>Public event list</legend>
        <div class="volunteer-state-selector">
          <label class="volunteer-state-option volunteer-state-positive">
            <input
              class="sr-only"
              type="radio"
              name="hidden"
              value="false"
              checked={!event?.hidden}
            />
            <span>Visible</span>
          </label>
          <label class="volunteer-state-option volunteer-state-negative">
            <input
              class="sr-only"
              type="radio"
              name="hidden"
              value="true"
              checked={Boolean(event?.hidden)}
            />
            <span>Hidden</span>
          </label>
        </div>
      </fieldset>
    </div>
    <p class="volunteer-help">
      Closing or hiding an event does not cancel existing spots. You can choose
      whether to email signed-up volunteers when saving changes.
    </p>
    <p data-form-message role="status" hidden></p>
    <button class="btn btn-primary" type="submit" data-loading-label="Saving…"
      >Save event</button
    >
  </form>
  {
    event && (
      <form
        class="volunteer-form volunteer-danger"
        data-event-cancel
        data-email-prompt="event-cancel"
        action="/api/events/action"
        method="post"
      >
        <h3>Cancel event</h3>
        <input type="hidden" name="id" value={event.id} />
        <input type="hidden" name="version" value={event.updatedAt} />
        <label class="volunteer-field">
          Reason (optional)
          <textarea name="reason" maxlength="1000" rows="3" />
        </label>
        <p class="volunteer-help">
          Cancels all spots. You can choose whether to email volunteers. Records
          are retained, not permanently deleted.
        </p>
        <p data-form-message role="status" hidden />
        <button
          class="btn btn-red"
          type="submit"
          data-loading-label="Cancelling…"
        >
          Cancel event
        </button>
      </form>
    )
  }
</dialog>
