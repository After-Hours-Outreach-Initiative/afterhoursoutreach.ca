---
import type { EventRow } from "@/server/db/events";
import { vancouverInput } from "@/data/event-time";
import FieldError from "@/components/FieldError.astro";
import DateInput from "./DateInput.astro";
interface Props {
  event?: EventRow;
}
const { event } = Astro.props;
const dialogId = `event-editor-${event?.id ?? "new"}`;
const publicVisibility = Boolean(event?.open && !event.hidden);
---

<dialog
  class="dialog-pop volunteer-dialog"
  id={dialogId}
  aria-labelledby={`${dialogId}-heading`}
>
  <div class="volunteer-section-heading">
    <h2 id={`${dialogId}-heading`}>{event ? "Edit event" : "Add an event"}</h2>
    <button class="btn btn-quiet" data-dismiss-dialog type="button"
      >Close</button
    >
  </div>
  <form
    class="volunteer-form"
    data-event-save
    data-email-prompt={event ? "event" : undefined}
    action="/api/v1/events/action"
    method="post"
  >
    {
      event && (
        <>
          <input type="hidden" name="id" value={event.id} />
          <input type="hidden" name="version" value={event.updatedAt} />
        </>
      )
    }
    <div class="volunteer-fields">
      {
        event ? (
          <div class="volunteer-field volunteer-wide" data-event-type-readonly>
            <span>Event type</span>
            <span class="volunteer-readonly-value">
              {event.type === "patrol" ? "Patrol" : "Orientation"}
            </span>
            <input type="hidden" name="type" value={event.type} />
          </div>
        ) : (
          <label class="volunteer-field volunteer-wide">
            Event type
            <select name="type">
              <option value="patrol">Patrol</option>
              <option value="orientation">Orientation</option>
            </select>
          </label>
        )
      }
      <DateInput
        name="startsAt"
        id={`${dialogId}-startsAt`}
        errorField={`${dialogId}-startsAt`}
        label="Start date"
        value={event ? vancouverInput(event.startsAt) : ""}
        help="Vancouver time, regardless of your device’s time zone."
        withTime
      />
      <div class="volunteer-field">
        <label for={`${dialogId}-spots`}>Volunteer spots</label>
        <input
          id={`${dialogId}-spots`}
          name="spots"
          type="number"
          min="1"
          max="100"
          aria-describedby={`error-${dialogId}-spots`}
          required
          value={event?.spots ?? 8}
        />
        <FieldError
          field={`${dialogId}-spots`}
          message="Enter a whole number from 1 to 100."
        />
      </div>
      <div class="volunteer-field">
        <label for={`${dialogId}-meetingPoint`}>Meeting point</label>
        <input
          id={`${dialogId}-meetingPoint`}
          name="meetingPoint"
          aria-describedby={`error-${dialogId}-meetingPoint`}
          required
          pattern={String.raw`.*\S.*`}
          maxlength="500"
          value={event?.meetingPoint}
        />
        <FieldError
          field={`${dialogId}-meetingPoint`}
          message="Enter a meeting point (up to 500 characters)."
        />
      </div>
      <div class="volunteer-field">
        <label for={`${dialogId}-meetingPointUrl`}>Map link (optional)</label>
        <input
          id={`${dialogId}-meetingPointUrl`}
          type="url"
          name="meetingPointUrl"
          aria-describedby={`error-${dialogId}-meetingPointUrl`}
          maxlength="2048"
          value={event?.meetingPointUrl ?? ""}
          placeholder="https://"
        />
        <FieldError
          field={`${dialogId}-meetingPointUrl`}
          message="Enter a valid map URL (up to 2048 characters)."
        />
      </div>
      <fieldset class="volunteer-state-field volunteer-wide">
        <legend>Public visibility</legend>
        <div class="volunteer-state-selector">
          <label class="volunteer-state-option volunteer-state-positive">
            <input
              class="sr-only"
              type="radio"
              name="publicVisibility"
              value="true"
              checked={publicVisibility}
            />
            <span>Visible</span>
          </label>
          <label class="volunteer-state-option volunteer-state-negative">
            <input
              class="sr-only"
              type="radio"
              name="publicVisibility"
              value="false"
              checked={!publicVisibility}
            />
            <span>Hidden</span>
          </label>
        </div>
      </fieldset>
    </div>
    <p data-form-message role="status" hidden></p>
    <noscript
      ><p>
        Enable JavaScript to edit event dates and save this event.
      </p></noscript
    >
    <button
      class="btn btn-primary"
      type="submit"
      data-loading-label="Saving…"
      disabled>Save event</button
    >
  </form>
  {
    event && (
      <form
        class="volunteer-form volunteer-danger"
        data-event-cancel
        data-email-prompt="event-cancel"
        action="/api/v1/events/action"
        method="post"
      >
        <h3>Cancel event</h3>
        <input type="hidden" name="id" value={event.id} />
        <input type="hidden" name="version" value={event.updatedAt} />
        <div class="volunteer-field">
          <label for={`${dialogId}-reason`}>Reason (optional)</label>
          <textarea
            id={`${dialogId}-reason`}
            name="reason"
            aria-describedby={`error-${dialogId}-reason`}
            maxlength="1000"
            rows="3"
          />
          <FieldError
            field={`${dialogId}-reason`}
            message="Keep the reason to 1000 characters or fewer."
          />
        </div>
        <p data-form-message role="status" hidden />
        <button
          class="btn btn-red"
          type="submit"
          data-loading-label="Cancelling…"
        >
          Cancel event
        </button>
      </form>
    )
  }
</dialog>
