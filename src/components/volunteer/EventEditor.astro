---
import type { EventRow, PatrolSeriesRow } from "@/server/db/events";
import DialogHeader from "@/components/DialogHeader.astro";
import EventCancellation from "./EventCancellation.astro";
import EventFields from "./EventFields.astro";
interface Props {
  event?: EventRow;
  series?: PatrolSeriesRow;
}
const { event, series } = Astro.props;
const dialogId = `event-editor-${event?.id ?? "new"}`;
const editable = !event || (event.startsAt > Date.now() && !event.cancelledAt);
---

<dialog
  class="dialog-pop dialog-frame volunteer-dialog"
  id={dialogId}
  aria-labelledby={`${dialogId}-heading`}
>
  <DialogHeader
    id={`${dialogId}-heading`}
    title={event ? "Edit event" : "Create event"}
  />
  <div class="dialog-body">
    {editable && (
      <form
        id={`${dialogId}-save`}
        class="volunteer-form"
        data-event-save
        data-track-changes={event ? "" : undefined}
        data-email-prompt={event && event.confirmed > 0 ? "event" : undefined}
        data-future-email-prompt={
          event && event.futureEditableConfirmed > 0 ? "series" : undefined
        }
        action="/api/v1/events/action"
        method="post"
      >
        {event && (
          <>
            <input type="hidden" name="id" value={event.id} />
            <input type="hidden" name="version" value={event.updatedAt} />
          </>
        )}
        <div class="volunteer-fields">
          {event?.seriesId && series && (
            <>
              <input type="hidden" name="seriesId" value={series.id} />
              <input
                type="hidden"
                name="seriesVersion"
                value={series.updatedAt}
              />
              <input
                type="hidden"
                name="occurrenceDate"
                value={event.occurrenceDate!}
              />
              <fieldset class="volunteer-radio-field volunteer-wide">
                <legend>Apply changes to</legend>
                <div class="volunteer-radio-group">
                  <label class="volunteer-check">
                    <input
                      type="radio"
                      name="scope"
                      value="occurrence"
                      checked
                    />
                    <span>Only this occurrence</span>
                  </label>
                  <label class="volunteer-check">
                    <input type="radio" name="scope" value="future" />
                    <span>This and future occurrences</span>
                  </label>
                </div>
              </fieldset>
            </>
          )}
          <EventFields id={dialogId} {event} />
        </div>
        <p data-form-message role="status" hidden />
        <noscript>
          <p>Enable JavaScript to edit event dates and save this event.</p>
        </noscript>
      </form>
    )}
    {event && editable && <EventCancellation {event} {series} />}
    {event && !editable && (
      <p>
        {event.cancelledAt
          ? "This event is cancelled. Registration and attendance history is kept."
          : "This event has ended. Registration and attendance history is kept."}
      </p>
    )}
  </div>
  <div class="dialog-footer">
    <button class="btn btn-quiet" type="button" data-dismiss-dialog>
      Cancel
    </button>
    {editable && (
      <button
        class="btn btn-primary"
        type="submit"
        form={`${dialogId}-save`}
        data-loading-label={event ? "Saving…" : "Creating…"}
        disabled
      >
        {event ? "Save" : "Create"}
      </button>
    )}
  </div>
</dialog>
