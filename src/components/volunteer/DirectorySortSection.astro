---
import DirectoryRoleLabel from "./DirectoryRoleLabel.astro";
import CloseIcon from "@/components/icons/CloseIcon.svg";
import ArrowDownIcon from "@/components/icons/ArrowDownIcon.astro";
import ArrowUpIcon from "@/components/icons/ArrowUpIcon.astro";
import ChevronDownIcon from "@/components/icons/ChevronDownIcon.astro";
import GripIcon from "@/components/icons/GripIcon.astro";
import SortIcon from "@/components/icons/SortIcon.astro";
import {
  applicationStatusKeys,
  applicationStatuses,
  directoryRoleKeys,
  directoryRoles,
  type ApplicationStatus,
  type DirectoryKind,
  type DirectoryListState,
  type DirectoryRole,
} from "@/data/volunteer-list";
import "@/styles/dialog.css";
import "@/styles/filter-menu.css";
import "@/styles/sheet.css";

interface Props {
  kind: DirectoryKind;
  state: DirectoryListState;
  options: { value: string; label: string }[];
}
const { kind, state, options } = Astro.props;
const id = `${kind}-sort`;
const current =
  options.find((option) => option.value === state.sort) ?? options[0];
// Sorts by a set of values can put those values in a custom order.
const orders = [
  {
    sort: "role",
    name: "order",
    label: "Role order",
    noun: "a role",
    values: state.roleOrder as string[],
    defaults: directoryRoleKeys(kind) as string[],
  },
  {
    sort: "progress",
    name: "statusOrder",
    label: "Status order",
    noun: "a status",
    values: state.statusOrder as string[],
    defaults: applicationStatusKeys as string[],
  },
].filter((order) => options.some((option) => option.value === order.sort));
---

<button
  class="volunteer-filter filter-menu-trigger directory-sort-trigger"
  type="button"
  id={`${id}-trigger`}
  popovertarget={id}
  aria-expanded="false"
>
  <SortIcon class="filter-button-icon" />
  <span>
    Sort: <span data-sort-label>{current.label}</span>
  </span>
  <ChevronDownIcon class="filter-menu-chevron" />
</button>
<dialog
  class="filter-menu directory-sort-menu sheet"
  id={id}
  popover="auto"
  aria-labelledby={`${id}-trigger`}
  data-filter-menu="sort"
  data-filter-menu-align="end"
  data-filter-menu-sheet
>
  <div class="dialog-header sheet-header directory-sort-header" data-sheet-handle>
    <span class="sheet-grabber" aria-hidden="true"></span>
    <h2>
      <SortIcon class="filter-panel-heading-icon" />
      Sort
    </h2>
    <button
      class="btn btn-quiet dialog-close"
      type="button"
      aria-label="Close"
      data-sheet-close
    >
      <CloseIcon />
    </button>
  </div>
  <div class="filter-menu-options">
    <div
      class="filter-sort"
      data-directory-sort
      data-sort-default={options[0].value}
    >
      <div
        class="filter-section"
        role="radiogroup"
        aria-labelledby={`${id}-sort-label`}
      >
        <div class="directory-sort-order-heading">
          <p class="filter-section-heading" id={`${id}-sort-label`}>
            Sort by
          </p>
          <button
            class="directory-sort-order-reset"
            type="button"
            data-sort-reset
            hidden={
              state.sort === options[0].value && state.direction === "asc"
            }
          >
            Reset
          </button>
        </div>
        <div class="filter-section-options">
          {options.map((option) => (
            <label class="volunteer-check filter-option" data-filter-option>
              <input
                type="radio"
                name="sort"
                value={option.value}
                checked={option.value === current.value}
              />
              <span class="filter-option-label">{option.label}</span>
            </label>
          ))}
        </div>
        <div
          class="directory-sort-direction"
          role="radiogroup"
          aria-label="Direction"
        >
          <label>
            <input
              type="radio"
              name="direction"
              value="asc"
              checked={state.direction === "asc"}
            />
            <ArrowUpIcon class="directory-sort-direction-icon" />
            Ascending
          </label>
          <label>
            <input
              type="radio"
              name="direction"
              value="desc"
              checked={state.direction === "desc"}
            />
            <ArrowDownIcon class="directory-sort-direction-icon" />
            Descending
          </label>
        </div>
      </div>
      {orders.map((order) => (
        <div
          class="filter-section directory-sort-order"
          data-sort-order={order.sort}
          data-sort-order-default={order.defaults.join(",")}
          hidden={state.sort !== order.sort}
        >
          <div class="directory-sort-order-heading">
            <p class="filter-section-heading" id={`${id}-${order.name}-label`}>
              {order.label}
            </p>
            <button
              class="directory-sort-order-reset"
              type="button"
              data-sort-order-reset
              hidden={order.values.join(",") === order.defaults.join(",")}
            >
              Reset
            </button>
          </div>
          <input
            type="hidden"
            name={order.name}
            value={order.values.join(",")}
          />
          <p class="sr-only" id={`${id}-${order.name}-hint`}>
            Drag {order.noun}, or focus it and use the up and down arrow keys,
            to change the order.
          </p>
          <ol
            aria-labelledby={`${id}-${order.name}-label`}
            data-sort-order-list
          >
            {order.values.map((value) => (
              <li
                class="directory-sort-order-item"
                tabindex="0"
                aria-label={
                  order.sort === "role"
                    ? directoryRoles[value as DirectoryRole]
                    : applicationStatuses[value as ApplicationStatus].label
                }
                aria-describedby={`${id}-${order.name}-hint`}
                data-sort-order-item={value}
              >
                <GripIcon class="directory-sort-order-grip" />
                {order.sort === "role" ? (
                  <DirectoryRoleLabel role={value as DirectoryRole} {kind} />
                ) : (
                  <span
                    class="application-table-progress application-status-text"
                    data-state={
                      applicationStatuses[value as ApplicationStatus].state
                    }
                  >
                    {applicationStatuses[value as ApplicationStatus].label}
                  </span>
                )}
              </li>
            ))}
          </ol>
          <p class="sr-only" role="status" data-sort-order-status></p>
        </div>
      ))}
    </div>
    <noscript>
      <button class="btn btn-primary filter-panel-apply" type="submit">
        Apply
      </button>
    </noscript>
  </div>
  <div class="dialog-footer directory-sort-footer">
    <button
      class="btn btn-primary"
      type="button"
      data-sheet-close
    >
      Show results
    </button>
  </div>
</dialog>

<style>
  /* Small screens: a modal sheet rising from the bottom of the screen, like
     the filters. Wide screens keep a popover menu under the button. */
  @media (width < 64rem) {
    .directory-sort-menu {
      position: fixed;
      inset: auto 0 0;
      margin: 0;
      width: 100%;
      max-width: 100%;
      max-height: min(48rem, 90dvh);
      border: 0;
      border-radius: 0.75rem 0.75rem 0 0;
      box-shadow: none;
      overflow: clip;
    }
    .directory-sort-menu[open] {
      display: flex;
      flex-direction: column;
    }
    .directory-sort-menu::backdrop {
      background: #000b;
    }
    .directory-sort-header,
    .directory-sort-footer {
      --dialog-padding: 1.25rem;
    }
    /* Sort applies each change at once, so this only returns to the list. */
    .directory-sort-footer {
      padding-bottom: max(0.75rem, env(safe-area-inset-bottom));
    }
    .directory-sort-footer > .btn {
      flex: 1;
    }
    .directory-sort-menu :global(.filter-menu-options) {
      padding: 1.25rem;
    }
    @media (prefers-reduced-motion: no-preference) {
      .directory-sort-menu,
      .directory-sort-menu::backdrop {
        transition:
          translate 200ms cubic-bezier(0.2, 0, 0, 1),
          opacity 200ms ease-out,
          display 200ms allow-discrete,
          overlay 200ms allow-discrete;
      }
      .directory-sort-menu:not([open]) {
        translate: 0 100%;
      }
      .directory-sort-menu:not([open])::backdrop {
        opacity: 0;
      }
      @starting-style {
        .directory-sort-menu[open] {
          translate: 0 100%;
        }
        .directory-sort-menu[open]::backdrop {
          opacity: 0;
        }
      }
    }
  }
  @media (min-width: 64rem) {
    .directory-sort-header,
    .directory-sort-footer {
      display: none;
    }
  }
  /* The sort menu is tighter than the filter sidebar. */
  .directory-sort-menu .filter-sort {
    gap: 1rem;
  }
  .directory-sort-menu .filter-sort > .filter-section + .filter-section {
    padding-top: 1rem;
  }
  .directory-sort-menu .filter-option {
    padding: 0.25rem 0;
  }
  /* Two joined buttons choose the direction. */
  .directory-sort-direction {
    display: grid;
    grid-template-columns: 1fr 1fr;
    margin-top: 0.5rem;
    border: 1px solid #3f3f46;
    border-radius: 0.375rem;
    overflow: clip;
  }
  .directory-sort-direction label {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.375rem;
    min-height: 2.25rem;
    padding: 0.25rem 0.5rem;
    color: #d4d4d8;
    cursor: pointer;
  }
  .directory-sort-direction label + label {
    border-left: 1px solid #3f3f46;
  }
  .directory-sort-direction label:hover {
    color: white;
    background: #27272a;
  }
  .directory-sort-direction label:has(:checked) {
    background: var(--color-blue-deep);
    color: #e0e7ff;
  }
  .directory-sort-direction label:has(:focus-visible) {
    outline: 3px solid #a5b4fc;
    outline-offset: -3px;
  }
  /* The radio covers its whole button, unseen. */
  .directory-sort-direction input {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    margin: 0;
    opacity: 0;
    cursor: pointer;
  }
  .directory-sort-direction :global(.directory-sort-direction-icon) {
    flex: none;
    width: 1em;
    height: 1em;
  }
  .directory-sort-order-heading {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
  }
  .directory-sort-order-reset {
    color: #d4d4d8;
    text-decoration: underline;
    text-underline-offset: 0.25rem;
    cursor: pointer;
  }
  .directory-sort-order-reset:hover {
    color: white;
  }
  .directory-sort-order-reset[hidden] {
    display: none;
  }
  /* A compact status badge that fits the order row. */
  .directory-sort-order-item .application-table-progress {
    padding: 0.0625rem 0.5rem;
    line-height: 1.5;
  }
  .directory-sort-trigger {
    grid-area: sort;
    align-self: stretch;
  }
  .directory-sort-order[hidden] {
    display: none;
  }
  [data-sort-order-list] {
    /* Anchors the drop slot drawn while an item is dragged. */
    position: relative;
    display: grid;
    gap: 0.375rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .directory-sort-order-item {
    position: relative;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 2.75rem;
    padding: 0.25rem 0.75rem 0.25rem 0.375rem;
    border: 1px solid #3f3f46;
    border-radius: 0.375rem;
    background: #0c0d10;
    cursor: grab;
    touch-action: none;
    user-select: none;
    transition:
      transform 200ms cubic-bezier(0.2, 0, 0, 1),
      border-color 150ms ease,
      background-color 150ms ease,
      box-shadow 150ms ease;
  }
  .directory-sort-order-item:hover {
    border-color: #52525b;
  }
  .directory-sort-order-item:focus-visible {
    outline: 3px solid #a5b4fc;
    outline-offset: 2px;
  }
  /* Follows the pointer directly, above the items it passes. */
  .directory-sort-order-item[data-dragging] {
    z-index: 1;
    border-color: #818cf8;
    background: #16214a;
    box-shadow: 0 0.75rem 1.5rem #000a;
    cursor: grabbing;
    transition:
      border-color 150ms ease,
      background-color 150ms ease,
      box-shadow 150ms ease;
  }
  /* Settles into its slot after release. */
  .directory-sort-order-item[data-dropping] {
    z-index: 1;
  }
  .directory-sort-order-item :global(.directory-sort-order-grip) {
    flex: none;
    width: 1.25em;
    height: 1.25em;
    color: #71717a;
  }
  .directory-sort-order-item:is(:hover, [data-dragging])
    :global(.directory-sort-order-grip) {
    color: #d4d4d8;
  }
  /* The script creates the slot, so it has no scoped style attribute. */
  [data-sort-order-list] :global(.directory-sort-order-slot) {
    position: absolute;
    inset-inline: 0;
    top: 0;
    border: 1px dashed #818cf8;
    border-radius: 0.375rem;
    background: #818cf81a;
    pointer-events: none;
    transition: transform 200ms cubic-bezier(0.2, 0, 0, 1);
  }
  @media (prefers-reduced-motion: reduce) {
    .directory-sort-order-item,
    /* The script creates the slot, so it has no scoped style attribute. */
  [data-sort-order-list] :global(.directory-sort-order-slot) {
      transition: none;
    }
  }
</style>
