---
import {
  applicationFields,
  trainingOptions,
  trainingQuestion,
  trainingRequiredError,
  experienceOptions,
  experienceQuestion,
  experienceRequiredError,
  type ApplicationAnswers,
} from "@/data/application";
import AccountProfileField from "./AccountProfileField.astro";
import FieldError from "@/components/FieldError.astro";

interface Props {
  values?: ApplicationAnswers | null;
  required?: boolean;
  experience?: boolean;
}
const { values, required = true, experience = false } = Astro.props;
const name = experience ? "relevantExperience" : "training";
const otherName = experience ? "otherExperience" : "otherTraining";
const options = experience ? experienceOptions : trainingOptions;
const question = experience ? experienceQuestion : trainingQuestion;
const requiredError = experience
  ? experienceRequiredError
  : trainingRequiredError;
const otherTrainingField = applicationFields.find(
  (field) => field.name === otherName,
)!;
---

<fieldset
  class="volunteer-relevant-training volunteer-wide"
  data-relevant-training={name}
  data-training-required={required}
  aria-describedby={`error-${name}`}
>
  <legend>
    {question}
    {
      required && (
        <span class="volunteer-required" aria-hidden="true">
          {" "}
          *
        </span>
      )
    }
  </legend>
  <div class="volunteer-training-options volunteer-choice-options">
    {
      options.map((option, index) => (
        <>
          {option.value === "none" && (
            <div class="volunteer-training-divider" aria-hidden="true">
              OR
            </div>
          )}
          <label class="volunteer-check">
            <input
              type="checkbox"
              name={name}
              value={option.value}
              checked={values?.[name].includes(option.value)}
              required={required && index === 0 && !values?.[name].length}
              aria-describedby={`error-${name}`}
            />
            <span>{option.label}</span>
          </label>
          {option.value === "other" && (
            <AccountProfileField
              field={otherTrainingField}
              values={values}
              active={values?.[name].includes("other") ?? false}
              hideLabel
            />
          )}
        </>
      ))
    }
  </div>
  <FieldError field={name} message={requiredError} />
</fieldset>
