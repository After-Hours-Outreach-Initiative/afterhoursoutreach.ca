---
import SearchClearButton from "./SearchClearButton.astro";
import SearchIcon from "@/components/icons/SearchIcon.astro";
import AttendeeAvatar from "./AttendeeAvatar.astro";
import DirectoryRoleLabel from "./DirectoryRoleLabel.astro";
import NewVolunteerBadge from "./NewVolunteerBadge.astro";
import VolunteerRoleBadge from "./VolunteerRoleBadge.astro";
import type { AttendeeCategory } from "@/data/event-roster";
import {
  applicationStatuses,
  type ApplicationStatus,
  type DirectoryKind,
  type DirectoryRole,
} from "@/data/volunteer-list";

export interface FilterOption {
  value: string;
  label: string;
  /** Shown beside the option and kept current by the page's script. */
  count?: number;
  /** Extra attributes for the count, such as a stable hook for its value. */
  countAttributes?: Record<string, string>;
  /** Show the option as a person, with their avatar and role badges. */
  person?: {
    category: AttendeeCategory;
    medicMark: boolean;
    applicant: boolean;
    organizer: boolean;
  };
  /** Show the option as a directory role's avatar and badge. */
  role?: { role: DirectoryRole; kind: DirectoryKind };
  /** Show the option as an application status badge. */
  status?: ApplicationStatus;
}
interface Props {
  /** Checkbox name; each checked option submits one value. */
  name: string;
  label: string;
  groups: { label?: string; options: FilterOption[] }[];
  selected: readonly string[];
  search?: boolean;
  /** Makes the section's ids unique on the page. */
  idPrefix: string;
}
const { name, label, groups, selected, search = false, idPrefix } = Astro.props;
const id = `${idPrefix}-${name}`;
---

<div
  class="filter-section"
  role="group"
  aria-labelledby={`${id}-heading`}
  data-filter-section={name}
>
  <p class="filter-section-heading" id={`${id}-heading`}>
    {label}
  </p>
  {search && (
    <label class="volunteer-search-field filter-section-search">
      <span class="sr-only">Search {label.toLowerCase()}</span>
      <input
        type="search"
        placeholder="Search"
        autocomplete="off"
        data-filter-search
      />
      <SearchIcon class="volunteer-search-icon" />
      <SearchClearButton />
    </label>
  )}
  <div
    class:list={["filter-section-options", { "filter-section-scroll": search }]}
  >
    {groups.map((group) => (
      <div class="filter-section-group">
        {group.label && <p class="filter-section-group-label">{group.label}</p>}
        {group.options.map((option) => (
          <label class="volunteer-check filter-option" data-filter-option>
            <input
              type="checkbox"
              name={name}
              value={option.value}
              checked={selected.includes(option.value)}
            />
            <span class="filter-option-label">
              {option.person ? (
                <>
                  <AttendeeAvatar
                    category={option.person.category}
                    medicMark={option.person.medicMark}
                    applicant={option.person.applicant}
                    decorative
                  />
                  <span class="filter-option-name">{option.label}</span>
                  {option.person.organizer && (
                    <VolunteerRoleBadge role="organizer" />
                  )}
                  {!option.person.applicant &&
                    option.person.category === "new-volunteer" && (
                      <NewVolunteerBadge />
                    )}
                  {option.person.medicMark && (
                    <VolunteerRoleBadge role="medic" />
                  )}
                </>
              ) : option.role ? (
                <DirectoryRoleLabel {...option.role} />
              ) : option.status ? (
                <span
                  class="application-table-progress application-status-text"
                  data-state={applicationStatuses[option.status].state}
                >
                  {option.label}
                </span>
              ) : (
                option.label
              )}
            </span>
            {option.count !== undefined && (
              <span
                class="filter-option-count"
                data-filter-count={option.value}
                {...option.countAttributes}
              >
                {option.count}
              </span>
            )}
          </label>
        ))}
      </div>
    ))}
    {search && (
      <p class="filter-section-empty" data-filter-empty hidden>
        No matches.
      </p>
    )}
  </div>
</div>
