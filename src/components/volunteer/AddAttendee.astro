---
import type { EventRow } from "@/server/db/events";
import { manualAttendeeCategory } from "@/data/event-roster";
import FieldError from "@/components/FieldError.astro";
import EllipsisIcon from "@/components/icons/EllipsisIcon.astro";
import PlusIcon from "@/components/icons/PlusIcon.astro";
import RosterPerson from "./RosterPerson.astro";

interface Props {
  event: EventRow;
}
const { event } = Astro.props;
const id = `add-attendee-${event.id}`;
const roles = [
  { medic: false, newVolunteer: false },
  { medic: true, newVolunteer: false },
  { medic: false, newVolunteer: true },
  { medic: true, newVolunteer: true },
];
---

<add-attendee>
  <div class="attendee-surface">
    <button
      class="btn btn-outline attendee-trigger"
      type="button"
      aria-expanded="false"
      aria-controls={`${id}-form`}
      data-attendee-open
    >
      <PlusIcon class="btn-icon" />
      Add volunteer
    </button>
    <form
      id={`${id}-form`}
      class="volunteer-form attendee-form"
      data-add-attendee
      action="/api/v1/events/action"
      method="post"
      aria-labelledby={`${id}-heading`}
      aria-hidden="true"
      tabindex="-1"
      inert
    >
      <h4 id={`${id}-heading`} class="text-lg">Add volunteer</h4>
      <input type="hidden" name="id" value={event.id} />
      <div class="volunteer-field">
        <label for={`${id}-name`}>
          Name <span class="volunteer-required" aria-hidden="true">*</span>
        </label>
        <input
          id={`${id}-name`}
          name="name"
          type="text"
          required
          maxlength="200"
          pattern=".*\S.*"
          aria-describedby={`error-${id}-name`}
          autocomplete="off"
        />
        <FieldError field={`${id}-name`} message="Enter a name." />
      </div>
      <div class="attendee-roles">
        <label class="volunteer-check"
          ><input type="checkbox" name="newVolunteer" /><span
            >New volunteer</span
          ></label
        >
        <label class="volunteer-check"
          ><input type="checkbox" name="medic" /><span>Medic</span></label
        >
      </div>
      <div
        class="attendee-preview"
        role="group"
        aria-labelledby={`${id}-preview-label`}
      >
        <span id={`${id}-preview-label`}>Preview</span>
        <div
          class="event-roster-row attendee-preview-row"
          data-attendee-preview
          aria-live="polite"
          aria-atomic="true"
        >
          <div class="event-roster-details">
            {
              roles.map(({ medic, newVolunteer }) => (
                <div
                  data-attendee-preview-medic={String(medic)}
                  data-attendee-preview-new={String(newVolunteer)}
                  hidden={medic || newVolunteer}
                >
                  <RosterPerson
                    name="Name"
                    category={manualAttendeeCategory(medic, newVolunteer)}
                    medicMark={medic}
                    gradientId={`${id}-gradient-${medic}`}
                  />
                </div>
              ))
            }
          </div>
          <div class="event-roster-actions">
            <button
              class="btn btn-quiet signup-menu-trigger"
              type="button"
              aria-label="Registration actions (preview only)"
              disabled
            >
              <EllipsisIcon class="size-5" />
            </button>
          </div>
        </div>
      </div>
      <p data-form-message role="status" hidden></p>
      <div class="attendee-actions">
        <button class="btn btn-quiet" type="button" data-attendee-cancel
          >Cancel</button
        >
        <button class="btn btn-green" type="submit" data-loading-label="Adding…"
          >Add</button
        >
      </div>
    </form>
  </div>
</add-attendee>

<script>
  import { syncAttendeePreview } from "@/scripts/add-attendee";
  import { InlineMorph } from "@/scripts/inline-morph";

  class AddAttendee extends HTMLElement {
    private controller?: AbortController;
    private morph = new InlineMorph();

    connectedCallback() {
      this.controller?.abort();
      this.controller = new AbortController();
      const { signal } = this.controller;
      this.addEventListener(
        "click",
        (event) => {
          if (!(event.target instanceof Element)) return;
          const button = event.target.closest<HTMLButtonElement>(
            "[data-attendee-open], [data-attendee-cancel]",
          );
          if (button && !button.disabled)
            this.expand(button.hasAttribute("data-attendee-open"));
        },
        { signal },
      );
      this.addEventListener(
        "keydown",
        (event) => {
          if (event.key === "Escape" && this.hasAttribute("data-expanded")) {
            event.preventDefault();
            this.expand(false);
          }
        },
        { signal },
      );
    }

    disconnectedCallback() {
      this.controller?.abort();
      this.morph.cancel();
    }

    private expand(expanded: boolean) {
      const form = this.querySelector<HTMLFormElement>("form")!;
      if (form.dataset.submitting) return;
      const surface = this.querySelector<HTMLElement>(".attendee-surface")!;
      const trigger = this.querySelector<HTMLButtonElement>(
        "[data-attendee-open]",
      )!;
      this.morph.run(surface, trigger, form, expanded, () => {
        this.toggleAttribute("data-expanded", expanded);
        trigger.setAttribute("aria-expanded", String(expanded));
        form.inert = !expanded;
        form.setAttribute("aria-hidden", String(!expanded));
        trigger.inert = expanded;
        if (expanded) syncAttendeePreview(form);
        // Focus the form itself, not the name input or the hidden trigger.
        (expanded ? form : trigger).focus({ preventScroll: true });
      });
      if (!expanded)
        this.dispatchEvent(new Event("add-attendee-close", { bubbles: true }));
    }
  }

  if (!customElements.get("add-attendee"))
    customElements.define("add-attendee", AddAttendee);
</script>

<style>
  add-attendee {
    display: block;
    width: 100%;
    min-width: 0;
  }
  .attendee-surface {
    position: relative;
    width: 100%;
    max-width: 100%;
    overflow: clip;
    border: 2px solid var(--color-blue);
    border-radius: 0.5rem;
    background: #000;
  }
  .attendee-trigger.btn {
    width: 100%;
    min-height: 2.5rem;
    padding-inline: calc(1.25rem - 2px);
    border: 0;
    border-radius: 0.375rem;
    background: transparent;
  }
  add-attendee:not([data-expanded])
    .attendee-surface:has(.attendee-trigger:hover:not(:disabled)) {
    background: var(--color-blue);
  }
  .attendee-trigger,
  .attendee-form {
    transition:
      opacity 160ms ease,
      visibility 0s linear 160ms;
  }
  .attendee-form {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    margin: 0;
    padding: 1rem;
    visibility: hidden;
    opacity: 0;
    outline: none;
  }
  [data-expanded] .attendee-surface {
    width: 100%;
  }
  [data-expanded] .attendee-trigger {
    position: absolute;
    top: 0;
    left: 0;
    visibility: hidden;
    opacity: 0;
  }
  [data-expanded] .attendee-form {
    position: relative;
    visibility: visible;
    opacity: 1;
    transition-delay: 0s;
  }
  add-attendee:not([data-expanded]) .attendee-trigger {
    transition-delay: 0s;
  }
  .attendee-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 0.75rem;
  }
  .attendee-surface:has(.attendee-trigger:focus-visible) {
    outline: 2px solid white;
    outline-offset: 3px;
  }
  .attendee-roles {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }
  .attendee-preview {
    display: grid;
    gap: 0.5rem;
  }
  .attendee-preview-row {
    border: 1px solid #3f3f46;
    border-radius: 0.5rem;
  }
  .attendee-preview .signup-menu-trigger:disabled {
    pointer-events: none;
    cursor: default;
    opacity: 1;
  }
  @media (min-width: 64rem) {
    @container event-card (min-width: 32rem) {
      add-attendee:not([data-expanded]) .attendee-surface {
        width: fit-content;
      }
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .attendee-trigger,
    .attendee-form {
      transition: none;
    }
  }
</style>
