---
import PageContents from "./PageContents.astro";
interface Props {
  sections: { key: string; heading: string }[];
}
const { sections } = Astro.props;
const entries = [{ key: "overview", heading: "Overview" }, ...sections].map(
  (section) => ({ ...section, id: `application-${section.key}` }),
);
---

<PageContents entries={entries} application />
