---
import DraftSaveStatus from "./DraftSaveStatus.astro";
import PageContentsList from "./PageContentsList.astro";

interface Props {
  entries: {
    id: string;
    heading: string;
    nested?: boolean;
    completable?: boolean;
  }[];
  application?: boolean;
  review?: boolean;
}
const { entries, application = false, review = false } = Astro.props;
const heading = application ? "Sections" : "On this page";
const totalSections = entries.filter((entry) => entry.completable).length;
---

<nav
  class:list={[
    "volunteer-contents",
    { "volunteer-application-contents": application },
  ]}
  data-page-contents
  data-application-contents={(application && !review) || undefined}
  data-application-review-contents={review || undefined}
  hidden={review}
  aria-label={heading}
>
  <div class="volunteer-contents-bar-slot">
    <div class="volunteer-contents-bar" data-contents-bar>
      <details class="volunteer-contents-menu" data-contents-menu>
        <summary
          data-application-step-heading={application || undefined}
          aria-label={application ? heading : undefined}
        >
          {
            application ? (
              <>
                <svg
                  class="volunteer-contents-icon"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  aria-hidden="true"
                >
                  <path d="M8 6h13M8 12h13M8 18h13M3 6h1M3 12h1M3 18h1" />
                </svg>
                <span class="volunteer-contents-current" data-contents-current>
                  {heading}
                </span>
                {!review && (
                  <span
                    class="volunteer-contents-progress"
                    data-application-progress
                    role="progressbar"
                    aria-label="Application progress"
                    aria-valuemin="0"
                    aria-valuemax={totalSections}
                    aria-valuenow="0"
                    aria-valuetext={`0 of ${totalSections} sections complete`}
                  >
                    <svg
                      viewBox="0 0 28 28"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="3"
                      aria-hidden="true"
                    >
                      <circle
                        class="volunteer-contents-progress-track"
                        cx="14"
                        cy="14"
                        r="11"
                      />
                      <circle
                        data-application-progress-value
                        cx="14"
                        cy="14"
                        r="11"
                        pathLength="100"
                        stroke-dasharray="100"
                        stroke-dashoffset="100"
                        transform="rotate(-90 14 14)"
                      />
                    </svg>
                  </span>
                )}
                <svg
                  class="volunteer-contents-chevron"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  aria-hidden="true"
                >
                  <path d="m6 9 6 6 6-6" />
                </svg>
              </>
            ) : (
              <>
                <span class="volunteer-contents-toggle">
                  {heading}
                  <svg
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    aria-hidden="true"
                  >
                    <path d="m9 5 7 7-7 7" />
                  </svg>
                </span>
                <span class="volunteer-contents-current" data-contents-current>
                  {entries[0]?.heading}
                </span>
              </>
            )
          }
        </summary>
        <div class="volunteer-contents-dropdown" data-contents-dropdown>
          <PageContentsList
            entries={entries}
            application={application}
            variant="menu"
          />
          {
            application && !review && (
              <>
                <button
                  type="submit"
                  form="volunteer-application"
                  data-application-review
                  class="btn btn-primary"
                  disabled
                >
                  Review application
                </button>
                <DraftSaveStatus />
              </>
            )
          }
        </div>
      </details>
      {
        application && !review && (
          <div class="volunteer-contents-actions">
            <button
              type="submit"
              form="volunteer-application"
              data-application-review
              class="btn btn-primary volunteer-application-review-sidebar"
              disabled
            >
              Review application
            </button>
            <DraftSaveStatus />
          </div>
        )
      }
    </div>
  </div>
  <div class="volunteer-contents-sidebar">
    <h2>{heading}</h2>
    <PageContentsList
      entries={entries}
      application={application}
      variant="sidebar"
    />
  </div>
</nav>
