---
import DraftSaveStatus from "./DraftSaveStatus.astro";
import PageContentsList from "./PageContentsList.astro";

interface Props {
  entries: {
    id: string;
    heading: string;
    nested?: boolean;
    completable?: boolean;
  }[];
  application?: boolean;
}
const { entries, application = false } = Astro.props;
const heading = application ? "Sections" : "On this page";
const totalSections = entries.filter((entry) => entry.completable).length;
---

<nav
  class="volunteer-contents"
  data-page-contents
  data-application-contents={application || undefined}
  aria-label={heading}
>
  <div class="volunteer-contents-bar-slot">
    <div class="volunteer-contents-bar" data-contents-bar>
      <details class="volunteer-contents-menu" data-contents-menu>
        <summary data-application-step-heading={application || undefined}>
          {
            application ? (
              <>
                <span class="volunteer-contents-section-toggle">
                  {heading}
                  <svg
                    class="volunteer-contents-chevron"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    aria-hidden="true"
                  >
                    <path d="m6 9 6 6 6-6" />
                  </svg>
                </span>
                <span
                  class="volunteer-contents-current"
                  data-contents-current
                  hidden
                />
                <span
                  class="volunteer-contents-completion"
                  data-application-progress-count
                >
                  0/{totalSections} complete
                </span>
              </>
            ) : (
              <>
                <span class="volunteer-contents-toggle">
                  {heading}
                  <svg
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    aria-hidden="true"
                  >
                    <path d="m9 5 7 7-7 7" />
                  </svg>
                </span>
                <span class="volunteer-contents-current" data-contents-current>
                  {entries[0]?.heading}
                </span>
              </>
            )
          }
        </summary>
        <div class="volunteer-contents-dropdown" data-contents-dropdown>
          <PageContentsList
            entries={entries}
            application={application}
            variant="menu"
          />
          {
            application && (
              <>
                <button
                  type="submit"
                  form="volunteer-application"
                  data-application-review
                  class="btn btn-primary"
                  disabled
                >
                  Review application
                </button>
                <DraftSaveStatus />
              </>
            )
          }
        </div>
      </details>
      {
        application && (
          <div class="volunteer-contents-actions">
            <button
              type="submit"
              form="volunteer-application"
              data-application-review
              class="btn btn-primary volunteer-application-review-sidebar"
              disabled
            >
              Review application
            </button>
            <DraftSaveStatus />
          </div>
        )
      }
    </div>
  </div>
  <div class="volunteer-contents-sidebar">
    <h2>{heading}</h2>
    <PageContentsList
      entries={entries}
      application={application}
      variant="sidebar"
    />
  </div>
</nav>
