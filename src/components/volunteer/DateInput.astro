---
import FieldError from "@/components/FieldError.astro";
import WarningIcon from "@/components/icons/WarningIcon.astro";
import { dateParts, canonicalDate } from "@/data/date-input";
import NativePickerInput from "./NativePickerInput.astro";
import { formatTimeInput } from "@/data/event-time";

interface Props {
  name: string;
  id: string;
  label: string;
  value: string;
  help?: string;
  required?: boolean;
  active?: boolean;
  birthDate?: boolean;
  withTime?: boolean;
  defaultTime?: string;
  warnPast?: boolean;
  errorField?: string;
  readonlyDate?: boolean;
}
const {
  name,
  id,
  label,
  value,
  help,
  required = true,
  active = true,
  birthDate = false,
  withTime = false,
  defaultTime = "",
  warnPast = false,
  errorField = name,
  readonlyDate = false,
} = Astro.props;
const parts = dateParts(withTime ? value.split("T")[0] : value);
const date = canonicalDate(parts);
const time = withTime ? (value.split("T")[1] ?? defaultTime) : "";
const message = birthDate
  ? "Enter your date of birth."
  : `Enter a valid ${label.toLowerCase()}${withTime ? " and time" : ""}.`;
const describedBy = `error-${errorField}${help ? ` help-${id}` : ""}`;
---

<fieldset
  class="volunteer-field volunteer-date-input"
  aria-describedby={withTime ? describedBy : undefined}
  data-date-input={name}
  data-birth-date={birthDate || undefined}
  data-date-time={withTime || undefined}
  data-certification-expiry={name === "certificationExpiry" || undefined}
  hidden={!active}
>
  <legend id={`${id}-label`}>
    {label}{
      required && (
        <span class="volunteer-required" aria-hidden="true">
          {" "}
          *
        </span>
      )
    }
  </legend>
  {
    help && (
      <span class="volunteer-help" id={`help-${id}`}>
        {help}
      </span>
    )
  }
  {
    birthDate ? (
      <div class="volunteer-date-parts">
        {(["year", "month", "day"] as const).map((part) => (
          <div class="volunteer-field">
            <label for={`${id}-${part}`} class="sr-only">
              {part[0].toUpperCase() + part.slice(1)}
            </label>
            <input
              id={`${id}-${part}`}
              data-date-part={part}
              data-birth-date-part={part}
              type="text"
              inputmode="numeric"
              autocomplete={`bday-${part}`}
              placeholder={
                part === "year" ? "yyyy" : part === "month" ? "mm" : "dd"
              }
              aria-describedby={describedBy}
              value={parts[part]}
              required={required && active}
              readonly={!active || readonlyDate}
              pattern={
                part === "year" ? String.raw`\d{4}` : String.raw`\d{1,2}`
              }
              maxlength="10"
              spellcheck={false}
            />
          </div>
        ))}
      </div>
    ) : (
      <NativePickerInput
        id={id}
        aria-labelledby={`${id}-label`}
        aria-describedby={describedBy}
        value={date}
        required={required && active}
        readonly={!active || readonlyDate}
        autocomplete="off"
      />
    )
  }
  {
    withTime && (
      <div class="volunteer-field">
        <label for={`${id}-time`}>
          Start time
          {required && (
            <span class="volunteer-required" aria-hidden="true">
              {" "}
              *
            </span>
          )}
        </label>
        <input
          id={`${id}-time`}
          data-date-time-input
          type="text"
          value={formatTimeInput(time)}
          placeholder="9:00 PM"
          readonly={!active}
          required={required && active}
          aria-describedby={describedBy}
        />
      </div>
    )
  }
  <input
    type="hidden"
    name={name}
    value={date && (!withTime || time)
      ? `${date}${withTime ? `T${time}` : ""}`
      : ""}
  />
  <FieldError field={errorField} message={message} />
  {
    warnPast && (
      <p
        class="volunteer-help volunteer-date-warning"
        data-date-past-warning
        role="status"
        hidden
      >
        <WarningIcon class="volunteer-warning-icon" />
        <span>The start date and time are in the past.</span>
      </p>
    )
  }
</fieldset>
