---
import ChevronDownIcon from "@/components/icons/ChevronDownIcon.astro";
import DirectoryRoleLabel from "./DirectoryRoleLabel.astro";
import GripIcon from "@/components/icons/GripIcon.astro";
import {
  directoryRoles,
  type DirectoryKind,
  type DirectoryListState,
} from "@/data/volunteer-list";
import "@/styles/filter-menu.css";

interface Props {
  kind: DirectoryKind;
  state: DirectoryListState;
  options: { value: string; label: string }[];
}
const { kind, state, options } = Astro.props;
const id = `${kind}-sort`;
const current =
  options.find((option) => option.value === state.sort) ?? options[0];
---

<button
  class="volunteer-filter filter-menu-trigger directory-sort-trigger"
  type="button"
  id={`${id}-trigger`}
  popovertarget={id}
  aria-expanded="false"
>
  <span>
    Sort: <span data-sort-label>{current.label}</span>
  </span>
  <ChevronDownIcon class="filter-menu-chevron" />
</button>
<div
  class="filter-menu directory-sort-menu"
  id={id}
  popover="auto"
  role="group"
  aria-labelledby={`${id}-trigger`}
  data-filter-menu="sort"
  data-filter-menu-align="end"
>
  <div class="filter-menu-options">
    <fieldset class="filter-menu-group">
      <legend class="filter-menu-group-label">Sort by</legend>
      {options.map((option) => (
        <label class="volunteer-check" data-filter-option>
          <input
            type="radio"
            name="sort"
            value={option.value}
            checked={option.value === current.value}
          />
          <span class="filter-menu-option-label">{option.label}</span>
        </label>
      ))}
    </fieldset>
    <fieldset class="filter-menu-group">
      <legend class="filter-menu-group-label">Direction</legend>
      <label class="volunteer-check" data-filter-option>
        <input
          type="radio"
          name="direction"
          value="asc"
          checked={state.direction === "asc"}
        />
        <span class="filter-menu-option-label">Ascending</span>
      </label>
      <label class="volunteer-check" data-filter-option>
        <input
          type="radio"
          name="direction"
          value="desc"
          checked={state.direction === "desc"}
        />
        <span class="filter-menu-option-label">Descending</span>
      </label>
    </fieldset>
    <div
      class="filter-menu-group directory-role-order"
      data-role-order
      hidden={state.sort !== "role"}
    >
      <p class="filter-menu-group-label" id={`${id}-order-label`}>
        Role order
      </p>
      <input type="hidden" name="order" value={state.roleOrder.join(",")} />
      <p class="sr-only" id={`${id}-order-hint`}>
        Drag a role, or focus it and use the up and down arrow keys, to change
        the order.
      </p>
      <ol aria-labelledby={`${id}-order-label`} data-role-order-list>
        {state.roleOrder.map((role) => (
          <li
            class="directory-role-order-item"
            tabindex="0"
            aria-label={directoryRoles[role]}
            aria-describedby={`${id}-order-hint`}
            data-role-order-item={role}
          >
            <GripIcon class="directory-role-order-grip" />
            <DirectoryRoleLabel {role} {kind} />
          </li>
        ))}
      </ol>
      <p class="sr-only" role="status" data-role-order-status></p>
    </div>
  </div>
  <div class="filter-menu-actions">
    <button class="btn btn-primary" type="submit" data-filter-apply>
      Apply
    </button>
  </div>
</div>

<style>
  .directory-sort-trigger {
    margin-left: auto;
  }
  fieldset.filter-menu-group {
    margin: 0;
    padding: 0;
    border: 0;
    min-width: 0;
  }
  fieldset.filter-menu-group legend {
    margin-bottom: 0.25rem;
    padding: 0;
  }
  .directory-role-order[hidden] {
    display: none;
  }
  [data-role-order-list] {
    /* Anchors the drop slot drawn while an item is dragged. */
    position: relative;
    display: grid;
    gap: 0.375rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .directory-role-order-item {
    position: relative;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 2.75rem;
    padding: 0.25rem 0.75rem 0.25rem 0.375rem;
    border: 1px solid #3f3f46;
    border-radius: 0.375rem;
    background: #0c0d10;
    cursor: grab;
    touch-action: none;
    user-select: none;
    transition:
      transform 200ms cubic-bezier(0.2, 0, 0, 1),
      border-color 150ms ease,
      background-color 150ms ease,
      box-shadow 150ms ease;
  }
  .directory-role-order-item:hover {
    border-color: #52525b;
  }
  .directory-role-order-item:focus-visible {
    outline: 3px solid #a5b4fc;
    outline-offset: 2px;
  }
  /* Follows the pointer directly, above the items it passes. */
  .directory-role-order-item[data-dragging] {
    z-index: 1;
    border-color: #818cf8;
    background: #16214a;
    box-shadow: 0 0.75rem 1.5rem #000a;
    cursor: grabbing;
    transition:
      border-color 150ms ease,
      background-color 150ms ease,
      box-shadow 150ms ease;
  }
  /* Settles into its slot after release. */
  .directory-role-order-item[data-dropping] {
    z-index: 1;
  }
  .directory-role-order-item :global(.directory-role-order-grip) {
    flex: none;
    width: 1.25em;
    height: 1.25em;
    color: #71717a;
  }
  .directory-role-order-item:is(:hover, [data-dragging])
    :global(.directory-role-order-grip) {
    color: #d4d4d8;
  }
  /* The script creates the slot, so it has no scoped style attribute. */
  [data-role-order-list] :global(.directory-role-order-slot) {
    position: absolute;
    inset-inline: 0;
    top: 0;
    border: 1px dashed #818cf8;
    border-radius: 0.375rem;
    background: #818cf81a;
    pointer-events: none;
    transition: transform 200ms cubic-bezier(0.2, 0, 0, 1);
  }
  @media (prefers-reduced-motion: reduce) {
    .directory-role-order-item,
    /* The script creates the slot, so it has no scoped style attribute. */
  [data-role-order-list] :global(.directory-role-order-slot) {
      transition: none;
    }
  }
</style>
