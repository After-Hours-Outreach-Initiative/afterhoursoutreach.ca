---
import type { HTMLAttributes } from "astro/types";

interface Props extends HTMLAttributes<"button"> {
  kind: "application" | "patrol";
  approved?: boolean;
}

const {
  kind,
  approved = false,
  type = "submit",
  class: className,
  ...attributes
} = Astro.props;
const label =
  kind === "application"
    ? approved
      ? "Revoke application approval"
      : "Approve application"
    : approved
      ? "Revoke patrol approval"
      : "Approve for patrols";
---

<button
  class:list={[
    "btn volunteer-access-button",
    approved ? "btn-red" : "btn-green",
    className,
  ]}
  type={type}
  data-approved={approved}
  {...attributes}
>
  {label}
</button>

<style>
  /* Keep the shared control usable outside the site's Tailwind stylesheet. */
  .volunteer-access-button {
    --access-button-color: var(--color-green-700, oklch(52.7% 0.154 150.069));
    --access-button-hover: var(--color-green-800, oklch(44.8% 0.119 151.328));
    display: inline-flex;
    min-height: 2.75rem;
    align-items: center;
    justify-content: center;
    gap: 0.625rem;
    border: 2px solid var(--access-button-color);
    border-radius: var(--radius-lg, 0.5rem);
    padding: 0 1.25rem;
    background: var(--access-button-color);
    color: var(--color-white, #fff);
    font-family: inherit;
    font-size: var(--text-base, 1rem);
    font-weight: var(--font-weight-bold, 700);
    line-height: var(--text-base--line-height, 1.5);
    transition-property: color, background-color, border-color;
    transition-duration: var(--default-transition-duration, 150ms);
    transition-timing-function: var(
      --default-transition-timing-function,
      cubic-bezier(0.4, 0, 0.2, 1)
    );
  }

  .volunteer-access-button[data-approved="true"] {
    --access-button-color: var(--color-red-700, oklch(50.5% 0.213 27.518));
    --access-button-hover: var(--color-red-800, oklch(44.4% 0.177 26.899));
  }

  .volunteer-access-button:hover:enabled {
    border-color: var(--access-button-hover);
    background: var(--access-button-hover);
  }
</style>
