---
import DirectoryRow from "./DirectoryRow.astro";
import SearchIcon from "../icons/SearchIcon.astro";
import FilterMenu from "./FilterMenu.astro";
import DirectorySortMenu from "./DirectorySortMenu.astro";
import {
  directoryListUrl,
  applicationStatuses,
  directoryEmptyMessage,
  directoryRoleKeys,
  directoryRoles,
  type ApplicationStatus,
  type DirectoryListState,
} from "../../data/volunteer-list";
import type { listVolunteers } from "../../server/db/volunteers";

interface Props {
  kind: "applications" | "volunteers";
  people: Awaited<ReturnType<typeof listVolunteers>>;
  state: DirectoryListState;
  urlForState?: (state: DirectoryListState) => string;
  profileHref?: (id: string) => string;
  formFields?: Record<string, string>;
}
const { kind, people, state, formFields = {} } = Astro.props;
const applications = kind === "applications";
const title = applications ? "Applications" : "Volunteers";
const urlForState =
  Astro.props.urlForState ??
  ((next: DirectoryListState) => directoryListUrl(kind, next));
const listUrl = urlForState(state);
const profileHref =
  Astro.props.profileHref ??
  ((id: string) =>
    `/${kind}/${encodeURIComponent(id)}?returnTo=${encodeURIComponent(listUrl)}`);
const { search, approval, roles, sort, direction } = state;
const visibleIds = new Set(people.rows.map(({ id }) => id));
const cachedRows = people.allRows.filter(({ id }) => !visibleIds.has(id));
const statusCounts: Record<ApplicationStatus, number> = {
  awaiting: people.awaitingApprovalCount,
  "in-progress": people.inProgressCount,
  rejected: people.rejectedCount,
  approved: people.approvedCount,
};
const sortOptions = applications
  ? [
      { value: "progress", label: "Status" },
      { value: "completed", label: "Completed" },
      { value: "name", label: "Name" },
      { value: "role", label: "Role" },
    ]
  : [
      { value: "role", label: "Role" },
      { value: "name", label: "Name" },
    ];
---

<section
  class="volunteer-events"
  data-volunteer-browser
  data-directory-kind={kind}
  aria-labelledby={`${kind}-heading`}
>
  <div class="volunteer-section-heading">
    <h2 id={`${kind}-heading`}>{title}</h2>
  </div>
  <form
    class="directory-controls"
    method="get"
    data-volunteer-search-form
    data-directory-controls
  >
    {Object.entries(formFields).map(([name, value]) => (
      <input type="hidden" name={name} value={value} />
    ))}
    <div class="volunteer-search">
      <label class="volunteer-search-field">
        <span class="sr-only">
          {applications ? "Find an applicant" : "Find a volunteer"}
        </span>
        <SearchIcon class="volunteer-search-icon" />
        <input
          type="search"
          name="q"
          data-volunteer-search
          value={search}
          maxlength="100"
          placeholder="Search by name"
        />
      </label>
    </div>
    <div class="directory-control-row">
      <div class="directory-filters" role="group" aria-label="Filters">
        {applications && (
          <FilterMenu
            name="approval"
            label="Status"
            idPrefix={kind}
            selected={approval}
            groups={[
              {
                options: Object.entries(applicationStatuses).map(
                  ([value, status]) => ({
                    value,
                    label: status.label,
                    status: value as ApplicationStatus,
                    count: statusCounts[value as ApplicationStatus],
                    // The review queue's count is a stable page hook.
                    countAttributes:
                      value === "awaiting"
                        ? { "data-awaiting-approval-count": "" }
                        : undefined,
                  }),
                ),
              },
            ]}
          />
        )}
        <FilterMenu
          name="role"
          label="Role"
          idPrefix={kind}
          selected={roles}
          groups={[
            {
              options: directoryRoleKeys(kind).map((role) => ({
                value: role,
                label: directoryRoles[role],
                role: { role, kind },
                count: people.roleCounts[role] ?? 0,
              })),
            },
          ]}
        />
        <a
          class="directory-filters-reset"
          href={urlForState({ ...state, approval: [], roles: [] })}
          data-directory-reset
          hidden={!approval.length && !roles.length}
        >
          Clear filters
        </a>
      </div>
      <DirectorySortMenu {kind} {state} options={sortOptions} />
    </div>
  </form>
  <div data-volunteer-results>
    <ul
      class="directory-list"
      id={`${kind}-list`}
      aria-label={applications ? "Applications" : "Volunteers"}
      data-volunteer-list
      hidden={!people.rows.length}
    >
      {people.rows.map((person) => (
        <DirectoryRow
          person={person}
          applications={applications}
          href={profileHref(person.id)}
        />
      ))}
    </ul>
    <p
      class="volunteer-notice"
      data-volunteer-empty
      hidden={Boolean(people.rows.length)}
    >
      {directoryEmptyMessage(kind, state)}
    </p>
    <template data-volunteer-cached-rows>
      <ul>
        {cachedRows.map((person) => (
          <DirectoryRow
            person={person}
            applications={applications}
            href={profileHref(person.id)}
          />
        ))}
      </ul>
    </template>
  </div>
  <p class="sr-only" role="status" data-volunteer-result-count></p>
  <p
    data-volunteer-search-error
    class="volunteer-notice"
    role="status"
    hidden
  ></p>
</section>

<style>
  .directory-controls {
    margin-bottom: 1rem;
  }
  .directory-controls .volunteer-search {
    margin-bottom: 1rem;
  }
  .directory-control-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
  }
  .directory-filters {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
  }
  .directory-filters-reset {
    margin-left: 0.25rem;
    color: #d4d4d8;
    text-decoration: underline;
    text-underline-offset: 0.25rem;
  }
  .directory-filters-reset[hidden] {
    display: none;
  }
</style>
