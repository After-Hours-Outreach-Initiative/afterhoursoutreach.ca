---
import AttendeeAvatar from "./AttendeeAvatar.astro";
import NewVolunteerBadge from "./NewVolunteerBadge.astro";
import VolunteerRoleBadge from "./VolunteerRoleBadge.astro";
import SearchIcon from "../icons/SearchIcon.astro";
import ArrowRightIcon from "../icons/ArrowRightIcon.astro";
import TableScrollFrame from "../TableScrollFrame.astro";
import CompactPersonName from "./CompactPersonName.astro";
import { formatApplicationCompletedTime } from "../../data/application";
import {
  directoryListUrl,
  applicationStatuses,
  applicationStatus,
  volunteerPageSize,
  type DirectoryListState,
  type DirectorySort,
} from "../../data/volunteer-list";
import type { listVolunteers } from "../../server/db/volunteers";

interface Props {
  kind: "applications" | "volunteers";
  people: Awaited<ReturnType<typeof listVolunteers>>;
  state: DirectoryListState;
  urlForState?: (state: DirectoryListState) => string;
  profileHref?: (id: string) => string;
  formFields?: Record<string, string>;
}
const { kind, people, state, formFields = {} } = Astro.props;
const applications = kind === "applications";
const title = applications ? "Applications" : "Volunteers";
const urlForState =
  Astro.props.urlForState ??
  ((next: DirectoryListState) => directoryListUrl(kind, next));
const listUrl = urlForState(state);
const profileHref =
  Astro.props.profileHref ??
  ((id: string) =>
    `/${kind}/${encodeURIComponent(id)}?returnTo=${encodeURIComponent(listUrl)}`);
const { search, offset, approval, sort, direction } = state;
const statusCounts = {
  awaiting: people.awaitingApprovalCount,
  "in-progress": people.inProgressCount,
  rejected: people.rejectedCount,
  approved: people.approvedCount,
};
const emptySubject = {
  all: "applications",
  awaiting: "applications ready for review",
  "in-progress": "applications in progress",
  rejected: "rejected applications",
  approved: "approved applications",
}[approval];
const emptyApplications =
  offset > 0
    ? `No ${emptySubject} on this page. Return to the previous page.`
    : search
      ? `No ${emptySubject} match your search.`
      : approval === "awaiting"
        ? "No applications are ready for review."
        : approval === "all"
          ? "No applications to review."
          : `No ${emptySubject}.`;
const columns = (
  applications
    ? [
        { key: "name", label: "Name" },
        { key: "progress", label: "Status" },
        { key: "completed", label: "Completed" },
      ]
    : [{ key: "name", label: "Name" }]
) satisfies { key: DirectorySort; label: string }[];
---

<section
  class="volunteer-events"
  data-volunteer-browser
  aria-labelledby={`${kind}-heading`}
>
  <div class="volunteer-section-heading">
    <h2 id={`${kind}-heading`}>{title}</h2>
  </div>
  <form class="volunteer-search" method="get" data-volunteer-search-form>
    {
      Object.entries(formFields).map(([name, value]) => (
        <input type="hidden" name={name} value={value} />
      ))
    }
    {applications && <input type="hidden" name="approval" value={approval} />}
    <input type="hidden" name="sort" value={sort} />
    <input type="hidden" name="direction" value={direction} />
    <label class="volunteer-search-field">
      <span class="sr-only">
        {applications ? "Find an applicant" : "Find a volunteer"}
      </span>
      <SearchIcon class="volunteer-search-icon" />
      <input
        type="search"
        name="q"
        data-volunteer-search
        value={search}
        maxlength="100"
        placeholder="Search by name"
      />
    </label>
    <button class="btn btn-outline" type="submit">Search</button>
  </form>
  {
    applications && (
      <form
        class="volunteer-filters"
        method="get"
        role="group"
        aria-label="Application status"
        data-volunteer-filters
      >
        {Object.entries(formFields).map(([name, value]) => (
          <input type="hidden" name={name} value={value} />
        ))}
        {search && <input type="hidden" name="q" value={search} />}
        <input type="hidden" name="sort" value={sort} />
        <input type="hidden" name="direction" value={direction} />
        <button
          class="volunteer-filter"
          type="submit"
          name="approval"
          value="all"
          data-volunteer-filter="all"
          aria-controls={`${kind}-table`}
          aria-pressed={approval === "all" ? "true" : "false"}
        >
          <span>
            All (
            <span data-all-applicants-count>{people.allApplicantsCount}</span>)
          </span>
        </button>
        {Object.entries(applicationStatuses).map(([value, status]) => (
          <button
            class="volunteer-filter"
            type="submit"
            name="approval"
            value={value}
            data-volunteer-filter={value}
            aria-controls={`${kind}-table`}
            aria-pressed={approval === value ? "true" : "false"}
          >
            <span>
              <span
                class="application-table-progress application-status-text"
                data-state={status.state}
              >
                {status.label}
              </span>{" "}
              (
              {value === "awaiting" ? (
                <span data-awaiting-approval-count>
                  {people.awaitingApprovalCount}
                </span>
              ) : (
                <span>{statusCounts[value as keyof typeof statusCounts]}</span>
              )}
              )
            </span>
          </button>
        ))}
      </form>
    )
  }
  <div data-volunteer-results>
    <div class="volunteer-table-shell">
      <TableScrollFrame
        class="volunteer-table-frame"
        label={applications ? "Application table" : "Volunteer table"}
      >
        <table class="volunteer-table" id={`${kind}-table`}>
          <caption class="sr-only">
            {
              applications
                ? "Applicants, roles, status, and completion dates"
                : "Approved volunteers and roles"
            }
          </caption>
          <thead>
            <tr>
              {
                columns.map(({ key, label }) => {
                  const active = sort === key;
                  const nextDirection =
                    active && direction === "asc" ? "desc" : "asc";
                  return (
                    <th
                      scope="col"
                      data-directory-column={key}
                      aria-sort={
                        active
                          ? direction === "asc"
                            ? "ascending"
                            : "descending"
                          : undefined
                      }
                    >
                      <a
                        class="volunteer-table-sort"
                        href={urlForState({
                          ...state,
                          sort: key,
                          direction: nextDirection,
                          offset: 0,
                        })}
                        data-volunteer-sort={key}
                        aria-controls={`${kind}-table`}
                        aria-label={`${label}: sort ${nextDirection === "asc" ? "ascending" : "descending"}`}
                      >
                        <span>{label}</span>
                        <ArrowRightIcon class="volunteer-table-sort-icon" />
                      </a>
                    </th>
                  );
                })
              }
            </tr>
          </thead>
          <tbody>
            {
              people.rows.map((person) => (
                <tr data-volunteer-row>
                  <th scope="row">
                    <div class="volunteer-table-person">
                      <AttendeeAvatar
                        category={person.category}
                        medicMark={Boolean(person.medicMark)}
                        decorative
                      />
                      <div class="volunteer-table-name">
                        <CompactPersonName
                          name={person.name}
                          href={profileHref(person.id)}
                          data-volunteer-profile-link
                        />
                        {!applications && person.role === "organizer" && (
                          <VolunteerRoleBadge role="organizer" />
                        )}
                        {!applications &&
                          person.category === "new-volunteer" && (
                            <NewVolunteerBadge />
                          )}
                        {Boolean(person.medicMark) && (
                          <VolunteerRoleBadge role="medic" />
                        )}
                      </div>
                    </div>
                  </th>
                  {applications && (
                    <>
                      <td>
                        <span
                          class="application-table-progress application-status-text"
                          data-state={
                            applicationStatuses[applicationStatus(person)].state
                          }
                        >
                          {applicationStatuses[applicationStatus(person)].label}
                        </span>
                      </td>
                      <td>
                        {person.applicationCompletedAt !== null ? (
                          <time
                            datetime={new Date(
                              person.applicationCompletedAt,
                            ).toISOString()}
                          >
                            {formatApplicationCompletedTime(
                              new Date(
                                person.applicationCompletedAt,
                              ).toISOString(),
                            )}
                          </time>
                        ) : null}
                      </td>
                    </>
                  )}
                </tr>
              ))
            }
          </tbody>
        </table>
      </TableScrollFrame>
    </div>
    {
      !people.rows.length && (
        <p class="volunteer-notice">
          {applications
            ? emptyApplications
            : offset > 0
              ? "No volunteers on this page. Return to the previous page."
              : search
                ? "No volunteers match your search."
                : "No approved volunteers yet."}
        </p>
      )
    }
    <div class="volunteer-actions">
      {
        offset > 0 && (
          <a
            class="btn btn-quiet"
            href={urlForState({
              ...state,
              offset: Math.max(0, offset - volunteerPageSize),
            })}
          >
            Previous {kind}
          </a>
        )
      }
      {
        people.hasMore && (
          <a
            class="btn btn-quiet"
            href={urlForState({ ...state, offset: offset + volunteerPageSize })}
          >
            Next {kind}
          </a>
        )
      }
    </div>
  </div>
  <p data-volunteer-search-error class="volunteer-notice" role="status" hidden>
  </p>
</section>
