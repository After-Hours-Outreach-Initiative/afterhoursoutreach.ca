---
import DirectoryRow from "./DirectoryRow.astro";
import SearchIcon from "../icons/SearchIcon.astro";
import ArrowRightIcon from "../icons/ArrowRightIcon.astro";
import TableScrollFrame from "../TableScrollFrame.astro";
import {
  directoryListUrl,
  applicationStatuses,
  directoryEmptyMessage,
  type DirectoryListState,
  type DirectorySort,
} from "../../data/volunteer-list";
import type { listVolunteers } from "../../server/db/volunteers";

interface Props {
  kind: "applications" | "volunteers";
  people: Awaited<ReturnType<typeof listVolunteers>>;
  state: DirectoryListState;
  urlForState?: (state: DirectoryListState) => string;
  profileHref?: (id: string) => string;
  formFields?: Record<string, string>;
}
const { kind, people, state, formFields = {} } = Astro.props;
const applications = kind === "applications";
const title = applications ? "Applications" : "Volunteers";
const urlForState =
  Astro.props.urlForState ??
  ((next: DirectoryListState) => directoryListUrl(kind, next));
const listUrl = urlForState(state);
const profileHref =
  Astro.props.profileHref ??
  ((id: string) =>
    `/${kind}/${encodeURIComponent(id)}?returnTo=${encodeURIComponent(listUrl)}`);
const { search, approval, sort, direction } = state;
const visibleIds = new Set(people.rows.map(({ id }) => id));
const cachedRows = people.allRows.filter(({ id }) => !visibleIds.has(id));
const statusCounts = {
  awaiting: people.awaitingApprovalCount,
  "in-progress": people.inProgressCount,
  rejected: people.rejectedCount,
  approved: people.approvedCount,
};
const columns = (
  applications
    ? [
        { key: "name", label: "Name" },
        { key: "progress", label: "Status" },
        { key: "completed", label: "Completed" },
      ]
    : [{ key: "name", label: "Name" }]
) satisfies { key: DirectorySort; label: string }[];
---

<section
  class="volunteer-events"
  data-volunteer-browser
  data-directory-kind={kind}
  aria-labelledby={`${kind}-heading`}
>
  <div class="volunteer-section-heading">
    <h2 id={`${kind}-heading`}>{title}</h2>
  </div>
  <form class="volunteer-search" method="get" data-volunteer-search-form>
    {
      Object.entries(formFields).map(([name, value]) => (
        <input type="hidden" name={name} value={value} />
      ))
    }
    {applications && <input type="hidden" name="approval" value={approval} />}
    <input type="hidden" name="sort" value={sort} />
    <input type="hidden" name="direction" value={direction} />
    <label class="volunteer-search-field">
      <span class="sr-only">
        {applications ? "Find an applicant" : "Find a volunteer"}
      </span>
      <SearchIcon class="volunteer-search-icon" />
      <input
        type="search"
        name="q"
        data-volunteer-search
        value={search}
        maxlength="100"
        placeholder="Search by name"
      />
    </label>
    <button class="btn btn-outline" type="submit" data-volunteer-search-submit
      >Search</button
    >
  </form>
  {
    applications && (
      <form
        class="volunteer-filters"
        method="get"
        role="group"
        aria-label="Application status"
        data-volunteer-filters
      >
        {Object.entries(formFields).map(([name, value]) => (
          <input type="hidden" name={name} value={value} />
        ))}
        <input type="hidden" name="q" value={search} />
        <input type="hidden" name="sort" value={sort} />
        <input type="hidden" name="direction" value={direction} />
        <button
          class="volunteer-filter"
          type="submit"
          name="approval"
          value="all"
          data-volunteer-filter="all"
          aria-controls={`${kind}-table`}
          aria-pressed={approval === "all" ? "true" : "false"}
        >
          <span>
            All (
            <span data-all-applicants-count data-volunteer-count="all">
              {people.allApplicantsCount}
            </span>
            )
          </span>
        </button>
        {Object.entries(applicationStatuses).map(([value, status]) => (
          <button
            class="volunteer-filter"
            type="submit"
            name="approval"
            value={value}
            data-volunteer-filter={value}
            aria-controls={`${kind}-table`}
            aria-pressed={approval === value ? "true" : "false"}
          >
            <span>
              <span
                class="application-table-progress application-status-text"
                data-state={status.state}
              >
                {status.label}
              </span>{" "}
              (
              {value === "awaiting" ? (
                <span data-awaiting-approval-count data-volunteer-count={value}>
                  {people.awaitingApprovalCount}
                </span>
              ) : (
                <span data-volunteer-count={value}>
                  {statusCounts[value as keyof typeof statusCounts]}
                </span>
              )}
              )
            </span>
          </button>
        ))}
      </form>
    )
  }
  <div data-volunteer-results>
    <div class="volunteer-table-shell">
      <TableScrollFrame
        class="volunteer-table-frame"
        label={applications ? "Application table" : "Volunteer table"}
      >
        <table class="volunteer-table" id={`${kind}-table`}>
          <caption class="sr-only">
            {
              applications
                ? "Applicants, roles, status, and completion dates"
                : "Approved volunteers and roles"
            }
          </caption>
          <thead>
            <tr>
              {
                columns.map(({ key, label }) => {
                  const active = sort === key;
                  const nextDirection =
                    active && direction === "asc" ? "desc" : "asc";
                  return (
                    <th
                      scope="col"
                      data-directory-column={key}
                      aria-sort={
                        active
                          ? direction === "asc"
                            ? "ascending"
                            : "descending"
                          : undefined
                      }
                    >
                      <a
                        class="volunteer-table-sort"
                        href={urlForState({
                          ...state,
                          sort: key,
                          direction: nextDirection,
                        })}
                        data-volunteer-sort={key}
                        aria-controls={`${kind}-table`}
                        aria-label={`${label}: sort ${nextDirection === "asc" ? "ascending" : "descending"}`}
                      >
                        <span>{label}</span>
                        <ArrowRightIcon class="volunteer-table-sort-icon" />
                      </a>
                    </th>
                  );
                })
              }
            </tr>
          </thead>
          <tbody>
            {
              people.rows.map((person) => (
                <DirectoryRow
                  person={person}
                  applications={applications}
                  href={profileHref(person.id)}
                />
              ))
            }
          </tbody>
        </table>
      </TableScrollFrame>
    </div>
    <p
      class="volunteer-notice"
      data-volunteer-empty
      hidden={Boolean(people.rows.length)}
    >
      {directoryEmptyMessage(kind, state)}
    </p>
    <template data-volunteer-cached-rows>
      <table>
        <tbody>
          {
            cachedRows.map((person) => (
              <DirectoryRow
                person={person}
                applications={applications}
                href={profileHref(person.id)}
              />
            ))
          }
        </tbody>
      </table>
    </template>
  </div>
  <p class="sr-only" role="status" data-volunteer-result-count></p>
  <p data-volunteer-search-error class="volunteer-notice" role="status" hidden>
  </p>
</section>
