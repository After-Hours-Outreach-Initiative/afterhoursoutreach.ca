---
import CloseIcon from "@/components/icons/CloseIcon.svg";
import FilterIcon from "@/components/icons/FilterIcon.astro";
import "@/styles/dialog.css";
import "@/styles/filter-panel.css";
import "@/styles/sheet.css";

interface Props {
  id: string;
  /** Names the small-screen button and sheet. */
  title: string;
  /** The number of filter options currently applied. */
  active: number;
  /** Where clearing every filter leads without scripts. */
  resetHref: string;
}
const { id, title, active, resetHref } = Astro.props;
---

<button
  class="volunteer-filter filter-panel-trigger"
  type="button"
  aria-haspopup="dialog"
  aria-controls={id}
  command="show-modal"
  commandfor={id}
  data-filter-panel-open
  data-active={active ? "" : undefined}
>
  <FilterIcon class="filter-button-icon" />
  {title}
  <span class="volunteer-filter-count" data-filter-panel-count hidden={!active}>
    {active}
    <span class="sr-only"> active</span>
  </span>
</button>
<dialog
  class="filter-panel sheet"
  id={id}
  aria-labelledby={`${id}-heading`}
  data-filter-panel
>
  <div class="dialog-header filter-panel-header sheet-header" data-sheet-handle>
    <span class="sheet-grabber" aria-hidden="true"></span>
    <h2 id={`${id}-heading`}>
      <FilterIcon class="filter-panel-heading-icon" />
      Filters
    </h2>
    <a
      class="filter-panel-reset"
      href={resetHref}
      data-filter-reset
      hidden={!active}
    >
      Clear filters
    </a>
    <button
      class="btn btn-quiet dialog-close"
      type="button"
      aria-label="Close"
      command="close"
      commandfor={id}
      data-filter-panel-close
    >
      <CloseIcon />
    </button>
  </div>
  <div class="filter-panel-body">
    <slot />
    <noscript>
      <button class="btn btn-primary filter-panel-apply" type="submit">
        Apply
      </button>
    </noscript>
  </div>
  <div class="dialog-footer filter-panel-footer">
    <button class="btn btn-primary" type="submit" data-filter-panel-close>
      Show results
    </button>
  </div>
</dialog>
