---
import Layout from "@/layouts/Layout.astro";
import "@/styles/account.css";
import "@/styles/volunteer.css";
import CodeIcon from "@/components/icons/CodeIcon.astro";
import DialogHeader from "@/components/DialogHeader.astro";
import { env } from "cloudflare:workers";
import { loadAccountNavigation } from "@/server/account-navigation";
interface Props {
  title: string;
  description: string;
  signedIn?: boolean;
  organizer?: boolean;
  eventAccess?: boolean;
  name?: string;
  greetingName?: string;
  email?: string;
  publicSpacing?: boolean;
}
const {
  title,
  description,
  signedIn = false,
  organizer = false,
  eventAccess,
  name,
  greetingName,
  email,
  publicSpacing = false,
} = Astro.props;
// Account forms also need the same authoritative navigation as public pages.
const account =
  signedIn && eventAccess === undefined
    ? await loadAccountNavigation(env, Astro.request, Astro.response.headers)
    : { signedIn, organizer, eventAccess, name, greetingName, email };
---

<Layout
  title={`${title} | After Hours Outreach Initiative`}
  description={description}
  noindex
  privatePage
  account={account}
>
  <section class="volunteer-portal bg-black" data-account-layout>
    <div
      class:list={[
        "volunteer-wrap",
        { "volunteer-wrap-public": publicSpacing },
      ]}
    >
      {
        import.meta.env.DEV && (
          <Fragment>
            <button
              class="fixed right-4 bottom-4 z-40 flex size-11 items-center justify-center rounded-lg border border-zinc-600 bg-ink text-amber-300 hover:border-white"
              type="button"
              data-open-account-switcher
              aria-label="DEV panel"
              title="DEV panel (Alt+Z)"
              aria-keyshortcuts="Alt+Z"
              aria-haspopup="dialog"
              aria-controls="development-account-dialog"
              aria-expanded="false"
            >
              <CodeIcon class="size-5" />
            </button>
            <dialog
              id="development-account-dialog"
              class="dialog-pop dialog-frame volunteer-dialog"
              data-account-switcher
              aria-labelledby="development-account-dialog-heading"
            >
              <DialogHeader
                id="development-account-dialog-heading"
                title="DEV panel"
                closeLabel="Close DEV panel"
                closeAttributes={{ "data-close-account-switcher": "" }}
              />
              <div class="dialog-body">
                <div class="volunteer-form">
                  <div
                    class="grid gap-6"
                    data-view-as
                    role="group"
                    aria-label="View as"
                    aria-busy="true"
                  >
                    <section class="account-profile-switcher">
                      <h3 class="text-lg" id="development-states-heading">
                        Account states
                      </h3>
                      <div
                        class="grid gap-3"
                        data-account-states
                        role="group"
                        aria-labelledby="development-states-heading"
                      >
                        <button
                          class="btn btn-quiet account-profile-button"
                          type="button"
                          data-switch-user=""
                          aria-pressed="false"
                          disabled
                        >
                          Visitor
                        </button>
                      </div>
                      <button
                        class="btn btn-outline justify-self-start"
                        type="button"
                        data-seed-accounts
                        aria-describedby="development-seed-description"
                        disabled
                      >
                        Seed local accounts
                      </button>
                      <p
                        class="volunteer-help"
                        id="development-seed-description"
                      >
                        Add grouped application, orientation, volunteer, and
                        access presets with sample events. Existing edits are
                        preserved; unchanged old presets are upgraded.
                      </p>
                    </section>
                    <section class="account-profile-switcher border-t border-zinc-700 pt-6">
                      <h3 class="text-lg" id="development-steps-heading">
                        Application steps
                      </h3>
                      <p class="volunteer-help" data-step-account>
                        Choose an account to use these shortcuts.
                      </p>
                      <p
                        class="volunteer-help"
                        id="development-steps-description"
                      >
                        Step 1 submits fictional sample answers.
                        Already-submitted answers are never replaced. No emails
                        are sent. Discord membership is simulated locally only.
                      </p>
                      <div
                        class="grid gap-2"
                        role="group"
                        aria-labelledby="development-steps-heading"
                      >
                        {[
                          ["form", "1. Submit sample application"],
                          ["naloxone", "2. Complete Naloxone 101"],
                          ["discord", "3. Simulate Discord connection"],
                          ["review", "4. Approve application"],
                        ].map(([step, label]) => (
                          <button
                            class="btn btn-quiet flex-wrap justify-between text-left"
                            type="button"
                            data-application-step={step}
                            aria-describedby="development-steps-description"
                            disabled
                          >
                            <span>{label}</span>
                            <span
                              class="account-profile-detail"
                              data-step-status
                            />
                          </button>
                        ))}
                      </div>
                    </section>
                    <section class="account-profile-switcher border-t border-zinc-700 pt-6">
                      <h3 class="text-lg" id="development-accounts-heading">
                        Existing accounts
                      </h3>
                      <div
                        class="account-profile-buttons"
                        data-existing-accounts
                        role="group"
                        aria-labelledby="development-accounts-heading"
                      />
                      <p class="volunteer-help" data-empty-accounts hidden>
                        No saved accounts yet.
                      </p>
                    </section>
                  </div>
                  <p data-switch-message role="status" hidden />
                </div>
              </div>
              <div class="dialog-footer">
                <a
                  class="btn btn-quiet"
                  href="/volunteer/sign-in"
                  data-create-account
                >
                  Create an account
                </a>
              </div>
            </dialog>
          </Fragment>
        )
      }
      <slot name="heading">
        <h1 class="sr-only">{title}</h1>
      </slot>
      <slot />
    </div>
  </section>
</Layout>
<script>
  import "@/scripts/account";
</script>
