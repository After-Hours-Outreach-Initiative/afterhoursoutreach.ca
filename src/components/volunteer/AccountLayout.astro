---
import Layout from "@/layouts/Layout.astro";
import "@/styles/account.css";
import "@/styles/volunteer.css";
import { env } from "cloudflare:workers";
import { loadAccountNavigation } from "@/server/account-navigation";
interface Props {
  title: string;
  description: string;
  signedIn?: boolean;
  organizer?: boolean;
  eventAccess?: boolean;
  name?: string;
  greetingName?: string;
  email?: string;
  publicSpacing?: boolean;
}
const {
  title,
  description,
  signedIn = false,
  organizer = false,
  eventAccess,
  name,
  greetingName,
  email,
  publicSpacing = false,
} = Astro.props;
// Account forms also need the same authoritative navigation as public pages.
const account =
  signedIn && eventAccess === undefined
    ? await loadAccountNavigation(env, Astro.request, Astro.response.headers)
    : { signedIn, organizer, eventAccess, name, greetingName, email };
---

<Layout
  title={`${title} | After Hours Outreach Initiative`}
  description={description}
  noindex
  privatePage
  account={account}
>
  <section class="volunteer-portal bg-black" data-account-layout>
    <div
      class:list={[
        "volunteer-wrap",
        { "volunteer-wrap-public": publicSpacing },
      ]}
    >
      <slot name="heading">
        <h1 class="sr-only">{title}</h1>
      </slot>
      <slot />
    </div>
  </section>
</Layout>
<script>
  import "@/scripts/account";
</script>
