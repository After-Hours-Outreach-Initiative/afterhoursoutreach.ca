---
import Layout from "@/layouts/Layout.astro";
import "@/styles/account.css";
import "@/styles/volunteer.css";
import { env } from "cloudflare:workers";
import { loadAccountNavigation } from "@/server/account-navigation";
import type { accountContext } from "@/server/db/access";
interface Props {
  context?: Awaited<ReturnType<typeof accountContext>>;
  title: string;
  description: string;
  signedIn?: boolean;
  organizer?: boolean;
  eventAccess?: boolean;
  readyApplicationCount?: number;
  name?: string;
  greetingName?: string;
  email?: string;
  publicSpacing?: boolean;
}
const {
  context,
  title,
  description,
  signedIn = false,
  organizer = false,
  eventAccess,
  readyApplicationCount = 0,
  name,
  greetingName,
  email,
  publicSpacing = false,
} = Astro.props;
// Account forms also need the same authoritative navigation as public pages.
const account =
  signedIn && eventAccess === undefined
    ? await loadAccountNavigation(
        env,
        Astro.request,
        Astro.response.headers,
        context,
      )
    : {
        signedIn,
        organizer,
        eventAccess,
        readyApplicationCount,
        name,
        greetingName,
        email,
      };
---

<Layout
  title={`${title} | After Hours Outreach Initiative`}
  description={description}
  noindex
  privatePage
  account={account}
>
  <section class="volunteer-portal bg-black" data-account-layout>
    <div
      class:list={[
        "volunteer-wrap",
        { "volunteer-wrap-public": publicSpacing },
      ]}
    >
      <slot name="heading">
        <h1 class="sr-only">{title}</h1>
      </slot>
      <slot />
    </div>
  </section>
</Layout>
<script>
  import "@/scripts/account";
</script>
