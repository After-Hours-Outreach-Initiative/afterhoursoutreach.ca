---
import type { EventRow, RosterRow } from "@/server/db/events";
import SignupEditor from "./SignupEditor.astro";
import AttendeeAvatar from "./AttendeeAvatar.astro";
import EventRosterSummary from "./EventRosterSummary.astro";

interface Props {
  event: EventRow;
  roster: RosterRow[];
  future: boolean;
  destinations: EventRow[];
}
const { event, roster, future, destinations } = Astro.props;
---

<details class="volunteer-roster">
  <EventRosterSummary count={roster.length} />
  {roster.length === 0 && <p>No volunteers registered yet.</p>}
  <table class="event-roster-table" hidden={roster.length === 0}>
    <caption class="sr-only">Registered volunteers</caption>
    <thead class="sr-only">
      <tr>
        <th scope="col">Volunteer</th>
        {future && <th scope="col">Registration actions</th>}
      </tr>
    </thead>
    <tbody>
      {
        roster.map((person) => (
          <tr>
            <th scope="row">
              <div class="event-roster-person">
                <AttendeeAvatar category={person.category} />
                <div class="event-roster-name">
                  <a
                    href={`/manage/volunteers/${encodeURIComponent(person.userId)}`}
                    data-volunteer-profile-link
                  >
                    {person.name}
                  </a>
                  {Boolean(person.completed) && (
                    <span class="event-roster-status">
                      Orientation completed
                    </span>
                  )}
                </div>
              </div>
              {Boolean(event.includesOrientation) &&
                !future &&
                !event.cancelledAt &&
                !person.completed && (
                  <form
                    class="event-roster-orientation"
                    data-organizer-orientation
                    action="/api/v1/organizer/action"
                    method="post"
                  >
                    <input name="userId" type="hidden" value={person.userId} />
                    <input name="eventId" type="hidden" value={event.id} />
                    <button
                      class="btn btn-outline"
                      type="submit"
                      data-loading-label="Saving…"
                    >
                      Mark orientation completed
                    </button>
                    <p data-form-message role="status" hidden />
                  </form>
                )}
            </th>
            {future && (
              <td class="event-roster-actions">
                <SignupEditor signup={person} destinations={destinations} />
              </td>
            )}
          </tr>
        ))
      }
    </tbody>
  </table>
</details>
