---
import type { PatrolSeriesRow } from "@/server/db/events";
import NativeDateInput from "./NativeDateInput.astro";
interface Props {
  series: PatrolSeriesRow[];
}
const { series } = Astro.props;
---

<section
  data-series-list
  aria-labelledby="series-heading"
  class="volunteer-events"
>
  <h2 id="series-heading">Recurring patrols</h2>
  <p class="volunteer-help">
    Manage any scheduled date, including beyond the volunteers’ next three
    occurrences. The original first date and weekly interval define stable
    occurrence IDs. To change the cadence, stop the series and create another.
  </p>
  {
    series.length === 0 && (
      <p>
        No recurring patrols yet. Choose “Repeat patrol” when adding an event.
      </p>
    )
  }
  {
    series.map((item) => (
      <details
        class="volunteer-panel"
        data-live-series={item.id}
        data-series-version={item.updatedAt}
      >
        <summary>
          {item.meetingPoint} · Every {item.intervalWeeks}{" "}
          {item.intervalWeeks === 1 ? "week" : "weeks"} from {item.firstDate}{" "}
          (original time {item.localTime})
          {item.stoppedFrom
            ? ` · Stopped from ${item.stoppedFrom}`
            : item.endDate
              ? ` · Through ${item.endDate}`
              : ""}
        </summary>
        <p class="volunteer-help">
          Individual exceptions and this-and-future edits can override the
          original details above. Open an occurrence to see its current date,
          time and meeting point.
        </p>
        <form
          class="volunteer-form"
          data-series-occurrence
          action="/api/v1/events/action"
          method="post"
        >
          <input type="hidden" name="seriesId" value={item.id} />
          <label class="volunteer-field">
            Scheduled date to manage
            <NativeDateInput
              name="occurrenceDate"
              min={item.firstDate}
              required
            />
          </label>
          <p class="volunteer-help">
            Choose an original scheduled date, not the rescheduled date of an
            individual exception. Open it to edit or cancel only that
            occurrence, or this and future occurrences. Existing past and
            cancelled occurrences can also be opened after the series ends.
          </p>
          <button
            class="btn btn-outline"
            type="submit"
            data-loading-label="Opening…"
          >
            Open occurrence
          </button>
          <p data-form-message role="status" hidden />
        </form>
        <form
          class="volunteer-form"
          data-series-end
          data-email-prompt="series-cancel"
          action="/api/v1/events/action"
          method="post"
        >
          <input type="hidden" name="seriesId" value={item.id} />
          <input type="hidden" name="version" value={item.updatedAt} />
          <input type="hidden" name="series" value={JSON.stringify(item)} />
          <label class="volunteer-field">
            Last recurring date (optional, inclusive)
            <NativeDateInput
              name="endDate"
              min={item.firstDate}
              value={item.endDate ?? ""}
            />
          </label>
          <p class="volunteer-help">
            Shortening cancels future occurrences and bookings after this
            nominal date, including individual exceptions. Extending never
            restores cancelled occurrences or restarts a stopped series.
          </p>
          <button
            class="btn btn-outline"
            type="submit"
            data-loading-label="Saving…"
          >
            Save end date
          </button>
          <p data-form-message role="status" hidden />
        </form>
        <form
          class="volunteer-form volunteer-danger"
          data-series-stop
          data-email-prompt="series-cancel"
          action="/api/v1/events/action"
          method="post"
        >
          <input type="hidden" name="seriesId" value={item.id} />
          <input type="hidden" name="version" value={item.updatedAt} />
          <label class="volunteer-field">
            Stop from scheduled date
            <NativeDateInput
              name="occurrenceDate"
              min={item.firstDate}
              max={item.endDate ?? undefined}
              required
            />
          </label>
          <label class="volunteer-field">
            Reason (optional)
            <textarea name="reason" maxlength="1000" rows="2" />
          </label>
          <p class="volunteer-help">
            Permanently stop this and future occurrences. Their bookings are
            cancelled; previous occurrences and history stay intact.
          </p>
          <button
            class="btn btn-red"
            type="submit"
            data-loading-label="Stopping…"
          >
            Stop recurrence
          </button>
          <p data-form-message role="status" hidden />
        </form>
      </details>
    ))
  }
</section>
