---
import type { PatrolSeriesRow } from "@/server/db/events";
import EventFields from "./EventFields.astro";
interface Props {
  series: PatrolSeriesRow;
}
const { series } = Astro.props;
---

<details
  class="volunteer-series-settings"
  data-live-series={series.id}
  data-series-version={series.updatedAt}
>
  <summary>Series settings</summary>
  <form
    class="volunteer-form"
    data-series-save
    data-email-prompt="series-cancel"
    action="/api/v1/events/action"
    method="post"
  >
    <input type="hidden" name="seriesId" value={series.id} />
    <input type="hidden" name="version" value={series.updatedAt} />
    <div class="volunteer-fields">
      <EventFields id={`series-${series.id}`} {series} />
    </div>
    <button
      class="btn btn-outline"
      type="submit"
      data-loading-label="Saving…"
      disabled>Save series defaults</button
    >
    <p data-form-message role="status" hidden></p>
  </form>
  <form
    class="volunteer-form volunteer-danger"
    data-event-delete="series"
    data-email-prompt="series-cancel"
    action="/api/v1/events/action"
    method="post"
  >
    <input type="hidden" name="action" value="delete-series" />
    <input type="hidden" name="id" value={series.id} />
    <input type="hidden" name="version" value={series.updatedAt} />
    <button class="btn btn-red" type="submit" data-loading-label="Deleting…"
      >Delete series</button
    >
    <p data-form-message role="status" hidden></p>
  </form>
</details>
