---
import type { PatrolSeriesRow } from "@/server/db/events";
import DialogHeader from "@/components/DialogHeader.astro";
import EventFields from "./EventFields.astro";
interface Props {
  series: PatrolSeriesRow;
}
const { series } = Astro.props;
const dialogId = `series-editor-${series.id}`;
---

<dialog
  class="dialog-pop dialog-frame volunteer-dialog"
  id={dialogId}
  aria-labelledby={`${dialogId}-heading`}
  data-live-series={series.id}
  data-series-version={series.updatedAt}
>
  <DialogHeader id={`${dialogId}-heading`} title="Edit series" />
  <div class="dialog-body">
    <form
      id={`${dialogId}-save`}
      class="volunteer-form"
      data-series-save
      data-email-prompt="series-cancel"
      action="/api/v1/events/action"
      method="post"
    >
      <input type="hidden" name="seriesId" value={series.id} />
      <input type="hidden" name="version" value={series.updatedAt} />
      <p class="volunteer-help">
        New defaults apply only to occurrences not yet generated. Existing
        occurrences, registrations and this-and-future overrides are kept.
        Intervals count from the fixed start date.
      </p>
      <div class="volunteer-fields">
        <EventFields id={dialogId} {series} />
      </div>
      <p data-form-message role="status" hidden></p>
    </form>
    <form
      id={`${dialogId}-delete`}
      data-event-delete="series"
      data-email-prompt="series-cancel"
      action="/api/v1/events/action"
      method="post"
    >
      <input type="hidden" name="action" value="delete-series" />
      <input type="hidden" name="id" value={series.id} />
      <input type="hidden" name="version" value={series.updatedAt} />
      <p data-form-message role="status" hidden></p>
    </form>
  </div>
  <div class="dialog-footer">
    <button
      class="btn btn-primary"
      type="submit"
      form={`${dialogId}-save`}
      data-loading-label="Saving…"
      disabled>Save series defaults</button
    >
    <button
      class="btn btn-red"
      type="submit"
      form={`${dialogId}-delete`}
      data-loading-label="Deleting…">Delete series</button
    >
  </div>
</dialog>
