---
import ChevronDownIcon from "@/components/icons/ChevronDownIcon.astro";
import type { EventRow, PublicRosterRow } from "@/server/db/events";
import EventAttendance from "./EventAttendance.astro";

interface Props {
  roster: Pick<PublicRosterRow, "category" | "medicMark">[];
  event: EventRow;
}
const { roster, event } = Astro.props;
const newMedicCount = roster.filter(
  (person) => person.category === "new-volunteer" && person.medicMark,
).length;
---

<summary class="event-roster-toggle">
  <span class="text-sm">Volunteers ({roster.length})</span>
  <ChevronDownIcon class="event-roster-chevron size-5 shrink-0" />
  <EventAttendance event={event} newMedicCount={newMedicCount} />
</summary>

<style>
  .event-roster-toggle {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: 0.5rem 1rem;
    width: 100%;
    min-height: 3rem;
    padding: 0.75rem 1rem;
    border: 1px solid #52525b;
    border-radius: 0.5rem;
    background: #0c0d10;
    color: #e4e4e7;
    cursor: pointer;
    list-style: none;
  }
  .event-roster-toggle > :global(.event-attendance) {
    grid-column: 1;
    grid-row: 2;
  }
  .event-roster-toggle > :global(.event-roster-chevron) {
    grid-column: 2;
    grid-row: 1 / 3;
  }
  .event-roster-toggle::-webkit-details-marker {
    display: none;
  }
  .event-roster-toggle:hover {
    border-color: #a5b4fc;
    background: #18181b;
    color: white;
  }
  .event-roster-toggle:focus-visible {
    outline: 3px solid #a5b4fc;
    outline-offset: 3px;
  }
  :global(details[open]) > .event-roster-toggle {
    border-color: var(--event-roster-open-border);
    border-radius: 0.5rem 0.5rem 0 0;
    background: #16214a;
  }
  :global(details[open]) > .event-roster-toggle :global(.event-roster-chevron) {
    transform: rotate(180deg);
  }
  @media (prefers-reduced-motion: no-preference) {
    .event-roster-toggle > :global(.event-roster-chevron) {
      transition: transform 180ms ease-out;
    }
  }
  @container event-card (min-width: 32rem) {
    .event-roster-toggle {
      grid-template-columns: auto minmax(0, 1fr) auto;
    }
    .event-roster-toggle > :global(.event-attendance) {
      grid-column: 2;
      grid-row: 1;
    }
    .event-roster-toggle > :global(.event-roster-chevron) {
      grid-column: 3;
      grid-row: 1;
    }
  }
</style>
