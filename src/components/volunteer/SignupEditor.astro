---
import type { EventRow, RosterRow } from "@/server/db/events";
import { formatEventDate } from "@/data/event-time";
import FieldError from "@/components/FieldError.astro";
import DialogHeader from "@/components/DialogHeader.astro";

interface Props {
  signup: RosterRow;
  destinations: EventRow[];
}
const { signup, destinations } = Astro.props;
---

<button
  class="btn btn-quiet"
  type="button"
  data-show-dialog={`signup-editor-${signup.id}`}>Move or remove</button
>
<dialog
  class="dialog-pop dialog-frame volunteer-dialog"
  id={`signup-editor-${signup.id}`}
  aria-labelledby={`signup-editor-heading-${signup.id}`}
>
  <DialogHeader
    id={`signup-editor-heading-${signup.id}`}
    title="Change a registration"
  />
  <div class="dialog-body">
    <p class="mb-6">{signup.name}</p>
    <form
      id={`signup-editor-form-${signup.id}`}
      class="volunteer-form"
      data-manage-signup
      data-email-prompt="signup"
      action="/api/v1/events/action"
      method="post"
    >
      <input type="hidden" name="id" value={signup.id} />
      <label class="volunteer-field">
        Destination
        <select name="destination">
          <option value="">Remove registration</option>
          {
            destinations.map((event) => (
              <option value={event.id}>
                {`Patrol${event.includesOrientation ? " (includes orientation)" : ""} · ${formatEventDate(event.startsAt)}`}
              </option>
            ))
          }
        </select>
      </label>
      <div class="volunteer-field">
        <label for={`signup-reason-${signup.id}`}>Reason (optional)</label>
        <textarea
          id={`signup-reason-${signup.id}`}
          name="reason"
          aria-describedby={`error-signup-reason-${signup.id}`}
          rows="3"
          maxlength="1000"></textarea>
        <FieldError
          field={`signup-reason-${signup.id}`}
          message="Keep the reason to 1000 characters or fewer."
        />
      </div>
      {
        !import.meta.env.DEV && (
          <p class="volunteer-help">
            Included in the email if you choose to send one. Do not include
            medical or other sensitive information.
          </p>
        )
      }
      <p data-form-message role="status" hidden></p>
    </form>
  </div>
  <div class="dialog-footer">
    <button
      class="btn btn-outline"
      type="submit"
      form={`signup-editor-form-${signup.id}`}
      data-loading-label="Saving…">Save change</button
    >
  </div>
</dialog>
