---
import AttendeeAvatar from "./AttendeeAvatar.astro";
import NewVolunteerBadge from "./NewVolunteerBadge.astro";
import VolunteerRoleBadge from "./VolunteerRoleBadge.astro";
import CompactPersonName from "./CompactPersonName.astro";
import { formatApplicationCompletedTime } from "../../data/application";
import {
  applicationStatuses,
  type DirectoryPerson,
} from "../../data/volunteer-list";

interface Props {
  person: DirectoryPerson;
  applications: boolean;
  href: string;
}
const { person, applications, href } = Astro.props;
// Explicitly allowlist browser data: server rows also contain account flags and
// review decisions that are unnecessary for instant directory search.
const {
  id,
  name,
  searchName,
  role,
  category,
  medicMark,
  status,
  applicationCompletedAt,
} = person;
const data: DirectoryPerson = {
  id,
  name,
  searchName,
  role,
  category,
  medicMark,
  status,
  applicationCompletedAt,
};
---

<li
  class="directory-item"
  data-volunteer-row
  data-directory-person={JSON.stringify(data)}
>
  <AttendeeAvatar
    category={category}
    medicMark={Boolean(medicMark)}
    applicant={applications && status !== "approved"}
    decorative
  />
  <div class="directory-item-body">
    <div class="directory-item-name">
      <CompactPersonName
        class="directory-item-link"
        name={name}
        href={href}
        data-volunteer-profile-link
      />
      {!applications && role === "organizer" && (
        <VolunteerRoleBadge role="organizer" />
      )}
      {!applications && category === "new-volunteer" && <NewVolunteerBadge />}
      {Boolean(medicMark) && <VolunteerRoleBadge role="medic" />}
    </div>
    {applications && (
      <div class="directory-item-meta">
        <span
          class="application-table-progress application-status-text"
          data-state={applicationStatuses[status].state}
        >
          {applicationStatuses[status].label}
        </span>
        {applicationCompletedAt !== null && (
          <time datetime={new Date(applicationCompletedAt).toISOString()}>
            {formatApplicationCompletedTime(
              new Date(applicationCompletedAt).toISOString(),
            )}
          </time>
        )}
      </div>
    )}
  </div>
</li>
