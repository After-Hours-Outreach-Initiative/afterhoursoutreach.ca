---
import type { Actor } from "@/server/db/access";
import type { EventRow, RosterRow, PatrolSeriesRow } from "@/server/db/events";
import { signupBlockReason } from "@/server/db/policy";
import { formatEventDate } from "@/data/event-time";
import { matchesEventFilter } from "@/data/event-browser";
import EventEditor from "./EventEditor.astro";
import EventRoster from "./EventRoster.astro";

interface Props {
  event: EventRow;
  actor: Actor | null;
  organizer: boolean;
  roster: RosterRow[];
  destinations: EventRow[];
  filter: string;
  series?: PatrolSeriesRow;
}
const { event, actor, organizer, roster, destinations, filter, series } =
  Astro.props;
const future = event.startsAt > Date.now();
const left = event.availableSpots;
const totalLeft = Math.max(0, event.spots - event.confirmed);
const blocked =
  future && event.seriesId && !event.inSignupWindow && !event.cancelledAt
    ? "Registration is available only for the next three patrol occurrences in this series."
    : signupBlockReason(
        actor,
        {
          ...event,
          startsAt: new Date(event.startsAt),
          open: Boolean(event.open) && !event.hidden && !event.cancelledAt,
          orientationSignupBlocked: Boolean(event.orientationSignupBlocked),
        },
        event.confirmed,
      );
---

<li
  class="volunteer-event-card"
  data-live-event={event.id}
  data-event-type="patrol"
  data-includes-orientation={String(Boolean(event.includesOrientation))}
  hidden={!matchesEventFilter(
    filter,
    Boolean(event.seriesId),
    Boolean(event.includesOrientation),
  )}
>
  <div class="volunteer-event-top">
    <div>
      {
        Boolean(event.signedUp) && (
          <span class="volunteer-badge">Registered</span>
        )
      }
      {
        event.cancelledAt ? (
          <p class="volunteer-hidden">Cancelled</p>
        ) : event.hidden || !event.open ? (
          <p class="volunteer-hidden">Public visibility off</p>
        ) : null
      }
      <h3>{formatEventDate(event.startsAt)}</h3>
      <p>{event.includesOrientation ? "Orientation + Patrol" : "Patrol"}</p>
      <p>
        Meeting at{" "}
        {
          event.meetingPointUrl ? (
            <a href={event.meetingPointUrl} target="_blank" rel="noreferrer">
              {event.meetingPoint}
            </a>
          ) : (
            event.meetingPoint
          )
        }
      </p>
      <p data-event-availability aria-live="polite" aria-atomic="true">
        <span
          class:list={[
            "volunteer-spots",
            {
              "volunteer-spots-full": left === 0,
              "volunteer-spots-low": left > 0 && left <= 2,
            },
          ]}
        >
          {
            totalLeft === 0
              ? "Full"
              : left === 0
                ? "No places available to you"
                : event.includesOrientation
                  ? `${left} spots available to you`
                  : `${left} spots left`
          }
        </span>{" "}· {event.confirmed} of {event.spots} spots taken
      </p>
      {
        Boolean(event.includesOrientation) && (
          <p class="volunteer-help">
            Two places reserved for volunteers without completed orientation;
            maximum four, included in total capacity. No minimum number of
            orientation registrations.
          </p>
        )
      }
      {
        organizer && series && (
          <p class="volunteer-help">
            Recurring patrol · nominal date {event.occurrenceDate}
            {!event.inSignupWindow && !event.cancelledAt && future
              ? " · Outside the volunteer signup window"
              : ""}
          </p>
        )
      }
      {!event.signedUp && actor && blocked && <p>{blocked}</p>}
    </div>
    <div class="volunteer-actions">
      {
        organizer ? null : event.signedUp && future ? (
          <form data-live-signup action="/api/v1/events/action" method="post">
            <input name="id" type="hidden" value={event.id} />
            <input name="action" type="hidden" value="cancel" />
            <button
              class="btn btn-red"
              type="submit"
              data-loading-label="Unregistering…"
            >
              Unregister
            </button>
            <p data-form-message role="status" hidden />
          </form>
        ) : !actor ? (
          <a class="btn btn-outline" href="#volunteer-signin">
            Sign in to register
          </a>
        ) : !blocked ? (
          <form data-live-signup action="/api/v1/events/action" method="post">
            <input name="id" type="hidden" value={event.id} />
            <input name="action" type="hidden" value="join" />
            <button
              class="btn btn-green"
              type="submit"
              data-loading-label="Registering…"
            >
              Register
            </button>
            <p data-form-message role="status" hidden />
          </form>
        ) : null
      }
      {
        organizer && future && !event.cancelledAt && (
          <button
            class="btn btn-quiet"
            type="button"
            data-show-dialog={`event-editor-${event.id}`}
          >
            Edit
          </button>
        )
      }
    </div>
  </div>
  {
    organizer && (
      <EventRoster
        event={event}
        roster={roster}
        future={future}
        destinations={destinations.filter((other) => other.id !== event.id)}
      />
    )
  }
  {
    organizer && future && !event.cancelledAt && (
      <EventEditor event={event} series={series} />
    )
  }
</li>
