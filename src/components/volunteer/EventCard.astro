---
import type { Actor } from "@/server/db/access";
import type {
  EventRow,
  RosterRow,
  PublicRosterRow,
  PatrolSeriesRow,
} from "@/server/db/events";
import { eventSignupBlockReason } from "@/server/db/policy";
import {
  formatEventDate,
  formatEventDay,
  formatEventTime,
  vancouverInput,
} from "@/data/event-time";
import { eventUnregisterDeadline } from "@/data/event-unregistration";
import EventEditor from "./EventEditor.astro";
import EventRoster from "./EventRoster.astro";
import PublicEventRoster from "./PublicEventRoster.astro";
import AddAttendee from "./AddAttendee.astro";

interface Props {
  event: EventRow;
  // The caller must gate access with canViewEvents.
  actor: Actor;
  organizer: boolean;
  roster: RosterRow[];
  destinations: EventRow[];
  series?: PatrolSeriesRow;
  publicRoster?: PublicRosterRow[];
  /** An organizer's preview of another viewer: show controls, never submit. */
  preview?: boolean;
}
const {
  event,
  actor,
  organizer,
  roster,
  destinations,
  series,
  publicRoster = [],
  preview = false,
} = Astro.props;
const future = event.startsAt > Date.now();
const unregisterOpen =
  Boolean(event.signedUp) &&
  !event.cancelledAt &&
  eventUnregisterDeadline(event) > Date.now();
const registrationOpen =
  future &&
  Boolean(event.open) &&
  !event.hidden &&
  !event.cancelledAt &&
  Boolean(event.inSignupWindow);
const canAddAttendee =
  organizer &&
  !event.cancelledAt &&
  (!future || registrationOpen) &&
  event.confirmed < event.spots;
const blocked =
  future && event.seriesId && !event.inSignupWindow && !event.cancelledAt
    ? "Registration is available only for the next three patrol occurrences in this series."
    : eventSignupBlockReason(
        actor,
        {
          ...event,
          startsAt: new Date(event.startsAt),
          open: Boolean(event.open) && !event.hidden && !event.cancelledAt,
        },
        event.confirmed,
      );
---

<li
  id={`event-${event.id}`}
  class="volunteer-event-card"
  tabindex="-1"
  data-live-event={event.id}
  data-event-series={event.seriesId ?? undefined}
  data-event-start={event.startsAt}
  data-event-label={`${event.includesOrientation ? "Orientation + Patrol" : "Patrol"} at ${event.meetingPoint}`}
  data-event-type="patrol"
  data-includes-orientation={String(Boolean(event.includesOrientation))}
>
  <div class="volunteer-event-layout">
    <div class="volunteer-event-info">
      {event.cancelledAt ? (
        <p class="volunteer-hidden">Cancelled</p>
      ) : event.hidden ? (
        <p class="volunteer-hidden">Public visibility off</p>
      ) : !event.open ? (
        <p class="volunteer-hidden">Registration closed</p>
      ) : null}
      <div class="volunteer-event-heading">
        {organizer && future && !event.cancelledAt && (
          <label class="volunteer-event-select">
            <input
              type="checkbox"
              data-bulk-event={event.id}
              data-bulk-version={event.updatedAt}
              data-bulk-day={formatEventDay(event.startsAt)}
              data-bulk-time={formatEventTime(event.startsAt)}
              data-bulk-place={event.meetingPoint}
              data-bulk-recurring={event.seriesId ? "" : undefined}
              data-bulk-values={JSON.stringify({
                startTime: vancouverInput(event.startsAt).slice(11),
                meetingPoint: event.meetingPoint,
                meetingPointUrl: event.meetingPointUrl ?? "",
                spots: String(event.spots),
                minMedicSpots: String(event.minMedicSpots),
                minNewVolunteerSpots: String(event.minNewVolunteerSpots),
                maxNewVolunteers: String(event.maxNewVolunteers),
                unregisterMinutes: String(event.unregisterMinutes),
                includesOrientation: String(Boolean(event.includesOrientation)),
                publicVisibility: String(Boolean(event.open && !event.hidden)),
              })}
            />
            <span class="sr-only">
              Select {formatEventDate(event.startsAt)} at {event.meetingPoint}
            </span>
          </label>
        )}
        <h3>{formatEventDate(event.startsAt)}</h3>
      </div>
      <p>
        {!future && "Past event · "}
        {event.includesOrientation ? "Orientation + Patrol" : "Patrol"}
      </p>
      <p>
        Meeting at{" "}
        {event.meetingPointUrl ? (
          <a href={event.meetingPointUrl} target="_blank" rel="noreferrer">
            {event.meetingPoint}
          </a>
        ) : (
          event.meetingPoint
        )}
      </p>
      <p data-event-availability aria-live="polite" aria-atomic="true">
        {!future ? (
          <>
            {event.signedUp ? "You registered · " : ""}
            {event.confirmed}{" "}
            {event.confirmed === 1 ? "registration" : "registrations"}
          </>
        ) : event.signedUp ? (
          <>
            <span class="volunteer-spots">Registered</span> ·{" "}
            {Math.max(0, event.spots - event.confirmed)} of {event.spots} spots
            remaining
          </>
        ) : event.confirmed >= event.spots ? (
          <>
            <span class="volunteer-spots-full">Full</span> · 0 of {event.spots}{" "}
            spots remaining
          </>
        ) : registrationOpen ? (
          <>
            <span class="volunteer-spots-open">Open</span> ·{" "}
            {event.spots - event.confirmed} of {event.spots} spots remaining
          </>
        ) : (
          `${Math.max(0, event.spots - event.confirmed)} of ${event.spots} spots remaining`
        )}
      </p>
      {future &&
        !event.signedUp &&
        (!organizer || Boolean(event.inSignupWindow)) &&
        !event.hidden &&
        !event.cancelledAt &&
        Boolean(event.open) &&
        blocked &&
        blocked !== "This event is full." && <p>{blocked}</p>}
    </div>
    <div class="volunteer-actions">
      {preview ? (
        unregisterOpen ? (
          <button class="btn btn-red" type="button" disabled>
            Unregister
          </button>
        ) : future && !event.signedUp && !blocked ? (
          <button class="btn btn-green" type="button" disabled>
            Register
          </button>
        ) : null
      ) : unregisterOpen ? (
        <form data-live-signup action="/api/v1/events/action" method="post">
          <input name="id" type="hidden" value={event.id} />
          <input name="action" type="hidden" value="cancel" />
          <button
            class="btn btn-red"
            type="submit"
            aria-haspopup="dialog"
            data-loading-label="Unregistering…"
          >
            Unregister
          </button>
          <p data-form-message role="status" hidden />
        </form>
      ) : future && !event.signedUp && !blocked ? (
        <form data-live-signup action="/api/v1/events/action" method="post">
          <input name="id" type="hidden" value={event.id} />
          <input name="action" type="hidden" value="join" />
          <button
            class="btn btn-green"
            type="submit"
            data-loading-label="Registering…"
          >
            Register
          </button>
          <p data-form-message role="status" hidden />
        </form>
      ) : null}
      {organizer && future && (
        <button
          class="btn btn-quiet"
          type="button"
          data-show-dialog={`event-editor-${event.id}`}
          aria-haspopup="dialog"
          aria-controls={`event-editor-${event.id}`}
        >
          Edit
        </button>
      )}
    </div>
  </div>
  {!organizer && future && publicRoster.length > 0 && (
    <PublicEventRoster event={event} roster={publicRoster} />
  )}
  {organizer && roster.length > 0 && (
    <EventRoster
      event={event}
      roster={roster}
      future={future}
      destinations={destinations.filter((other) => other.id !== event.id)}
    />
  )}
  {canAddAttendee && (
    <div class="volunteer-roster-add">
      <AddAttendee event={event} />
    </div>
  )}
  {organizer && future && <EventEditor event={event} series={series} />}
</li>

<style>
  .volunteer-event-card {
    --event-card-gap: 1rem;
    container: event-card / inline-size;
    padding: 1rem;
    scroll-margin-top: calc(
      var(--site-header-rendered-height, var(--site-header-height, 6rem)) + 1rem
    );
  }
  .volunteer-event-card[data-calendar-highlight] {
    animation: event-highlight 1.5s ease-out;
  }
  @keyframes event-highlight {
    from {
      border-color: #a5b4fc;
      box-shadow: 0 0 0 4px #818cf880;
    }
    to {
      border-color: #3f3f46;
      box-shadow: 0 0 0 0 transparent;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .volunteer-event-card[data-calendar-highlight] {
      animation: none;
      outline: 3px solid #a5b4fc;
      outline-offset: 3px;
    }
  }
  .volunteer-event-layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    align-items: start;
    gap: var(--event-card-gap);
  }
  .volunteer-event-info {
    min-width: 0;
    overflow-wrap: anywhere;
  }
  .volunteer-event-heading {
    display: flex;
    /* Line the checkbox up with the date's first line when it wraps. */
    align-items: flex-start;
    gap: 0.625rem;
  }
  .volunteer-event-select {
    display: none;
  }
  /* In selection mode the checkbox sits just before the date. */
  :global([data-bulk-selecting]) .volunteer-event-heading {
    position: relative;
    cursor: pointer;
  }
  :global([data-bulk-selecting]) .volunteer-event-select {
    display: flex;
    flex-shrink: 0;
    margin-top: calc((1.75rem - var(--volunteer-check-size)) / 2);
  }
  :global([data-bulk-selecting]) .volunteer-event-select > input {
    position: relative;
    z-index: 1;
  }
  /* The whole checkbox and date row toggles the selection. */
  :global([data-bulk-selecting]) .volunteer-event-select::after {
    content: "";
    position: absolute;
    inset: -0.375rem 0;
  }
  .volunteer-event-card:has(.volunteer-event-select > input:checked) {
    border-color: #818cf8;
  }
  .volunteer-event-info h3 {
    font-size: 1.25rem;
    line-height: 1.4;
  }
  .volunteer-event-info > p {
    margin: 0.25rem 0 0;
    line-height: 1.5;
  }
  .volunteer-event-info > .volunteer-hidden {
    margin: 0 0 0.5rem;
  }
  .volunteer-actions:empty {
    display: none;
  }
  .volunteer-actions {
    gap: var(--event-card-gap);
  }
  .volunteer-actions > :is(form, .btn),
  .volunteer-actions > form > .btn {
    width: 100%;
  }
  .volunteer-actions > form > .btn {
    white-space: nowrap;
  }
  .volunteer-event-card > :global(.event-roster) {
    margin-top: var(--event-card-gap);
  }
  .volunteer-roster-add {
    width: 100%;
    padding-top: var(--event-card-gap);
  }
  @container event-card (min-width: 32rem) {
    .volunteer-event-layout:has(> .volunteer-actions:not(:empty)) {
      grid-template-columns: minmax(0, 1fr) 12rem;
      column-gap: 1.5rem;
    }
    .volunteer-actions {
      grid-column: 2;
      grid-row: 1;
    }
  }
</style>
