---
import ArrowRightIcon from "@/components/icons/ArrowRightIcon.astro";
import { eventCalendar, type CalendarEvent } from "@/data/event-calendar";
import "@/styles/event-calendar.css";

interface Props {
  events: CalendarEvent[];
}
const calendar = eventCalendar(Astro.props.events);
const weekdays = [
  "Sunday",
  "Monday",
  "Tuesday",
  "Wednesday",
  "Thursday",
  "Friday",
  "Saturday",
];
---

<div
  class="event-calendar"
  data-event-calendar
  data-calendar-start={calendar.start}
>
  <div class="event-calendar-heading">
    <h3 id="calendar-range" data-calendar-range aria-live="polite">
      {calendar.range}
    </h3>
    <div class="event-calendar-controls" data-calendar-controls hidden>
      <button
        type="button"
        data-calendar-step="previous"
        aria-label="Previous five weeks"
        disabled={!calendar.previous}
      >
        <ArrowRightIcon class="size-5 rotate-180" />
      </button>
      <button type="button" data-calendar-step="today">Today</button>
      <button
        type="button"
        data-calendar-step="next"
        aria-label="Next five weeks"
        disabled={!calendar.next}
      >
        <ArrowRightIcon class="size-5" />
      </button>
    </div>
  </div>
  <p id="calendar-help">
    Circled dates have events. Select an event to jump to its details. Times are
    in Vancouver.
  </p>
  <table aria-labelledby="calendar-range" aria-describedby="calendar-help">
    <thead>
      <tr
        >{
          weekdays.map((day) => (
            <th scope="col">
              <abbr title={day}>{day.slice(0, 3)}</abbr>
            </th>
          ))
        }</tr
      >
    </thead>
    <tbody data-calendar-days>
      {
        calendar.weeks.map((week) => (
          <tr>
            {week.map((day) => (
              <td
                data-calendar-date={day.date}
                aria-current={day.today ? "date" : undefined}
              >
                {day.events.length ? (
                  day.events.map((event, index) => (
                    <a
                      href={`#event-${event.id}`}
                      data-calendar-event={event.id}
                      aria-label={event.description}
                      title={event.description}
                    >
                      {index === 0 && (
                        <span class="event-calendar-day event-calendar-circle">
                          {day.day}
                        </span>
                      )}
                      <span class="event-calendar-time">{event.time}</span>
                    </a>
                  ))
                ) : (
                  <span class="event-calendar-day">{day.day}</span>
                )}
              </td>
            ))}
          </tr>
        ))
      }
    </tbody>
  </table>
</div>
