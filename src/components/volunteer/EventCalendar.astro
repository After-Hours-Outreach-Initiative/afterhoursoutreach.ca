---
import ChevronDownIcon from "@/components/icons/ChevronDownIcon.astro";
import TableScrollFrame from "../TableScrollFrame.astro";
import { eventCalendar, type CalendarEvent } from "@/data/event-calendar";
import "@/styles/event-calendar.css";

interface Props {
  events: CalendarEvent[];
}
const calendar = eventCalendar(Astro.props.events);
const weekdays = [
  "Sunday",
  "Monday",
  "Tuesday",
  "Wednesday",
  "Thursday",
  "Friday",
  "Saturday",
];
---

<div
  class="event-calendar"
  data-event-calendar
  data-calendar-start={calendar.start}
>
  <div class="event-calendar-header">
    <button
      type="button"
      data-calendar-controls
      data-calendar-step="previous"
      aria-label="Previous month"
      disabled={!calendar.previous}
      hidden
    >
      <ChevronDownIcon class="size-5 rotate-90" />
    </button>
    <p
      id="calendar-range"
      class="event-calendar-range"
      data-calendar-range
      aria-live="polite"
      tabindex="-1"
    >
      {calendar.range}
    </p>
    <button
      type="button"
      data-calendar-controls
      data-calendar-step="next"
      aria-label="Next month"
      disabled={!calendar.next}
      hidden
    >
      <ChevronDownIcon class="size-5 -rotate-90" />
    </button>
  </div>
  <TableScrollFrame label="Event calendar">
    <table aria-labelledby="calendar-range" aria-describedby="calendar-help">
      <thead>
        <tr>
          {weekdays.map((day) => (
            <th scope="col" aria-label={day}>
              <abbr title={day}>{day.slice(0, 3)}</abbr>
            </th>
          ))}
        </tr>
      </thead>
      <tbody data-calendar-days>
        {calendar.weeks.map((week) => (
          <tr>
            {week.map((day) => (
              <td
                data-calendar-date={day.date}
                data-calendar-overflow={
                  !day.inMonth && day.date > calendar.start ? "" : undefined
                }
                aria-current={day.today ? "date" : undefined}
              >
                {(day.inMonth || day.date > calendar.start) &&
                  (day.events.length ? (
                    <a
                      href={`#event-${day.events[0].id}`}
                      data-calendar-event={day.events[0].id}
                      aria-label={day.events[0].description}
                      title={day.events[0].label}
                    >
                      <span class="event-calendar-day event-calendar-circle">
                        {day.day}
                      </span>
                    </a>
                  ) : (
                    <span class="event-calendar-day">{day.day}</span>
                  ))}
              </td>
            ))}
          </tr>
        ))}
      </tbody>
    </table>
  </TableScrollFrame>
  <p id="calendar-help" class="sr-only">
    Select an event date to jump to its first event.
  </p>
</div>
