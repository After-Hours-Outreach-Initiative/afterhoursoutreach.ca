---
import DiscordIcon from "@/components/icons/DiscordIcon.astro";
import MoonIcon from "@/components/icons/MoonIcon.astro";
import AccountIcon from "@/components/icons/AccountIcon.astro";
import ArrowRightIcon from "@/components/icons/ArrowRightIcon.astro";
import HeaderAccountCard from "@/components/HeaderAccountCard.astro";
import { navLinks, social } from "@/data/site";
import { accountGreeting } from "@/data/account-navigation";
import "@/styles/header.css";

interface Props {
  signedIn: boolean;
  organizer?: boolean;
  name?: string;
  greetingName?: string;
  email?: string;
}
const {
  signedIn,
  organizer = false,
  name,
  greetingName = accountGreeting(undefined, name),
  email,
} = Astro.props;
const { pathname } = Astro.url;
const current = pathname.replace(/\/$/, "");
const isCurrent = (href: string) =>
  current === href ||
  (href === "/volunteer/volunteers" && current.startsWith(`${href}/`));
const volunteerLinks = [
  { label: "Events", href: "/volunteer" },
  { label: "Volunteers", href: "/volunteer/volunteers" },
];
const accountPage = current === "/volunteer/account" || current === "/apply";
---

<header class="site-header sticky top-0 z-50 bg-black text-white">
  <div
    class="relative mx-auto flex w-full max-w-site items-center gap-6 px-6 py-3 max-lg:gap-3 max-sm:gap-2 max-sm:px-4"
  >
    <a
      class="flex min-w-0 items-center gap-3.5"
      href="/"
      aria-label="After Hours Outreach Initiative, home"
    >
      <MoonIcon
        class="size-12 shrink-0 fill-current text-blue max-sm:size-10"
      />
      <span class="flex min-w-0 flex-col leading-tight">
        <strong class="font-heading text-xl font-bold">After Hours</strong>
        <span class="text-base text-zinc-400">Outreach Initiative</span>
      </span>
    </a>

    <nav
      class="ml-auto hidden items-center gap-6 lg:flex"
      aria-label="Primary navigation"
    >
      {
        navLinks.map((link) => (
          <Fragment>
            <a
              class="header-link"
              href={link.href}
              aria-current={isCurrent(link.href) ? "page" : undefined}
              data-volunteer-link={link.href === "/volunteer" ? "" : undefined}
              hidden={link.href === "/volunteer" && organizer}
            >
              {link.label}
            </a>
            {link.href === "/volunteer" && (
              <details
                class="header-menu"
                data-header-menu
                data-volunteer-menu
                hidden={!organizer}
              >
                <summary
                  class="header-link"
                  role="button"
                  aria-expanded="false"
                >
                  Volunteer
                  <svg
                    class="header-chevron"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    aria-hidden="true"
                  >
                    <path d="m6 9 6 6 6-6" />
                  </svg>
                </summary>
                <ul class="header-dropdown header-volunteer-dropdown">
                  {volunteerLinks.map((child) => (
                    <li>
                      <a
                        href={child.href}
                        aria-current={
                          isCurrent(child.href) ? "page" : undefined
                        }
                      >
                        {child.label}
                      </a>
                    </li>
                  ))}
                </ul>
              </details>
            )}
          </Fragment>
        ))
      }
    </nav>

    <a
      class="btn btn-primary max-lg:hidden"
      data-header-discord
      hidden={signedIn}
      href={social.discord}
      target="_blank"
      rel="noreferrer"
    >
      <DiscordIcon class="btn-icon fill-current" />
      Join Discord
    </a>

    <nav
      class="hidden shrink-0 lg:block"
      aria-label="Volunteer account"
      data-header-account
      hidden={!signedIn}
    >
      <details
        class="header-menu"
        data-header-menu
        data-account-menu={signedIn ? "" : undefined}
      >
        <summary
          class="header-account-toggle"
          role="button"
          aria-label={greetingName === "Account"
            ? "Account"
            : `Account for ${greetingName}`}
          aria-expanded="false"
          data-current={accountPage ? "true" : undefined}
        >
          <span class="header-account-icon"
            ><AccountIcon class="size-5 shrink-0" /></span
          >
          <span class="header-account-label" data-account-greeting
            >{greetingName}</span
          >
          <svg
            class="header-chevron"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            aria-hidden="true"
          >
            <path d="m6 9 6 6 6-6"></path>
          </svg>
        </summary>
        <HeaderAccountCard
          class="header-dropdown header-account-dropdown"
          {signedIn}
          {name}
          {email}
          {accountPage}
        />
      </details>
    </nav>

    <details
      class="mobile-nav group ml-auto shrink-0 lg:hidden"
      data-header-menu
    >
      <summary
        class="flex size-12 cursor-pointer list-none flex-col items-center justify-center gap-2 rounded-lg"
        aria-label="Open navigation"
        role="button"
        aria-expanded="false"
      >
        <span
          class="h-0.5 w-7 bg-white transition-transform group-open:translate-y-2.5 group-open:rotate-45"
        ></span>
        <span class="h-0.5 w-7 bg-white transition-opacity group-open:opacity-0"
        ></span>
        <span
          class="h-0.5 w-7 bg-white transition-transform group-open:-translate-y-2.5 group-open:-rotate-45"
        ></span>
      </summary>
      <nav
        class="header-mobile-panel absolute inset-x-0 top-full w-full bg-black px-6 max-sm:px-4"
        aria-label="Mobile navigation"
      >
        <ul class="header-mobile-links" aria-label="Site pages">
          {
            navLinks.map((link) => (
              <li>
                <a
                  class="header-mobile-link"
                  href={link.href}
                  aria-current={isCurrent(link.href) ? "page" : undefined}
                >
                  {link.label}
                  <ArrowRightIcon class="header-mobile-arrow" />
                </a>
                {link.href === "/volunteer" && (
                  <ul
                    class="header-mobile-children"
                    aria-label="Volunteer pages"
                    data-volunteer-children
                    hidden={!organizer}
                  >
                    {volunteerLinks.map((child) => (
                      <li>
                        <a
                          class="header-mobile-link"
                          href={child.href}
                          aria-current={
                            isCurrent(child.href) ? "page" : undefined
                          }
                        >
                          {child.label}
                          <ArrowRightIcon class="header-mobile-arrow" />
                        </a>
                      </li>
                    ))}
                  </ul>
                )}
              </li>
            ))
          }
        </ul>
        <section
          class="header-mobile-account"
          aria-label="Your account"
          data-mobile-account
          hidden={!signedIn}
        >
          <HeaderAccountCard
            {signedIn}
            {name}
            {email}
            {accountPage}
            showIcon
            showArrows
          />
        </section>
        <a
          class="btn btn-primary"
          data-header-discord
          hidden={signedIn}
          href={social.discord}
          target="_blank"
          rel="noreferrer"
        >
          <DiscordIcon class="btn-icon fill-current" />
          Join Discord
          <ArrowRightIcon class="header-mobile-arrow" />
        </a>
      </nav>
    </details>
  </div>
</header>
<div class="header-mobile-backdrop" aria-hidden="true"></div>

<script>
  import "@/scripts/header";
</script>
