---
import AccountIcon from "@/components/icons/AccountIcon.astro";
import CalendarIcon from "@/components/icons/CalendarIcon.astro";
import ClipboardIcon from "@/components/icons/ClipboardIcon.astro";
import UsersIcon from "@/components/icons/UsersIcon.astro";
import HeaderApplicationBadge from "@/components/HeaderApplicationBadge.astro";
import { siteNavigation } from "@/data/site";

interface Props {
  organizer?: boolean;
  eventAccess?: boolean;
  readyApplicationCount?: number;
}
const {
  organizer = false,
  eventAccess = false,
  readyApplicationCount = 0,
} = Astro.props;

const current = Astro.url.pathname.replace(/\/$/, "");
const under = (href: string) =>
  current === href || current.startsWith(`${href}/`);
// Events, or Volunteer until event access, as in the site navigation.
const portal = siteNavigation(true, organizer, eventAccess)[0];
const items = [
  {
    ...portal,
    icon: CalendarIcon,
    current: current === portal.href || current === "/apply",
  },
  ...(organizer
    ? [
        {
          label: "Applications",
          href: "/applications",
          icon: ClipboardIcon,
          current: under("/applications"),
        },
        {
          label: "Volunteers",
          href: "/volunteers",
          icon: UsersIcon,
          current: under("/volunteers"),
        },
      ]
    : []),
  {
    label: "Account",
    href: "/volunteer/account",
    icon: AccountIcon,
    // The audit log is reached from the account menu.
    current: current === "/volunteer/account" || current === "/audit-log",
  },
];
---

<nav class="app-dock" aria-label="Quick navigation">
  {items.map(({ icon: Icon, ...item }) => (
    <a
      class="app-dock-item"
      href={item.href}
      aria-current={item.current ? "page" : undefined}
      data-header-applications={item.href === "/applications" ? "" : undefined}
      data-volunteer-nav={
        item.href === "/volunteer" || item.href === "/events" ? "" : undefined
      }
    >
      <span class="app-dock-icon">
        <Icon class="app-dock-glyph" />
      </span>
      <span class="app-dock-label" data-volunteer-nav-label>
        {item.label}
        {item.href === "/applications" && (
          <HeaderApplicationBadge count={readyApplicationCount} />
        )}
      </span>
    </a>
  ))}
</nav>

<script>
  // Dims the dock from the start of a page load until the next page replaces
  // this one. Same-page updates, downloads and cancelled loads leave it alone.
  const dock = document.querySelector<HTMLElement>(".app-dock");
  if (dock && "navigation" in window) {
    const busy = (on: boolean) =>
      on
        ? dock.setAttribute("aria-busy", "true")
        : dock.removeAttribute("aria-busy");
    navigation.addEventListener("navigate", (event) => {
      if (
        !event.hashChange &&
        event.downloadRequest === null &&
        !event.destination.sameDocument
      )
        busy(true);
    });
    navigation.addEventListener("navigateerror", () => busy(false));
    // Back and forward can restore this page with the dock still dimmed.
    addEventListener("pageshow", () => busy(false));
  }
</script>

<style>
  /* A full-width tab bar for signed-in people on small screens. */
  .app-dock {
    display: none;
  }
  @media (width < 64rem) {
    .app-dock {
      position: fixed;
      inset-inline: 0;
      bottom: 0;
      z-index: 40;
      display: flex;
      gap: 0.25rem;
      padding: 0.375rem max(0.5rem, env(safe-area-inset-right))
        max(0.375rem, env(safe-area-inset-bottom))
        max(0.5rem, env(safe-area-inset-left));
      border-top: 1px solid #ffffff1a;
      background: black;
    }
  }
  .app-dock-item {
    position: relative;
    display: flex;
    flex: 1 1 0;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.0625rem;
    min-width: 0;
    min-height: 3rem;
    padding: 0.25rem;
    border-radius: 0.75rem;
    color: #a1a1aa;
    text-decoration: none;
    -webkit-tap-highlight-color: transparent;
    transition:
      color 150ms ease,
      background-color 150ms ease;
  }
  .app-dock-item:hover {
    color: #f4f4f5;
  }
  .app-dock-item[aria-current="page"] {
    background: #ffffff14;
    color: white;
  }
  .app-dock-item:focus-visible {
    outline: 2px solid #a5b4fc;
    outline-offset: -2px;
  }
  .app-dock-icon {
    position: relative;
    display: flex;
  }
  .app-dock-item :global(.app-dock-glyph) {
    width: 1.25rem;
    height: 1.25rem;
  }
  .app-dock-item[aria-current="page"] :global(.app-dock-glyph) {
    color: #a5b4fc;
  }
  .app-dock-label {
    max-width: 100%;
    overflow: hidden;
    font-size: 0.6875rem;
    font-weight: 600;
    line-height: 1.2;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  /* The review count sits on the icon's corner, as an app badge. */
  .app-dock-item :global(.header-application-badge) {
    position: absolute;
    top: 0;
    left: calc(50% + 0.25rem);
    /* A ring outside the badge keeps the header badge's own shape. */
    box-shadow: 0 0 0 2px black;
    font-size: 0.8125rem;
  }
  /* Taps do nothing while another page loads, so the dock says so. The
     delay keeps quick page changes from flickering. */
  .app-dock[aria-busy="true"] .app-dock-item {
    opacity: 0.4;
    pointer-events: none;
    transition: opacity 150ms ease 100ms;
  }
  @media (prefers-reduced-motion: reduce) {
    .app-dock-item,
    .app-dock[aria-busy="true"] .app-dock-item {
      transition: none;
    }
  }
  @media print {
    .app-dock {
      display: none;
    }
  }

  /* Keep the page's end, and other floating controls, clear of the dock. */
  @media (width < 64rem) {
    :global(body[data-app-dock]) {
      padding-bottom: calc(4.5rem + env(safe-area-inset-bottom));
    }
    :global(body[data-app-dock] .back-to-top) {
      bottom: calc(4.5rem + env(safe-area-inset-bottom));
    }
    :global(body[data-app-dock] [data-open-account-switcher]) {
      bottom: calc(4.5rem + env(safe-area-inset-bottom));
    }
  }
</style>
