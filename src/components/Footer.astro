---
import { donateHref, navLinks, social } from "@/data/site";
import { organization } from "@/data/organization";
---

<footer class="bg-black text-white" id="contact">
  <div
    class="mx-auto grid w-full max-w-[1248px] items-center gap-x-16 gap-y-10 px-6 py-20 max-sm:grid-cols-1 max-sm:px-4 md:grid-cols-[minmax(0,1fr)_auto] lg:grid-cols-[minmax(0,1fr)_auto_auto_auto]"
  >
    <div>
      <a
        class="flex shrink-0 items-center gap-8 max-sm:flex-col max-sm:items-start max-sm:gap-5"
        href="/"
        aria-label="After Hours Outreach Initiative, home"
      >
        <img
          class="size-40 shrink-0 object-contain"
          src="/logo-blue.jpg"
          alt=""
          width="1280"
          height="1280"
          loading="lazy"
          decoding="async"
        />
        <span class="flex flex-col leading-tight">
          <strong class="font-heading text-[30px] leading-none font-bold"
            >After Hours</strong
          >
          <span class="mt-1.5 text-xl leading-tight text-zinc-400"
            >Outreach Initiative</span
          >
        </span>
      </a>
    </div>

    <address
      class="text-[15px] leading-7 text-zinc-300 not-italic max-lg:col-span-full"
    >
      <p class="m-0 text-sm font-bold tracking-[0.12em] text-blue uppercase">
        Find us
      </p>
      <a
        class="mt-3 inline-block border-b border-zinc-600 pb-0.5 hover:border-white hover:text-white"
        href={organization.address.mapUrl}
        target="_blank"
        rel="noreferrer"
      >
        {organization.address.street}<br />
        {organization.address.city}, {organization.address.region}
      </a>
    </address>

    <nav
      class="flex flex-col items-start gap-3 text-[15px] text-zinc-300 md:justify-self-end"
      aria-label="Footer navigation"
    >
      {
        navLinks.map((link) => (
          <a class="hover:text-white" href={link.href}>
            {link.label}
          </a>
        ))
      }
      <a class="hover:text-white" href={donateHref}>Donate</a>
    </nav>

    <nav
      class="flex flex-col items-start gap-3 text-[15px] text-zinc-300 max-lg:col-span-full max-lg:flex-row lg:justify-self-end"
      aria-label="Social media"
    >
      <a
        class="inline-flex items-center gap-2.5 border-b border-zinc-600 pb-0.5 hover:border-white hover:text-white"
        href={social.instagram}
        target="_blank"
        rel="noreferrer"
      >
        <svg
          class="size-5 shrink-0 text-blue"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          aria-hidden="true"
        >
          <rect x="3" y="3" width="18" height="18" rx="5"></rect>
          <circle cx="12" cy="12" r="4"></circle>
          <circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none"
          ></circle>
        </svg>
        Instagram</a
      >
      <a
        class="inline-flex items-center gap-2.5 border-b border-zinc-600 pb-0.5 hover:border-white hover:text-white"
        href={social.discord}
        target="_blank"
        rel="noreferrer"
      >
        <svg
          class="size-5 shrink-0 fill-current text-blue"
          viewBox="0 0 24 24"
          aria-hidden="true"
        >
          <path
            d="M19.5 5.3A16.4 16.4 0 0 0 15.4 4l-.5 1a15.2 15.2 0 0 0-5.8 0l-.5-1a16.4 16.4 0 0 0-4.1 1.3C1.9 9.2 1.2 12.9 1.5 16.6a16.7 16.7 0 0 0 5 2.5l1.2-1.6a11 11 0 0 1-1.9-.9l.5-.4a13.3 13.3 0 0 0 11.4 0l.5.4c-.6.4-1.3.7-1.9.9l1.2 1.6a16.7 16.7 0 0 0 5-2.5c.4-4.3-.7-8-3-11.3ZM8.7 14.4c-1.1 0-2-1-2-2.3s.9-2.3 2-2.3 2 1 2 2.3-.9 2.3-2 2.3Zm6.6 0c-1.1 0-2-1-2-2.3s.9-2.3 2-2.3 2 1 2 2.3-.9 2.3-2 2.3Z"
          ></path>
        </svg>
        Discord</a
      >
    </nav>
  </div>

  <div
    class="mx-auto flex min-h-20 w-full max-w-[1248px] flex-wrap items-center gap-x-8 gap-y-2 border-t border-zinc-800 px-6 py-5 text-sm text-zinc-400 max-sm:px-4"
  >
    <p class="m-0">
      &copy; {new Date().getFullYear()}
      {organization.legalName}
    </p>
    <p class="m-0">
      Incorporation No. <span class="text-zinc-300"
        >{organization.incorporationNumber}</span
      >
    </p>
    <p class="m-0">
      Business No. <span class="text-zinc-300"
        >{organization.businessNumber}</span
      >
    </p>
  </div>
</footer>
