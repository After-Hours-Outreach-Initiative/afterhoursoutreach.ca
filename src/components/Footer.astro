---
import DiscordIcon from "@/components/icons/DiscordIcon.astro";
import { contactEmail, navLinks, social } from "@/data/site";
import { organization } from "@/data/organization";
---

<footer class="bg-black text-white" id="contact">
  <div
    class="mx-auto grid w-full max-w-[1248px] grid-cols-1 items-start gap-x-24 gap-y-12 px-6 py-14 max-sm:px-4 sm:grid-cols-2 lg:grid-cols-[minmax(0,1fr)_auto_auto]"
  >
    <div>
      <a
        class="flex shrink-0 items-center gap-4"
        href="/"
        aria-label="After Hours Outreach Society, home"
      >
        <!-- logo-blue.jpg has blank space along its left edge, so the mark
        needs a nudge to line up with the links below it -->
        <img
          class="-ml-1 size-28 shrink-0 object-contain"
          src="/logo-blue.jpg"
          alt=""
          width="1280"
          height="1280"
          loading="lazy"
          decoding="async"
        />
        <span class="flex flex-col leading-tight whitespace-nowrap">
          <strong class="font-heading text-xl leading-none font-bold"
            >After Hours</strong
          >
          <span class="mt-1 text-[15px] leading-tight text-zinc-400"
            >Outreach Society</span
          >
        </span>
      </a>

      <nav
        class="mt-8 flex flex-col items-start gap-3 text-[15px] text-zinc-300"
        aria-label="Contact and social media"
      >
        <a
          class="inline-flex items-center gap-2.5 hover:text-white"
          href={social.instagram}
          target="_blank"
          rel="noreferrer"
        >
          <svg
            class="size-5 shrink-0 text-blue"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            aria-hidden="true"
          >
            <rect x="3" y="3" width="18" height="18" rx="5"></rect>
            <circle cx="12" cy="12" r="4"></circle>
            <circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none"
            ></circle>
          </svg>
          Instagram</a
        >
        <a
          class="inline-flex items-center gap-2.5 hover:text-white"
          href={social.discord}
          target="_blank"
          rel="noreferrer"
        >
          <DiscordIcon class="size-5 shrink-0 fill-current text-blue" />
          Discord</a
        >
        <a
          class="inline-flex items-center gap-2.5 hover:text-white"
          href={`mailto:${contactEmail}`}
        >
          {/* lucide: mail */}
          <svg
            class="lucide size-5 shrink-0 text-blue"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            aria-hidden="true"
          >
            <path d="m22 7-8.991 5.727a2 2 0 0 1-2.009 0L2 7"></path>
            <rect x="2" y="4" width="20" height="16" rx="2"></rect>
          </svg>
          {contactEmail}</a
        >
      </nav>
    </div>

    <div>
      <h2 class="m-0 font-heading text-[15px] font-bold text-white">Site</h2>

      <nav
        class="mt-4 flex flex-col items-start gap-3 text-[15px] text-zinc-300"
        aria-label="Footer navigation"
      >
        {
          navLinks.map((link) => (
            <a class="hover:text-white" href={link.href}>
              {link.label}
            </a>
          ))
        }
      </nav>
    </div>

    <div>
      <h2 class="m-0 font-heading text-[15px] font-bold text-white">
        Non-profit information
      </h2>

      <table class="mt-4 text-[15px] leading-7">
        <tbody>
          <tr>
            <th class="pr-6 text-left font-normal text-zinc-400" scope="row"
              >Incorporation No.</th
            >
            <td class="text-zinc-300">{organization.incorporationNumber}</td>
          </tr>
          <tr>
            <th class="pr-6 text-left font-normal text-zinc-400" scope="row"
              >Business No.</th
            >
            <td class="text-zinc-300">{organization.businessNumber}</td>
          </tr>
          <tr>
            <th
              class="pr-6 text-left align-top font-normal text-zinc-400"
              scope="row">Address</th
            >
            <td class="text-zinc-300">
              <address class="not-italic">
                <a
                  class="border-b border-zinc-600 pb-0.5 hover:border-white hover:text-white"
                  href={organization.address.mapUrl}
                  target="_blank"
                  rel="noreferrer"
                >
                  {organization.address.street}<br />
                  {organization.address.city}, {organization.address.region}
                </a>
              </address>
            </td>
          </tr>
        </tbody>
      </table>
    </div>
  </div>

  <div class="mx-auto w-full max-w-[1248px] px-6 max-sm:px-4">
    <div
      class="flex justify-center border-t border-zinc-800 py-6 text-sm text-zinc-400"
    >
      <p class="m-0">
        &copy; {`${new Date().getFullYear()} ${organization.legalName}`}
      </p>
    </div>
  </div>
</footer>
