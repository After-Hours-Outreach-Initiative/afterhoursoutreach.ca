---
import Instagram from "@/components/icons/InstagramIcon.astro";
import { Mail, Phone } from "@lucide/astro";
import DiscordIcon from "@/components/icons/DiscordIcon.astro";
import FacebookIcon from "@/components/icons/FacebookIcon.astro";
import LinkedInIcon from "@/components/icons/LinkedInIcon.astro";
import MapPinIcon from "@/components/icons/MapPinIcon.astro";
import {
  contactEmail,
  contactPhone,
  siteNavigation,
  social,
} from "@/data/site";
import { organization } from "@/data/organization";
interface Props {
  signedIn: boolean;
  organizer?: boolean;
  eventAccess?: boolean;
}
const { signedIn, organizer = false, eventAccess = false } = Astro.props;
const links = siteNavigation(signedIn, organizer, eventAccess);
---

<footer class="bg-black text-white" id="contact">
  <div
    class="mx-auto grid w-full max-w-site grid-cols-1 items-start gap-x-24 gap-y-12 px-6 py-14 max-sm:px-4 sm:grid-cols-2 lg:grid-cols-[minmax(0,1fr)_auto_auto]"
  >
    <div class="min-w-0">
      <a
        class="flex w-fit max-w-full flex-wrap items-center gap-4"
        href="/"
        aria-label="After Hours Outreach Initiative, home"
      >
        <!-- logo-blue.jpg has blank space along its left edge, so the mark
        needs a nudge to line up with the links below it -->
        <img
          class="-ml-1 size-28 shrink-0 object-contain"
          src="/logo-blue.jpg"
          alt=""
          width="1280"
          height="1280"
          loading="lazy"
          decoding="async"
        />
        <span
          class="flex min-w-0 max-w-full flex-col leading-tight wrap-anywhere"
        >
          <strong class="font-heading text-xl leading-none font-bold"
            >After Hours</strong
          >
          <span class="mt-1 text-base leading-tight text-zinc-400"
            >Outreach Initiative</span
          >
        </span>
      </a>

      <nav
        class="mt-8 flex flex-col items-start gap-3 text-base text-zinc-300"
        aria-label="Contact"
      >
        <a
          class="inline-flex min-w-0 max-w-full items-center gap-2.5 hover:text-white"
          href={`mailto:${contactEmail}`}
        >
          {/* lucide: mail */}
          <Mail
            size="1em"
            aria-hidden="true"
            class="lucide size-[1.25em] shrink-0 text-blue"
          />
          <span class="min-w-0 wrap-anywhere">{contactEmail}</span></a
        >
        <a
          class="inline-flex items-center gap-2.5 hover:text-white"
          href={`tel:+1${contactPhone.replace(/\D/g, "")}`}
        >
          {/* lucide: phone */}
          <Phone
            size="1em"
            aria-hidden="true"
            class="lucide size-[1.25em] shrink-0 text-blue"
          />
          {contactPhone}</a
        >
        <a
          class="inline-flex items-center gap-2.5 hover:text-white"
          href="https://www.google.com/maps/search/?api=1&query=312+Main+St+Vancouver"
          target="_blank"
          rel="noreferrer"
        >
          <MapPinIcon class="size-[1.25em] shrink-0 text-blue" />
          312 Main St</a
        >
      </nav>
    </div>

    <div>
      <h2 class="m-0 text-base text-white">Site</h2>

      <nav
        class="mt-4 flex flex-col items-start gap-3 text-base text-zinc-300"
        aria-label="Footer navigation"
      >
        {
          links.map((link) => (
            <a
              class="hover:text-white"
              href={link.href}
              data-volunteer-nav={
                link.href === "/volunteer" || link.href === "/events"
                  ? ""
                  : undefined
              }
            >
              <span data-volunteer-nav-label>{link.label}</span>
            </a>
          ))
        }
      </nav>
    </div>

    <div>
      <h2 class="m-0 text-base text-white">Socials</h2>

      <nav
        class="mt-4 flex flex-col items-start gap-3 text-base text-zinc-300"
        aria-label="Social media"
      >
        <a
          class="inline-flex items-center gap-2.5 hover:text-white"
          href={social.instagram}
          target="_blank"
          rel="noreferrer"
        >
          <Instagram
            aria-hidden="true"
            class="size-[1.25em] shrink-0 text-blue"
          />
          Instagram</a
        >
        <a
          class="inline-flex items-center gap-2.5 hover:text-white"
          href={social.discord}
          target="_blank"
          rel="noreferrer"
        >
          <DiscordIcon class="size-[1.25em] shrink-0 fill-current text-blue" />
          Discord</a
        >
        <a
          class="inline-flex items-center gap-2.5 hover:text-white"
          href={social.linkedin}
          target="_blank"
          rel="noreferrer"
        >
          <LinkedInIcon class="size-[1.25em] shrink-0 fill-current text-blue" />
          LinkedIn</a
        >
        <a
          class="inline-flex items-center gap-2.5 hover:text-white"
          href={social.facebook}
          target="_blank"
          rel="noreferrer"
        >
          <FacebookIcon class="size-[1.25em] shrink-0 fill-current text-blue" />
          Facebook</a
        >
      </nav>
    </div>
  </div>

  <div class="mx-auto w-full max-w-site px-6 max-sm:px-4">
    <div
      class="flex flex-wrap items-center justify-center gap-x-4 gap-y-2 py-6 text-center text-base text-zinc-400"
    >
      <p class="m-0 text-base">
        &copy; {`${new Date().getFullYear()} ${organization.legalName}`}
      </p>
      <a class="underline underline-offset-4 hover:text-white" href="/privacy"
        >Privacy policy</a
      >
    </div>
  </div>
</footer>
