---
interface Props {
  signedIn: boolean;
  name?: string;
  email?: string;
  accountPage: boolean;
  class?: string;
}

const { signedIn, name, email, accountPage, class: className } = Astro.props;
---

<div class:list={["header-account-card", className]}>
  <div class="header-account-identity">
    <strong
      class="header-account-name"
      data-account-menu-name={signedIn ? "" : undefined}
      >{name?.trim() || "Your account"}</strong
    >
    <p
      class="header-account-email"
      data-account-email={signedIn ? "" : undefined}
    >
      {email}
    </p>
  </div>
  <a href="/volunteer/account" aria-current={accountPage ? "page" : undefined}
    >Account</a
  >
  <form data-sign-out action="/api/v1/auth/sign-out" method="post">
    <button type="submit">Sign out</button>
    <p class="header-account-message" data-form-message role="status" hidden>
    </p>
  </form>
</div>
