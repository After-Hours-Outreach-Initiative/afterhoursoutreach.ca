---
interface Props {
  class?: string;
}
const { class: className } = Astro.props;
---

<svg
  class={className}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
>
  <path
    d="M2.25 15a4.5 4.5 0 0 0 4.5 4.5H18a4.5 4.5 0 0 0 .88-8.914 6 6 0 0 0-11.773-2.413 3 3 0 0 0-3.758 3.848A4.5 4.5 0 0 0 2.25 15Z"
  ></path>
  <g class="cloud-save-mark cloud-save-pending" stroke-width="1.5">
    <circle cx="12" cy="14" r="3"></circle>
    <path d="M12 12.5V14l1.5 1"></path>
  </g>
  <path class="cloud-save-mark cloud-save-loading" d="M12 11a3 3 0 1 1-3 3"
  ></path>
  <path class="cloud-save-mark cloud-save-saved" d="m9 14 2 2 4-4"></path>
  <path class="cloud-save-mark cloud-save-error" d="M12 11v3m0 3h.01"></path>
  <path class="cloud-save-mark cloud-save-paused" d="M10 11v6m4-6v6"></path>
</svg>
