---
interface Props {
  /** Used by the control's aria-describedby attribute. */
  field: string;
  message?: string;
  /** Optional spacing for the feedback slot. */
  class?: string;
}

const {
  field,
  message = "This field is required.",
  class: className,
} = Astro.props;
---

<p
  class:list={["m-0 flex items-center gap-2 text-base text-red-400", className]}
  id={`error-${field}`}
  data-error={field}
>
  {/* lucide: circle-alert */}
  <svg
    class="lucide size-[1.25em] shrink-0"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    aria-hidden="true"
  >
    <circle cx="12" cy="12" r="10"></circle>
    <path d="M12 8v4"></path>
    <path d="M12 16h.01"></path>
  </svg>
  <span>{message}</span>
</p>
