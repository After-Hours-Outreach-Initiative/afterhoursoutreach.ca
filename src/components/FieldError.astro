---
interface Props {
  /** Used by the control's aria-describedby attribute. */
  field: string;
  message?: string;
  /** Optional spacing for displayed feedback. */
  class?: string;
}

const {
  field,
  message = "This field is required.",
  class: className,
} = Astro.props;
---

<p
  class:list={["m-0 flex items-center gap-2 text-base text-red-400", className]}
  id={`error-${field}`}
  data-error={field}
>
  {/* lucide: circle-alert */}
  <svg
    class="lucide size-[1.25em] shrink-0"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    aria-hidden="true"
  >
    <circle cx="12" cy="12" r="10"></circle>
    <path d="M12 8v4"></path>
    <path d="M12 16h.01"></path>
  </svg>
  <span>{message}</span>
</p>

<script>
  // Expanding blur feedback can move a submit button between mouse-down and
  // mouse-up. Let its native click validation reveal the error instead. Delegate
  // so refreshed forms receive the same protection without reinitialization.
  document.addEventListener("mousedown", (event) => {
    if (
      event.defaultPrevented ||
      event.button !== 0 ||
      !(event.target instanceof Element)
    )
      return;
    const button = event.target.closest<HTMLButtonElement>("button");
    const control = document.activeElement;
    if (
      button?.type !== "submit" ||
      button.disabled ||
      button.formNoValidate ||
      !button.form ||
      button.form.noValidate ||
      !button.closest(".volunteer-portal") ||
      !(
        control instanceof HTMLInputElement ||
        control instanceof HTMLTextAreaElement ||
        control instanceof HTMLSelectElement
      ) ||
      control.form !== button.form ||
      !control.matches(":invalid:not(:user-invalid)")
    )
      return;
    const descriptions = control.getAttribute("aria-describedby")?.split(/\s+/);
    if (
      descriptions?.some((id) =>
        document.getElementById(id)?.hasAttribute("data-error"),
      )
    )
      event.preventDefault();
  });
</script>
