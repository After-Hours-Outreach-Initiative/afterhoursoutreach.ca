---
interface Props {
  count: number;
}
const { count } = Astro.props;
---

{count > 0 && (
  <span class="header-application-badge text-sm" data-header-application-count>
    {count}
    <span class="sr-only"> ready for review</span>
  </span>
)}

<style>
  .header-application-badge {
    display: inline-flex;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    min-width: 1.625rem;
    min-height: 1.625rem;
    border-radius: 999rem;
    padding: 0.0625rem 0.375rem;
    background: #052e16;
    color: #4ade80;
    font-weight: 500;
    line-height: 1.25rem;
    text-align: center;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }
</style>
