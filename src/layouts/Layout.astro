---
import Footer from "@/components/Footer.astro";
import Header from "@/components/Header.astro";
import type { ComponentProps } from "astro/types";
import { Font } from "astro:assets";
import "@/styles/tailwind.css";

// Preview mode changes only the banner, never account or event availability.
const showPreviewBanner = import.meta.env.MODE === "preview";

interface Props {
  title: string;
  description: string;
  /** Keeps private volunteer pages and test data out of search results. */
  noindex?: boolean;
  /** No third-party resource preconnects on pages containing account information. */
  privatePage?: boolean;
  account: ComponentProps<typeof Header>;
}

const {
  title,
  description,
  noindex = false,
  privatePage = false,
  account,
} = Astro.props;
---

<!doctype html>
<html lang="en" class="scroll-smooth bg-ink">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <meta name="theme-color" content="#050608" />
    <Font cssVariable="--font-public-sans" preload />
    {!privatePage && <link rel="preconnect" href="https://cdn.shopify.com" />}
    <title>{title}</title>
  </head>
  <body
    class="m-0 overflow-x-hidden bg-ink font-body text-base leading-relaxed text-zinc-100 antialiased"
  >
    <a
      data-skip-to-main
      class="fixed top-4 left-4 z-[100] -translate-y-40 rounded-lg bg-blue px-5 py-3 text-base font-bold text-white transition-transform focus:translate-y-0"
      href="#main-content">Skip to main content</a
    >

    {
      showPreviewBanner && (
        <aside
          class="border-b border-amber-800 bg-amber-950 px-4 py-3 text-center text-sm text-amber-100"
          aria-label="Preview environment"
        >
          Preview testing site.{" "}
          <a
            class="underline underline-offset-4 hover:text-white"
            href="https://afterhoursoutreach.ca"
          >
            Visit the regular site
          </a>
          .
        </aside>
      )
    }
    <Header {...account} />

    <main id="main-content" tabindex="-1">
      <slot />
    </main>

    <Footer signedIn={account.signedIn} organizer={account.organizer} />
  </body>
</html>

<script>
  document
    .querySelector<HTMLAnchorElement>("[data-skip-to-main]")
    ?.addEventListener("click", (event) => {
      if (
        event.defaultPrevented ||
        event.button !== 0 ||
        event.metaKey ||
        event.ctrlKey ||
        event.shiftKey ||
        event.altKey
      )
        return;

      const main = document.getElementById("main-content");
      if (!main) return;

      // Skip navigation, not the viewport. Keep the fragment as a fallback
      // without JavaScript or if focus cannot move to the main landmark.
      main.focus({ preventScroll: true });
      if (document.activeElement === main) event.preventDefault();
    });
</script>
