---
import Footer from "@/components/Footer.astro";
import Header from "@/components/Header.astro";
import "@/styles/tailwind.css";

// Preview mode changes only the banner, never account or event availability.
const showPreviewBanner = import.meta.env.MODE === "preview";

interface Props {
  title: string;
  description: string;
  /** Keeps private volunteer pages and test data out of search results. */
  noindex?: boolean;
  /** No third-party font requests on pages containing account information. */
  privatePage?: boolean;
}

const {
  title,
  description,
  noindex = false,
  privatePage = false,
} = Astro.props;
---

<!doctype html>
<html lang="en" class="scroll-smooth bg-ink">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <meta name="theme-color" content="#050608" />
    {
      !privatePage && (
        <>
          <link rel="preconnect" href="https://fonts.googleapis.com" />
          <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
          <link rel="preconnect" href="https://cdn.shopify.com" />
          <link
            href="https://fonts.googleapis.com/css2?family=Public+Sans:wght@400;500;600;700&display=swap"
            rel="stylesheet"
          />
        </>
      )
    }
    <title>{title}</title>
  </head>
  <body
    class="m-0 overflow-x-hidden bg-ink font-body text-base leading-relaxed text-zinc-100 antialiased"
  >
    <a
      class="fixed top-4 left-4 z-[100] -translate-y-40 rounded-lg bg-blue px-5 py-3 text-base font-bold text-white transition-transform focus:translate-y-0"
      href="#main-content">Skip to main content</a
    >

    {
      showPreviewBanner && (
        <aside
          class="border-b border-amber-800 bg-amber-950 px-4 py-3 text-center text-sm text-amber-100"
          aria-label="Preview environment"
        >
          Preview · public test site. Use sample information only.{" "}
          <a
            class="underline underline-offset-4 hover:text-white"
            href="https://afterhoursoutreach.ca"
          >
            Visit the regular site
          </a>
        </aside>
      )
    }
    <Header />

    <main id="main-content">
      <slot />
    </main>

    <Footer />
  </body>
</html>
