---
import LocalLayout from "./LocalLayout.astro";
import VolunteerProfileView from "../../components/volunteer/VolunteerProfileView.astro";
import {
  createProfileFixture,
  getProfileScenario,
  readProfileOptions,
  readProfileState,
} from "./organizer-profile-fixtures";
import "../../styles/account.css";
import "../../styles/volunteer.css";
import "./organizer-profile.css";

if (!import.meta.env.DEV) return new Response(null, { status: 404 });
const options = readProfileOptions(Astro.url.searchParams);
const scenario = getProfileScenario(options.scenario);
const fixture = createProfileFixture(
  options,
  readProfileState(Astro.url.searchParams),
);
---

<LocalLayout title={`${scenario.label} · Organizer profile`}>
  <main
    class="volunteer-portal ui-profile-preview"
    data-ui-organizer-preview
    data-ui-phase={options.phase}
    data-ui-scenario={options.scenario}
  >
    <div class="volunteer-wrap">
      <section
        class="volunteer-panel ui-profile-page-panel"
        data-profile-preview-content
      >
        {options.phase === "ready" && <VolunteerProfileView {...fixture} />}
      </section>
    </div>
  </main>
</LocalLayout>

<script src="./organizer-profile-simulator.ts"></script>
