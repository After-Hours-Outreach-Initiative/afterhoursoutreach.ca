---
import LocalLayout from "./LocalLayout.astro";
import PlaygroundHeader from "./PlaygroundHeader.astro";
import {
  eventCardPreviewPath,
  eventCardScenarios,
} from "./event-card-fixtures";
import "./playground.css";

if (!import.meta.env.DEV) return new Response(null, { status: 404 });
---

<LocalLayout title="Event card">
  <main class="ui-playground" data-ui-event-playground>
    <PlaygroundHeader active="event-card" />
    <section class="ui-section" aria-labelledby="event-card-heading">
      <h2 id="event-card-heading">Event card</h2>
      <p>
        The real volunteer-facing card with fictional rosters. Registration
        changes stay in these previews and never update an account.
      </p>
      <div class="ui-controls">
        <label class="ui-field">
          Preview width
          <select data-ui-event-width>
            <option value="fit">Fit available space</option>
            <option value="320">Small mobile · 320 px</option>
            <option value="375">Mobile · 375 px</option>
            <option value="768">Wide card · 768 px</option>
          </select>
        </label>
        <div class="ui-toggles">
          <label
            ><input type="checkbox" data-ui-event-rosters /> Expand all rosters</label
          >
        </div>
        <button type="button" class="btn btn-quiet" data-ui-event-reset
          >Reset previews</button
        >
      </div>
      <div class="ui-gallery">
        {
          eventCardScenarios.map((scenario) => (
            <section
              class="ui-gallery-card"
              aria-labelledby={`heading-${scenario.id}`}
            >
              <div class="ui-gallery-description">
                <h3 id={`heading-${scenario.id}`}>{scenario.label}</h3>
                <p>{scenario.description}</p>
                <a
                  href={`${eventCardPreviewPath}?scenario=${scenario.id}`}
                  target="_blank"
                  rel="noopener"
                >
                  Open isolated preview
                </a>
              </div>
              <div
                class="ui-preview-scroll"
                tabindex="0"
                aria-label={`${scenario.label} preview; scroll horizontally for wider sizes`}
              >
                <iframe
                  class="ui-live-preview"
                  data-ui-event-frame={scenario.id}
                  src={`${eventCardPreviewPath}?scenario=${scenario.id}`}
                  title={`${scenario.label} event card`}
                  width="100%"
                  height="320"
                />
              </div>
            </section>
          ))
        }
      </div>
    </section>
  </main>
</LocalLayout>

<script src="./event-card-playground.ts"></script>

<style>
  .ui-gallery {
    align-items: start;
  }
  .ui-preview-scroll {
    border: 0;
    border-radius: 0;
  }
  [data-ui-event-reset] {
    align-self: center;
  }
</style>
