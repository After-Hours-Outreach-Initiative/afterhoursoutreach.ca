---
import DialogHeader from "@/components/DialogHeader.astro";
---

{import.meta.env.DEV && (
  <dialog
    id="development-account-dialog"
    class="dialog-pop dialog-frame"
    data-account-switcher
    aria-labelledby="development-account-dialog-heading"
  >
    <DialogHeader
      id="development-account-dialog-heading"
      title="DEV panel"
      closeLabel="Close DEV panel"
      closeAttributes={{ "data-close-account-switcher": "" }}
    />
    <div class="dialog-body">
      <div
        class="dev-panel-sections"
        data-view-as
        role="group"
        aria-label="View as"
        aria-busy="true"
      >
        <section
          class="dev-panel-section"
          data-account-states
          role="group"
          aria-label="Account states"
        >
          <button
            class="btn btn-quiet account-profile-button"
            type="button"
            data-switch-user=""
            data-visitor
            aria-pressed="false"
            title="Sign out"
            disabled
          >
            Visitor
          </button>
        </section>
        <section class="dev-panel-section">
          <h3 id="development-steps-heading">
            Application steps{" "}
            <span class="account-profile-detail" data-step-account />
          </h3>
          <div
            class="account-step-buttons"
            role="group"
            aria-labelledby="development-steps-heading"
          >
            {[
              ["form", "Submit sample application"],
              ["naloxone", "Complete Naloxone 101"],
              // Discord connection is temporarily disabled.
              // ["discord", "Simulate Discord connection"],
              ["review", "Approve application"],
            ].map(([step, label]) => (
              <button
                class="btn btn-quiet account-step-button"
                type="button"
                data-application-step={step}
                title="Sample answers only. Submitted answers are kept and no emails are sent."
                disabled
              >
                <span>{label}</span>
                <span class="account-profile-detail" data-step-status />
              </button>
            ))}
          </div>
        </section>
        <section class="dev-panel-section">
          <h3 id="development-accounts-heading">Existing accounts</h3>
          <div
            class="account-profile-buttons"
            data-existing-accounts
            role="group"
            aria-labelledby="development-accounts-heading"
          />
          <p class="account-profile-detail" data-empty-accounts hidden>
            No saved accounts yet.
          </p>
        </section>
      </div>
      <p class="mt-3" data-switch-message role="status" hidden />
    </div>
    <div class="dialog-footer">
      <button
        class="btn btn-quiet mr-auto"
        type="button"
        data-seed-accounts
        title="Add the sample accounts and events. Edited accounts are kept."
        disabled
      >
        Seed local accounts
      </button>
      <a class="btn btn-quiet" href="/volunteer/sign-in" data-create-account>
        Create an account
      </a>
      <a class="btn btn-outline" href="/dev/ui">
        UI playground
      </a>
    </div>
  </dialog>
)}

<script>
  // Standalone previews get the panel without adding controls to embedded examples.
  if (import.meta.env.DEV && window.self === window.top) {
    void import("./scripts/account-switcher").then(({ initAccountSwitcher }) =>
      initAccountSwitcher(),
    );
  }
</script>
