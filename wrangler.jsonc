{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "afterhoursoutreach-ca",
  "account_id": "76222ab803494dc84947546283e1a63a",
  "preview_urls": true,
  "compatibility_date": "2026-08-16",
  "compatibility_flags": ["nodejs_compat"],
  "main": "./src/worker.ts",
  "triggers": {
    // Daily discovery at 08:00 PST / 09:00 PDT, hourly mail, minute-level Discord retries.
    "crons": ["0 16 * * *", "30 * * * *", "* * * * *"],
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "afterhoursoutreach-production",
      "database_id": "ca19de7e-de80-41a5-827a-7130c34ea3da",
      "migrations_dir": "drizzle",
      "remote": false,
    },
  ],
  "vars": {
    "APP_ENV": "production",
    "AUTH_BASE_URL": "https://afterhoursoutreach.ca",
    // Dedicated application/server and only these three managed roles. See docs.
    "DISCORD_CLIENT_ID": "",
    "DISCORD_GUILD_ID": "",
    "DISCORD_VOLUNTEER_ROLE_ID": "",
    "DISCORD_ORGANIZER_ROLE_ID": "",
    "DISCORD_MEDIC_ROLE_ID": "",
  },
  // Secret values are configured separately for each deployment target.
  "secrets": {
    "required": ["BETTER_AUTH_SECRET", "RESEND_API_KEY"],
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "redact_query_string": true,
    "logs": {
      "invocation_logs": false,
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.1,
    },
  },
  "previews": {
    "vars": {
      "APP_ENV": "preview",
      // Resolve sign-in URLs from the request origin when no canonical URL is set.
      "AUTH_BASE_URL": "",
      // Never connect previews sharing D1 to a real Discord server.
      "DISCORD_CLIENT_ID": "",
      "DISCORD_GUILD_ID": "",
      "DISCORD_VOLUNTEER_ROLE_ID": "",
      "DISCORD_ORGANIZER_ROLE_ID": "",
      "DISCORD_MEDIC_ROLE_ID": "",
    },
    // Branch previews share this non-production database by default.
    "d1_databases": [
      {
        "binding": "DB",
        "database_name": "afterhoursoutreach-staging",
        "database_id": "4412ad44-0ca9-4ebd-8f08-78bb1092bc0d",
        "migrations_dir": "drizzle",
      },
    ],
    "observability": {
      "enabled": true,
      "head_sampling_rate": 1,
      "redact_query_string": true,
      "logs": {
        "enabled": true,
        "invocation_logs": false,
      },
      "traces": {
        "enabled": true,
        "head_sampling_rate": 0.1,
      },
    },
  },
}
