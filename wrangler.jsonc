{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "afterhoursoutreach-ca",
  "account_id": "76222ab803494dc84947546283e1a63a",
  "compatibility_date": "2026-08-16",
  "compatibility_flags": ["nodejs_compat"],
  "main": "@astrojs/cloudflare/entrypoints/server",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "afterhoursoutreach",
      // Replace with the production D1 ID before deploying; local builds use SQLite.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "drizzle",
      "remote": false,
    },
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "invocation_logs": false,
    },
  },
}
